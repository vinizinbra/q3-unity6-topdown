  displayName: Rift Anchor / Base
  kindLabel: EXPLORATION UPGRADE
  description: Your landing spot at the start of every run. Upgrade it to find gear
    waiting for you and to fix your Accessory during breaks.
  icon: {fileID: 6697352333098020210, guid: 17d8416a8743b4409ad9bf6300ede405, type: 3}
