// Blacksmith - a Breathing-only POI that, for Coins, adds one new Weapon Perk to the interacting
// player's own currently-equipped weapon (see docs/store-blacksmith.md). Reuses the generic
// POI/Context-Interaction framework (Poi.qtn/ContextInteraction.qtn) Healing Shrine/Cursed Rift
// already established. Unlike Store, Blacksmith genuinely IS "used up" per player per Break - one
// purchase per player per Break, exactly what the pre-existing generic PoiUsagePolicy.
// OncePerPlayerPerBreak mechanism already models, so it's reused unchanged rather than needing its
// own bespoke tracking the way Store's per-offer StorePurchases does.
component Blacksmith
{
    PoiAvailability Availability;
    PoiUsagePolicy UsagePolicy;
}

// One player's own cached Blacksmith roll for the CURRENT Breathing Break - kept separate from
// BlacksmithInteraction below (which is purely "is the window open right now") specifically so that
// closing the window (a Cancel, or simply walking away) never throws the roll away. Re-rolled
// lazily, same idiom StoreUtility.EnsureInventoryRolled/StoreInventory.RolledAtBreathingIndex
// already uses, the first time this player interacts with a Blacksmith during a Break whose index
// doesn't match RolledAtBreathingIndex yet. Per-player rather than shared like StoreInventory,
// since this player's own equipped weapon decides which perks are eligible/excluded.
component BlacksmithOffer
{
    Int32 RolledAtBreathingIndex; // -1 initially - never matches a real Global.BreathingIndex

    array<AssetRef<WeaponPerkData>>[3] PerkChoices;
    Byte PerkChoiceCount; // may be < 3 if fewer than 3 perks were eligible
}

// One player's own in-progress Blacksmith visit - presence = this player's own Choice UI is open
// and their input is locked to it, same convention CursedRiftInteraction/StoreInteraction already
// use (see PoiInteractionLockUtility). Attached the instant TryBeginInteraction succeeds (copying
// the current roll in from BlacksmithOffer above), removed on a successful pick or an explicit
// Cancel - closing this does NOT reroll anything, see BlacksmithOffer's own comment.
component BlacksmithInteraction
{
    EntityRef Forge;

    array<AssetRef<WeaponPerkData>>[3] PerkChoices;
    Byte PerkChoiceCount; // may be < 3 if fewer than 3 perks were eligible
}
