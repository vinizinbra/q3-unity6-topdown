// Run-wide Rift Shard currency state - merged by the DSL compiler into the same Frame.Global struct
// as Experience.qtn's/SurvivalDirector.qtn's global blocks. Co-op: one shared total for the whole
// run, credited by RiftShardUtility.Grant whenever any player collects a RiftShard (see
// CurrencyOrbSystem) - same "one shared total, not per-player" convention Experience.qtn uses.
global
{
    FP TotalRiftShards;

    // Greed's own difficulty-scaling side effect (enemies gain health), not currency-specific - it
    // just has no better-fitting existing global block to live in. Starts at its natural 0 (no
    // bonus) and is read as 1 + this wherever consumed (EnemySystem.SeedHealth), so an unseeded/
    // never-picked run is a correct no-op rather than needing an explicit 1 seed.
    FP EnemyHealthBonusMultiplier;
}
