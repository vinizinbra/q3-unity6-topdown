// Marks a player entity whose Input is produced by the SIMULATION itself (BotInputSystem) every
// tick instead of being polled from a real device - a co-op testing autopilot so one person can
// run several clients and let the extra heroes play themselves (see docs/bots.md). Added at spawn
// by PlayerSpawnUtility from RuntimePlayer.IsBot, or at runtime by the Become Bot cheat (removed
// again by Recover From Bot). Every Input-consuming system reads PlayerInputUtility.Resolve, which
// hands back this component's own Data for a bot and f.GetPlayerInput for everyone else.
//
// Same "fake a player's Input on an entity that has no real one behind it" shape InputSource.qtn
// already established for Lux's sentry gun - deliberately a SECOND component rather than reusing
// InputSource, because a bot DOES have a PlayerLink/PlayerRef (it occupies a real player slot),
// and WeaponSystem.HasFireDriver treats "has InputSource" as "is a non-player shooter".
component BotBrain
{
    // This tick's synthesized Input. Buttons are written as one-tick pulses (the whole struct is
    // cleared at the top of every BotInputSystem.Update), so a WasPressed-driven consumer -
    // SkillSystem's Dash/Hero Skill, AutoJumpSystem's Jump - sees exactly one press edge per
    // decision, never a held button that re-triggers every tick.
    Input Data;

    // What the bot is doing right now and what it is doing it TO (see BotInputSystem.SelectGoal).
    // GoalTarget is an entity for Revive/Fight/Loot/Interact/Explore (a teammate, enemy, pickup,
    // POI or Chunk), None for Follow/Retreat. GoalTimer counts up while the goal is unchanged - it
    // is what makes a picked target sticky instead of re-chosen every tick.
    BotGoal Goal;
    EntityRef GoalTarget;
    FP GoalTimer;

    // A target the bot just failed to reach (stuck or unreachable) - skipped by every target pick
    // until IgnoreTimer runs out, so the bot doesn't pick the same unreachable thing straight back.
    EntityRef IgnoredTarget;
    FP IgnoreTimer;

    // Smoothed movement heading - last tick's output direction, blended toward each new decision
    // (BotNavigation.ApplyHeading) so steering corrections don't flip the bot left/right every tick.
    FPVector2 Heading;

    // Climbing a 1-unit step (BotNavigation.SteerToward): once a climbable step is seen ahead the
    // bot commits to walking straight into it for ClimbCommitTimer - no wall slide, no heading
    // blend - and the player processor's auto-mantle climbs it. Without the commit the wall slide
    // and the climb alternated every tick (flicker) and the bot never walked into it.
    FP ClimbCommitTimer;
    FPVector2 ClimbDirection;

    // +1/-1: which way the ledge/wall deflection last turned. Mirrored candidates are tried this
    // side first, so a bot sliding along a lip keeps sliding the same way instead of zig-zagging.
    Int32 DeflectSide;

    // Leader formation. LeaderHeading is the leader's smoothed TRAVEL direction (from position
    // deltas, not Aim.Angle - auto-aim swings constantly, travel doesn't). The slot is an angle
    // relative to it (180 = directly behind) plus a distance, re-rolled only on
    // FormationRerollTimer. LastLeaderPosition feeds the delta.
    FPVector2 LeaderHeading;
    FPVector3 LastLeaderPosition;
    FP FormationAngle;
    FP FormationDistance;
    FP FormationRerollTimer;

    // True while regrouping with a leader that got too far away - cleared once back within the
    // follow distance (hysteresis between BotSettings.LeaderMaxDistance and FollowDistance).
    Boolean Regrouping;

    // Stuck detection: where the bot was when it last made real progress, and how long it has
    // wanted to move without getting LedgeProgressDistance away from it.
    FPVector3 ProgressAnchor;
    FP StuckTimer;

    // Seconds a Follow/Regroup has been stranded (blocked, stuck, or past LeashDistance) - past
    // LeashTimeout the bot is teleported next to its leader.
    FP LeashTimer;

    // Minimum gap between two presses of the same skill button, so a press SkillSystem refused
    // (no stack, mid-activation) isn't retried every tick.
    FP HeroSkillGuardTimer;
    FP DashGuardTimer;

    // Fight strafing: which way the bot circles its target and when it next flips.
    Int32 StrafeSign;
    FP StrafeTimer;

    // Current A* route (BotNavGrid.FindPath, string-pulled into straight segments) toward
    // PathGoal, walked waypoint by waypoint. Rebuilt when the goal moves more than
    // BotNavigation.RepathDistance, every RepathInterval while in use, or when a leg is blocked;
    // cleared whenever the bot can walk straight to its target. 32 is
    // BotNavigation.MaxPathWaypoints - keep them in sync (a longer route is re-planned from its
    // last stored waypoint).
    array<FPVector3>[32] Path;
    Byte PathCount;
    Byte PathCursor;
    FPVector3 PathGoal;
    FP RepathTimer;

    // Once-per-Breathing-Break guards for each POI kind the bot uses, compared against
    // Global.BreathingIndex (same idiom as StorePurchaseEntry.PurchasedAtBreathingIndex). Seeded to
    // -1 (PlayerSpawnUtility.ConvertToBot) so they never false-match BreathingIndex 0.
    Int32 StoreAttemptedAtBreathingIndex;
    Int32 BlacksmithAttemptedAtBreathingIndex;
    Int32 CursedRiftAttemptedAtBreathingIndex;
    Int32 ShrineAttemptedAtBreathingIndex;
}

// See BotInputSystem.SelectGoal for the priority order.
enum BotGoal : Byte
{
    None,
    Follow,
    Revive,
    Retreat,
    Fight,
    Loot,
    Interact,
    Explore,

    // Walk onto a landed, recoverable DroppedAccessory (own, or a teammate's with
    // AccessoryGuardConfig.AllowAllyRecovery) - low priority, see BotInputSystem.SelectGoal.
    Recover
}
