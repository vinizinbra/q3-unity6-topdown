// Granted by Heroes/Zara/StunEveryWavesSkillAction - checked live every damage pulse (see
// AlternatingAreaSystem.TryApplyStunUpgrade), not baked in at spawn like
// PoisonDamageWavesUpgrade/HasteOnHealUpgrade - this needs to apply only on every Interval-th
// pulse, which a one-time bake can't express. Safe to check live because it's Begin-only and never
// revoked, same as everything else this session settled on - there's no End racing against it.
component StunEveryWavesUpgrade
{
    Byte Interval;
    AssetRef<HitEffectData> StunEffect;
}
