// Level-up upgrade-choice screen - see docs/level-up-upgrades.md for the full runtime flow
// (ExperienceUtility.Grant -> LevelUpUtility.BeginLevelUpScreen -> LevelUpSystem countdown ->
// LevelUpUtility.Resolve). RiftMutation/RiftMarkMutation are two separate pools - see
// docs/rift-mutations.md - both rare, non-stackable, run-wide, distinct from GlobalUpgrade's small
// stacking increments (see RiftMutationPicks below for how "non-stackable" is enforced pool-wide
// rather than per-asset, and shared across BOTH pools since they draw from the same underlying
// RiftMutationData catalog). RiftMutation is the 14 "core" build-defining tradeoffs (Glass Core,
// Heavy Arsenal, ...); RiftMarkMutation is the 11 "Rift Mark content pool" mutations (Critical
// Fracture, Last Stand, ...) that apply Rift Mark on some trigger - split into their own pool so a
// designer can pace/gate them independently in LevelUpConfig.LevelSequence. Cursed Rift's own
// reward roll (LevelUpUtility.RollMutationOptions) deliberately still only draws from RiftMutation.
// ChooseWeapon is the newest - see LevelUpOption's own WeaponData/RolledPerks fields below and
// docs/level-up-upgrades.md's "Category sequencing / Choose Weapon" section.
enum LevelUpPoolKind : Byte
{
    None            = 0,
    SkillUpgrade    = 1,
    WeaponPerk      = 2,
    GlobalUpgrade   = 3,
    PassiveUpgrade  = 4,
    RiftMutation    = 5,
    ChooseWeapon    = 6,
    RiftMarkMutation = 7
}

// The 6 player-facing upgrade categories a level-up (or a Chest) can be locked to - distinct from
// LevelUpPoolKind above, which is the actual GRANT-path discriminator on a rolled LevelUpOption.
// HeroSkill here covers what LevelUpPoolKind splits into SkillUpgrade + PassiveUpgrade (see
// LevelUpUtility.CollectPerHeroCandidates, which already always offers both together) - merged
// because this enum only exists to say WHICH single category a level/Chest draws from, not what
// gets granted once something's picked. Used by LevelUpConfig.LevelSequence and Chest.Kind.
enum LevelUpCategory : Byte
{
    HeroSkill        = 0,
    GlobalUpgrade    = 1,
    RiftMutation     = 2,
    WeaponPerk       = 3,
    ChooseWeapon     = 4,
    RiftMarkMutation = 5
}

// One rolled, grantable option. WeaponPerkData/SkillActionData/GlobalUpgradeData/PassiveUpgradeData/
// RiftMutationData all derive from the shared UpgradeData base (see UpgradeData.cs), so a single
// AssetRef<UpgradeData> covers every kind - resolved generically for display (Icon/DisplayName/
// GetDescription/Rarity) via UpgradeCardWidget, and reinterpreted to the concrete AssetRef<T> a
// grant path needs (via its raw Id - see LevelUpUtility.GrantOption) since Kind is what says which
// concrete type Upgrade actually points at. SkillUpgradeSlot is the one piece Upgrade alone can't
// carry - which CharacterSkills slot a SkillUpgrade targets (mirrors GrantSkillUpgradeCommand's own
// Slot field).
struct LevelUpOption
{
    LevelUpPoolKind Kind;
    AssetRef<UpgradeData> Upgrade;
    SkillSlotId SkillUpgradeSlot;  // valid only when Kind == SkillUpgrade

    // Valid only when Kind == ChooseWeapon - a freshly-rolled weapon+perks combo has no single
    // UpgradeData/Rarity to hang off Upgrade above (the rarity lives on each individual rolled perk
    // instead - see WeaponDataAsset's own Icon/DisplayName fields). Rendered via a dedicated
    // WeaponCardWidget, not UpgradeCardWidget - see GameplayUiController.BuildWeaponCardData.
    AssetRef<WeaponDataAsset> WeaponData;
    array<AssetRef<WeaponPerkData>>[5] RolledPerks;  // mirrors Weapon.Perks[5]'s own ceiling
    Byte RolledPerkCount;
}

// Attached to a player's own character entity (found via PlayerLink) the instant a level-up screen
// opens for them - see LevelUpUtility.BeginLevelUpScreen. Its mere presence on an entity IS the
// "this player still has an unresolved pick" signal; LevelUpUtility.Resolve removes it once granted.
// Lives per-entity rather than in a Frame.Global array indexed by PlayerRef - SessionConfig's
// PlayerCount isn't configured yet, so there's no real fixed ceiling to size a Global array against,
// and every other per-player runtime value in this codebase (CharacterSkills, Weapon) already lives
// on the character entity the same way.
component LevelUpChoice
{
    array<LevelUpOption>[3] Options;
    Byte OptionCount;   // how many of Options[0..3) were actually rolled - a pool can hold fewer
                         // candidates than ChoiceCount, leaving trailing slots at Kind == None
    Boolean Confirmed;
    Byte SelectedIndex;

    // True when this entity confirmed via the separate "Keep Current" button rather than picking
    // one of Options[0..OptionCount) - only meaningful/offered on a Choose-Weapon screen (see
    // GameplayUiController's own isWeaponChoice check and UpgradeWindow.keepCurrentButton).
    // SelectedIndex is meaningless when this is true. Resolve checks this before GrantOption so
    // keeping the current weapon is a genuine no-op rather than re-granting Options[SelectedIndex]
    // - see LevelUpUtility.ConfirmKeepCurrent.
    Boolean KeptCurrent;

    // Screen-title info, populated once at roll time (LevelUpUtility.RollOptionsFor/
    // RollChooseWeaponOptionsFor) so the view doesn't need to re-derive origin/category itself.
    // FromChest mirrors "was BeginChestScreen the caller" (see OpenUpgradeScreen) - a plain
    // level-up screen always shows a generic title regardless of any LevelUpConfig.LevelSequence
    // category, so this is NOT the same as "category != null". Category is only meaningful when
    // FromChest is true.
    Boolean FromChest;
    LevelUpCategory Category;
}

// One entity's pick history for the GlobalUpgrade pool - only consulted for an upgrade authored
// with GlobalUpgradeData.MaxPicks > 0 (e.g. Dash Charge); most Global Upgrades are meant to stack
// indefinitely (see docs/global-upgrades.md) and never get an entry here. Fixed array with headroom
// over the current ~21-upgrade catalog, same convention as SkillSlot.Upgrades - Quantum components
// can't hold an actual dynamic list.
component GlobalUpgradePicks
{
    array<GlobalUpgradePickEntry>[32] Entries;
}

struct GlobalUpgradePickEntry
{
    AssetRef<GlobalUpgradeData> Upgrade;
    Byte Count;
}

// One entity's pick history for BOTH the RiftMutation and RiftMarkMutation pools (LevelUpPoolKind) -
// shared rather than split, since every AssetRef<RiftMutationData> is non-stackable pool-wide (not
// an opt-in per-asset MaxPicks) regardless of which of the two pools it's drawn from, and the two
// pools' assets never overlap - see RiftMutationUtility.Grant/IsAlreadyPicked and
// LevelUpUtility.CollectRiftMutationCandidates/CollectRiftMarkMutationCandidates. Fixed array with
// headroom over the current 25-mutation catalog (14 RiftMutation + 11 RiftMarkMutation - see
// docs/rift-mutations.md), same convention as GlobalUpgradePicks/SkillSlot.Upgrades. Grown from [16]
// in the same pass that added the 11 Rift Mark mutations, since 14+11 already exceeded the old
// headroom.
component RiftMutationPicks
{
    array<AssetRef<RiftMutationData>>[32] Picked;
}

// Flat run-wide record of every upgrade an entity has ever been granted, covering Skill Upgrade/
// Global Upgrade/Passive Upgrade/Rift Mutation/Rift Mark Mutation - unlike GlobalUpgradePicks/RiftMutationPicks/
// SkillSlot.Upgrades above (each scoped to one kind, kept for their own gameplay checks), this one
// exists purely for display: the party HUD's PartyHistoryUpgradeContainer reads it to show an icon
// per pick. Weapon Perk is deliberately excluded (see LevelUpUtility.RecordHistory) - already
// visible on the weapon itself, and rolls too often to be worth a HUD icon. Written by
// LevelUpUtility.RecordHistory, one call site covering every included kind generically via the
// same AssetRef<UpgradeData> reinterpret LevelUpOption already uses. A repeat pick of the same
// stacking upgrade (e.g. an uncapped GlobalUpgrade) bumps Count on its existing entry instead of
// adding a duplicate row. Fixed array with headroom over the largest covered catalog (~25 Rift
// Mutations), same convention as GlobalUpgradePicks/RiftMutationPicks - Quantum components can't
// hold an actual dynamic list. Also doubles as PassiveUpgrade's own "already granted" gameplay
// check (PassiveUpgradeUtility.IsAlreadyPicked) - unlike Global Upgrade/Rift Mutation, Passive
// Upgrade doesn't get a dedicated Picks component of its own; its catalog is small and per-hero
// (a handful of entries each) and shares this same 32-slot budget with Skill/Global/Rift picks, so
// it's judged unlikely to ever fill up across one run - revisit with a dedicated
// PassiveUpgradePicks component (mirroring RiftMutationPicks) if that assumption stops holding.
component UpgradeHistory
{
    array<UpgradeHistoryEntry>[32] Entries;
}

struct UpgradeHistoryEntry
{
    LevelUpPoolKind Kind;
    AssetRef<UpgradeData> Upgrade;
    Byte Count;
}
