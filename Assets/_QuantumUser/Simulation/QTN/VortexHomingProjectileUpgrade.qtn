// Granted by Heroes/Kai's VoidShardsSkillAction onto the owner, then baked as a copy of
// itself directly onto the spawned Vortex entity by SpawnVortexEffectData - periodically fires
// ShardCount homing projectiles at the nearest (distinct, when available) enemies within (vortex's
// own pull radius * SearchRadiusMultiplier) - see VortexSystem.TryHomingProjectile. A multiplier of
// the vortex's own PhysicsCollider3D radius rather than an absolute value, same "scales with
// SpawnRadiusUpgrade automatically" reasoning as the pull itself.
component VortexHomingProjectileUpgrade
{
    AssetRef<ProjectileDataAsset> Projectile;
    FP Damage;
    FP SearchRadiusMultiplier;
    FP TickInterval;

    // Rank 3 - fires this many shards per volley (1 at ranks 1-2), each preferring a different
    // target than the previous when one's available within range (falls back to re-targeting the
    // same enemy otherwise - resolved fresh within the single fire tick, no persistent tracker).
    Byte ShardCount;

    // How many enemies a single shard can pass through before it's spent (1 = stops on the first,
    // the default homing-shot behavior; 2/3 at ranks 2/3 - see VortexSystem.TryHomingProjectile,
    // which overrides the shot's own Projectile.RemainingPierces with this after spawn rather than
    // relying on whatever PierceCount the Projectile asset itself authors).
    Byte PierceCount;

    // Unused on the owner's copy (only ever 0 there) - only the copy baked onto the spawned vortex
    // actually counts down, same "owner-side grant carries dead fields the baked copy uses" shape as
    // VortexImplosionUpgrade's own PulseCounter.
    FP TickTimer;
}
