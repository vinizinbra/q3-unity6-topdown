// Granted by Heroes/Kai's VortexRandomExplosionSkillAction onto the owner, then baked as a copy of
// itself directly onto the spawned Vortex entity by SpawnVortexEffectData - periodic small blasts at
// a random point inside the vortex's own pull radius while it's alive (see
// VortexSystem.TryRandomExplosion), independent of VortexDamageUpgrade's own AreaDamage pulses and
// the single big blast VortexExplodeOnDestroy fires on expiry. Damage applied directly via
// HitEffectUtility.ApplyDamageInRadius, no spawned entity - same shape as those two.
component VortexRandomExplosionUpgrade
{
    FP Damage;
    FP Radius;
    FP TickInterval;

    // Unused on the owner's copy (only ever 0 there) - only the copy baked onto the spawned vortex
    // actually counts down, same "owner-side grant carries dead fields the baked copy uses" shape as
    // AreaDamage's own TickTimer.
    FP TickTimer;

    // Carried through to VortexMiniExploded so the view can resolve BlastEffectPrefab
    // (VortexRandomExplosionSkillAction.View.cs) off the exact asset that granted this - same
    // "AssetRef travels with the event" shape AreaDetonated uses for AreaHitData.BlastEffectPrefab.
    AssetRef<VortexRandomExplosionSkillAction> Source;
}
