// Fired by GameStateUtility.SetState the instant Global.CurrentState actually changes (a
// same-state call is a no-op, no event) - match-wide, not entity-scoped, unlike almost everything
// else in this file, since GameState itself is a single Global value, not a per-entity concept.
// See GameState.qtn/docs/talents.md.
event GameStateChanged
{
    GameState PreviousState;
    GameState NewState;
}

event PlayerJumped
{
    EntityRef Entity;
}

// Fired only by PlayerMovementProcessor's predictive auto-hop, specifically the "no ground ahead"
// edge-of-a-ledge branch (HasGroundAhead == false) - NOT the auto-mantle-up branch (TryDetectMantle),
// and NOT a manual/AutoJumpSystem jump (those still fire PlayerJumped above). View-only hook for a
// distinct "hopping down" flourish (BlobAnimationView's Jump Flip) that a mantle or a manual jump
// shouldn't play - deliberately a separate event rather than overloading PlayerJumped with a source
// enum, since no simulation system needs to tell the two apart (LandingSource/AirborneSource already
// classifies both as a plain Fall on landing - see PlayerMovement.qtn).
event PlayerAutoJumpedDown
{
    EntityRef Entity;
}

event PlayerFired
{
    EntityRef Entity;
}

event WeaponReloaded
{
    EntityRef Entity;
}

event EntityDamaged
{
    EntityRef Target;
    EntityRef Owner;
    FP        Damage;
    Boolean   IsCritical;

    // Neutral for a normal hit - StatusEffectSystem passes Fire/Poison for a Burn/Poison tick (see
    // DamageUtility.ApplyDamage), so the View (DamageFeedbackManager) can style a DoT number
    // differently from a direct hit without guessing from DamageSource alone.
    ElementType Element;

    // True for a passive/self-inflicted tick that shouldn't read as "something hit me" - e.g.
    // SentryDecaySystem draining a sentry's own Health toward 0 over its lifetime. HitFeedback skips
    // its flash when this is set; DamageFeedbackManager still shows a number either way (seeing your
    // sentry's own HP tick down is useful info, unlike a flash that would look like it's under attack
    // every tick even when nothing is actually hitting it).
    Boolean Silent;

    // True when DamageUtility.ResolveFrontalDamageMultiplier actually reduced this hit (a
    // FrontalDamageReduction enemy, hit inside its facing arc) - lets HitFeedback flash a distinct
    // color instead of the normal per-element one.
    Boolean FrontalReduced;

    // Target's Transform3D.Position at the moment of the hit, read by DamageUtility.ApplyDamage
    // before it does anything that might destroy the target. A killing blow can destroy Target this
    // same tick (Filler/Normal-tier enemies - see ApplyDamage's death branch), so a view can't
    // safely re-resolve Transform3D off Target after the fact the way it can for a non-lethal hit -
    // same "position travels with the event" shape every other position-carrying event in this file
    // already uses (EnemyExploded, HitEffectApplied, ...).
    FPVector3 Position;

    // Quantum silently collapses multiple events raised in the same tick if every field matches
    // byte-for-byte (its own dedup, not a bug here) - a multi-pellet weapon (shotgun) firing several
    // identical-damage pellets at one stationary target in one tick would otherwise only ever
    // deliver 1-2 of them, reading as "some pellets did nothing". HitIndex just needs to differ per
    // pellet within that same shot to keep every one of them distinct - see WeaponSystem.FireHitscan.
    Byte HitIndex;
}

// Mirrors EntityDamaged for the heal path - see HealUtility.ApplyHeal. Amount is what was actually
// applied after MaxHealth capped it, not the raw requested heal, so a number popping over an
// already-near-full ally reads correctly instead of overstating it.
event EntityHealed
{
    EntityRef Target;
    EntityRef Owner;
    FP        Amount;
}

// Fired alongside EntityHealed specifically when Max's Vendetta passive heals its wielder from
// consuming a mark (killing one of its RevengeMark-marked enemies) - a dedicated event so a view VFX
// can react to this exact heal source without inferring it from EntityHealed's Target==Owner shape
// (HealthRegenSystem/other self-heals could look the same otherwise). See MaxVendettaSystem.cs and
// docs/max-vendetta-fire-mastery.md.
// Fired whenever CheatDeathUtility.TryPreventLethal actually saves its owner (Too Angry to Die) -
// a dedicated event, same reasoning as VendettaRevengeHealed below, so a view VFX/screen effect can
// react to this exact moment without inferring it from Health snapping to 1.
event CheatDeathTriggered
{
    EntityRef Entity;
}

event VendettaRevengeHealed
{
    EntityRef Entity;
    FP        Amount;
}

// Shield counterpart to EntityHealed - see ShieldUtility.ApplyFlatShield. Amount is what was
// actually applied after Max capped it, same reasoning EntityHealed's own comment gives. Fired for
// a genuine grant only (Bodyguard, Portable Cover, ShieldEffectData) - passive recharge
// (ShieldSystem), initial seeding (CharacterSystem/EnemySystem), and damage absorption
// (DamageUtility) all still write Shield.Current directly and deliberately don't go through
// ShieldUtility/fire this, the same way plain Health seeding never goes through
// HealUtility/fires EntityHealed either.
event EntityShielded
{
    EntityRef Target;
    EntityRef Owner;
    FP        Amount;
}

// Fired from the exact same spot as Shield.qtn's OnShieldBroken signal
// (DamageUtility.AbsorbWithShield, the tick Current crosses from >0 to <=0) - that signal is a
// simulation-only reaction hook (RiftMutationReactionSystem's Shield Breaker), this is the
// view-facing counterpart so a break VFX can play. No Amount/Owner - unlike EntityShielded this
// isn't a grant, just "this entity's shield just popped", so a view reaction only ever needs to
// know where.
event ShieldBroken
{
    EntityRef Target;
}

// Fired once per HitEffectUtility.ApplyToTarget call that actually connects (see that method) -
// generic across every delivery/skill/projectile that funnels through it, unlike EntityDamaged/
// EntityHealed which only cover their own specific effect. Owner lets each attacking enemy's own
// EnemyAttackVisualsView filter to hits IT caused and resolve the hit-impact particle off whichever
// delivery it's currently running (EnemyDeliveryData.HitImpactPrefab, see EnemyDeliveryData.View.cs)
// - the visual belongs to what triggered the hit (a ground slam vs. a melee swing), not to the
// HitEffectData describing what the hit numerically does, since the same DamageEffectData can be
// reused by deliveries that should look completely different on impact.
//
// MultiTarget is true whenever this connect came from an overlap query that can catch more than
// one entity in one action (ApplyInRadius/ApplyInShape/ApplyInCollider, plus a couple of manual
// per-target loops - IronShoulderSkillAction), false for a guaranteed
// single-connect hit (a projectile striking its one target). Lets a generic per-hit VIEW reaction
// (EffectsManager.OnHitEffectApplied's meleeHitEffectPrefab) skip itself for a multi-target action -
// that already gets (or should get) its own single dedicated blast VFX
// (AreaDetonated/ShockwaveReleased/...), so playing this generic spark once per target hit as well
// stacks N redundant particles on top of it. Deliberately NOT the same thing as
// HitEffectContext.IsExplosion (a narrower gameplay flag - only Pixie's own bombs opt in, feeds
// Chain Reaction's Instability marking) - this is a broader "could this be more than one target"
// signal for VIEW dedup, not a gameplay concept.
event HitEffectApplied
{
    EntityRef Owner;
    EntityRef Target;
    FPVector3 Position;
    Boolean   MultiTarget;
}

event EntityDied
{
    EntityRef Target;
    EntityRef Owner;
}

// Fired by GroundAreaDeliveryData.Begin() right before it self-destructs its own owner
// (SelfDestructs, a creeper-style suicide exploder) - EnemyAttackVisualsView's usual mechanism for
// playing an action's BeginStep visual (blob animation + particle) is watching Enemy.Phase for an
// edge across two render frames, which normally still catches a self-destruct fine since
// DamageUtility.ApplyDamage sets Phase = Dead before the entity actually lingers/destroys - EXCEPT
// for Filler/Normal tier enemies, whose death branch skips straight to f.Destroy() the same tick
// with Phase never touched at all (see that method's own comment - deliberate, no lingering corpse
// for disposable trash tiers). For those, the view never gets a Phase edge to observe before the
// entity is simply gone, so BeginStep's explosion particle silently never plays. This event exists
// so that specific case (and only that case - non-Filler/Normal self-destructs still go through
// the normal Phase-Dead path and don't also raise this, avoiding a double-play) has a guaranteed
// trigger. Position/FacingAngle are captured explicitly rather than left for the view to re-read
// live entity state, since by the time Unity processes this event the entity may already be
// destroyed - same reasoning EntityDamaged's own hitPosition capture already documents. Action is
// looked up fresh via frame.FindAsset in the view instead (that's static asset data, safe
// regardless of whether the raising entity still exists).
event EnemySelfDestructBeginVisual
{
    EntityRef Entity;
    FPVector3 Position;
    FP        FacingAngle;
    AssetRef<EnemyActionData> Action;
}

// Fired by AlternatingAreaSystem every time it flips phase - i.e. every pulse, whether it catches
// anyone or not. View-side hook for the pulsing entity's own animation (e.g. ZaraSpeakerView), not
// per-target damage/heal-number feedback - see EntityDamaged/EntityHealed for those.
event AlternatingAreaPulsed
{
    EntityRef Entity;
    Boolean   IsHealing;
}

// Fired by AreaDamageSystem every time an AreaDamage entity's TickTimer resets, whether or not the
// tick actually caught a target - View-side hook for a plain (non-alternating) area's own tick
// animation (e.g. AreaHitView), mirroring AlternatingAreaPulsed above for AlternatingArea entities.
event AreaDamageTicked
{
    EntityRef Entity;
}

// Zara's Flow State (see Flow.qtn) - her bar moved, for any reason: filled by movement, drained while
// standing still, pushed by Afterbeat, or wiped by a hit. Carries IsActive so a one-shot reaction can
// tell an ordinary tick of fill from the moment it actually switched on.
//
// The View NEVER derives Flow from this event alone - ZaraFlowView/ZaraHudWidget poll ZaraFlow itself,
// the same authoritative-state-not-event-replay convention AccessoryView and BlobAnimationView already
// document. This exists for one-shot reactions (a stack-gain chime, a break sting).
event ZaraFlowChanged
{
    EntityRef Owner;
    FP        Progress;
    Boolean   IsActive;
}

// A hostile hit connected and broke her rhythm (see Combat.qtn's OnHostileHitConnected). Fires even
// when the hit was fully negated by the Accessory Guard or a Free Hit Guard - that is the point of the
// mechanic, and it is why this is its own event rather than something derived from damage. Progress is
// what she was left with - 0 baseline, higher with Second Wind rank 2+.
event ZaraFlowBroken
{
    EntityRef Owner;
    FP        Progress;
}

// Second Wind rank 3 "Keep the Beat" actually reduced an incoming hit. Its own event because the
// reduction is invisible otherwise - the hit still lands, just smaller.
event ZaraKeepTheBeat
{
    EntityRef Owner;
}

// Headliner rank 3 - fired once when she REACHES Max Flow and the party buff actually goes out (never
// on a re-reach while its cooldown is running). Radius is carried so the burst can be drawn at the
// real reach rather than an authored guess.
event ZaraHypeTriggered
{
    EntityRef Owner;
    FPVector3 Position;
    FP        Radius;
}

// Fired by ZaraAfterbeatSystem.Fire (Dash Ascension "Afterbeat", ranked - the delayed dash pulse,
// Kept as its own event rather than reusing the shared ShockwaveReleased, so Afterbeat's own pulse can
// play a visually distinct VFX (see ZaraAfterbeatFxView) instead of looking identical to those.
event AfterbeatPulseReleased
{
    EntityRef Entity;
    FPVector3 Position;
    FP        Radius;
}

event PlayerRespawned
{
    EntityRef Entity;
    FPVector3 Position;
}

// Fires for both a falling player (PlayerFallSystem) and a falling Boss/Elite/Persistent enemy
// (EnemyFallSystem) the instant they drop below LevelConfig.FallDeathHeight - at the position
// they fell FROM, before any respawn teleport. Radius is the entity's own KCC (player) or
// PhysicsCollider3D (enemy) radius, so a single VFX prefab authored at reference radius 1 scales
// correctly for both.
event FallDeathTriggered
{
    EntityRef Entity;
    FPVector3 Position;
    FP        Radius;
}

event ProjectileDestroyed
{
    EntityRef  Entity;
    EntityRef  Owner;
    FPVector3  Position;
    AssetRef<ProjectileDataAsset> ProjectileData;
}

// Fired by DirectHitData.ApplyHit on every contact the projectile actually SURVIVES - a Piercing
// Rounds pass-through or a Ricochet bounce - never on the terminal hit, which raises
// ProjectileDestroyed instead. Without this, a per-weapon impact particle
// (ProjectileView.destroyEffectPrefab) only ever plays once, at the shot's final resting point,
// since ProjectileVisualController otherwise has no hook for "this projectile is still flying but
// just hit something" - see ProjectileVisualController.OnProjectileImpacted.
event ProjectileImpacted
{
    EntityRef  Entity;
    FPVector3  Position;
}

// Fired once per SEGMENT from WeaponSystem.FireHitscanPellet - one per pellet of a volley, plus one
// more for every Ricochet bounce, each beginning exactly where the previous one ended. A Hitscan
// weapon never spawns an entity (unlike Projectile, which gets ProjectileDestroyed above), so this
// is the only view hook for a hitscan shot's path/endpoint. EndPoint is the resolved hit point on a
// hit, or the max-range point along the ray on a miss, so a tracer always has somewhere to draw to
// either way.
//
// DidHit covers hitting ANYTHING, level geometry included; Target is what it actually landed on, or
// None for a miss or a wall - the two together are what let a view tell "sparks on stone" from
// "impact on an enemy" (see HitscanViewBase and the three view styles built on it).
event HitscanFired
{
    EntityRef  Owner;
    FPVector3  Origin;
    FPVector3  EndPoint;
    Boolean    DidHit;
    EntityRef  Target;
}

// Radius is supplied explicitly rather than left to the view to read off HitData.Radius - an
// ascension (e.g. Unstable Mixture/Hot Fuse/Birthday Cake) can boost the radius Detonate() actually
// used for the damage overlap past what's authored on the asset, same reason ExplodeOnDeathDetonated
// below carries its own Radius instead of pointing at an asset for it.
event AreaDetonated
{
    EntityRef              Owner;
    FPVector3              Position;
    AssetRef<AreaHitData>  HitData;
    FP                     Radius;
}

// Fired by DamageUtility's ExplodeOnDeath chain (see ExplodeOnDeath/MarkExplosiveDeath) - kept
// separate from AreaDetonated rather than reusing it, since that event's HitData is specifically an
// AreaHitData (a spawned-area/projectile-impact asset this feature doesn't use at all - no spawned
// entity, no Effects list, damage applied directly via HitEffectUtility.ApplyDamageInRadius). Radius
// is supplied directly since it's derived from the dying enemy's real collider radius, not
// authored on any asset. No Upgrade asset ref - the mark can come from any hero's upgrade, so
// there's no single upgrade asset to resolve a bespoke blast prefab from; EffectsManager always
// plays its shared default blast effect. EnemyData DOES travel with the event though - the dying
// target is always an Enemy (see DamageUtility.TryExplodeOnDeath's only call sites), so the view
// can still tint that shared prefab with the same EnemyDataAsset.ExplosionColor EnemyExploded
// already uses, instead of leaving it a flat white that clashes next to a tinted death VFX.
// RiftMarked mirrors DamageUtility.TryExplodeOnDeath's own StatusEffectUtility.IsRiftMarked check
// (captured before the mark is cleared by death) so EffectsManager can play a visually distinct
// blast for the ExplodeOnDeathConfig.RiftMarkRadiusMultiplier/RiftMarkDamageMultiplier-boosted
// case, same dedicated-prefab-with-tinted-fallback pattern DetonationReleased already uses - see
// docs/elemental-reactions.md.
event ExplodeOnDeathDetonated
{
    EntityRef  Owner;
    FPVector3  Position;
    FP         Radius;
    AssetRef<EnemyDataAsset> EnemyData;
    Boolean    RiftMarked;
}

// Fired by DamageUtility.TrySentryOverload - fully independent from ExplodeOnDeathDetonated above
// despite the similar shape, since Overload is its own mechanic (SentryOverloadUpgrade's own
// Radius/Damage, not RuntimeConfig.ExplodeOnDeathConfig). DOES carry an asset ref, unlike
// ExplodeOnDeathDetonated - Overload always comes from exactly one SentryOverloadCoreSkillAction
// asset, which is where the view resolves BlastEffectPrefab from
// (SentryOverloadCoreSkillAction.View.cs) - same "AssetRef travels with the event" shape
// VortexExploded uses for VortexCollapseSkillAction.
event SentryOverloadDetonated
{
    EntityRef  Owner;
    FPVector3  Position;
    FP         Radius;
    AssetRef<SentryOverloadCoreSkillAction> Source;
}

// Brute's Groundbreaker Passive Ascension - fired once per qualifying landing, at his own landing
// position, whether or not anything was actually caught (same "still reads visually against an empty
// room" convention AreaDetonated/ShockwaveReleased already follow). Radius is the rank's own resolved
// ImpactRadius, so a view can scale one prefab rather than authoring three.
//
// Presentation only: the simulation has already decided who was hit, which way they were thrown,
// whether they slammed a wall, and whether they were Stunned/Exposed by the time this fires.
event GroundbreakerSlammed
{
    EntityRef Owner;
    FPVector3 Position;
    FP        Radius;
}

// Lux's Emergency Repair Dash Ascension - fired when a dash ends near one of her own Sentries and
// actually services it. View-only cue (a repair spark on the chassis); the sim never reads it.
event SentryRepaired
{
    EntityRef Owner;
    EntityRef Sentry;
}

// Lux's Relocation Protocol Dash Ascension - fired when a Sentry is picked up and MOVED to her dash
// destination. Position is where it landed. Deliberately distinct from a fresh deploy: the same
// entity (and all its state) simply moved, so a view should relocate/replay rather than treat this as
// a new machine.
event SentryRelocated
{
    EntityRef Owner;
    EntityRef Sentry;
    FPVector3 Position;
}

// Lux's Overclock rank 3 "Redline" - fired once, the moment a Sentry's remaining lifetime first
// crosses the threshold and it goes into overdrive for the rest of its life. A one-shot cue, not a
// state readout (the state is Sentry.RedlineActive).
event SentryRedlineEngaged
{
    EntityRef Sentry;
}

// Lux's Field Modifications rank 3 "MK II" - fired once, when a Sentry hits max stacks and its
// primary Cannon is swapped for the Twin Cannon. Barrel is the slot-0 barrel that was re-equipped, so
// a view can swap that specific gun's art rather than the whole chassis.
event SentryUpgradedToMkII
{
    EntityRef Sentry;
    EntityRef Barrel;
}

// Fired by VortexSystem.TryExplodeOnDestroy (see VortexExplodeOnDestroy) - same shape as
// ExplodeOnDeathDetonated except this DOES carry an asset ref: unlike the enemy-death mark (which
// can come from any hero's upgrade), this always comes from exactly one
// VortexCollapseSkillAction asset, which is where the view resolves BlastEffectPrefab from
// (VortexCollapseSkillAction.View.cs) - same "AssetRef travels with the event" shape
// AreaDetonated uses for AreaHitData.BlastEffectPrefab. Position/Radius are still supplied directly
// since damage is applied via HitEffectUtility.ApplyDamageInRadius, no spawned entity.
event VortexExploded
{
    EntityRef  Entity;
    EntityRef  Owner;
    FPVector3  Position;
    FP         Radius;
    AssetRef<VortexCollapseSkillAction> Source;
}

// Fired by VortexSystem's Implosion pulse (see VortexImplosionUpgrade, Kai's Compression rank 3) -
// every EveryNthPulse-th pull pulse, a smaller blast at the vortex's own center. Kept separate from
// VortexExploded (the single big blast on expiry) since the view will likely want a smaller/different
// VFX for these - Source resolves CompressionSkillAction.BlastEffectPrefab (if authored), same
// AssetRef-travels-with-the-event shape as VortexExploded's own Source.
event VortexImploded
{
    EntityRef  Entity;
    EntityRef  Owner;
    FPVector3  Position;
    FP         Radius;
    AssetRef<CompressionSkillAction> Source;
}

// Fired by KaiUndertowSystem.TickUndertowPulls whenever a struck enemy's pull target resolves to a
// new enemy (fresh link, or the nearest enemy switches mid-pull) - NOT from OnWeaponHitLanded, since
// the pull target isn't known yet at hit time. Both Source and Target are always genuine enemies -
// never Kai/the owner - one-shot impact/mark feedback on both affected enemies, separate from the
// ongoing tether line (which the view instead polls live off UndertowPull.LinkTarget every frame -
// see KaiUndertowLinksView - rather than reacting to this event, so the line's own duration never
// drifts from simulation state on rollback/resimulation).
event UndertowTriggered
{
    EntityRef Source;
    EntityRef Target;
}

// Fired by JuggernautSkillData.Tick whenever a discharge fires - Brutus reached Charged and touched
// an enemy, triggering the area knockback (DamageUtility.ApplyKnockback, no damage of its own - pure
// knockback, same as the design calls for). No spawned entity, so the view needs Position/Radius
// handed to it explicitly - Source resolves JuggernautSkillData.DischargeEffectPrefab, same
// AssetRef-travels-with-the-event shape as VortexExploded/VortexImploded's own Source.
event JuggernautDischarged
{
    EntityRef  Entity;
    FPVector3  Position;
    FP         Radius;
    AssetRef<JuggernautSkillData> Source;
}

// Fired by JuggernautSkillData.End when the Aftershock Ascension is equipped - the channel
// finishing (Duration running out) triggers a damage blast around Brutus's own position, separate
// from the discharge pulse above (knockback only, triggered by touching an enemy while Charged, not
// by expiry). Damage applied directly via HitEffectUtility.ApplyDamageInRadius, no spawned entity -
// Source resolves AftershockSkillAction.BlastEffectPrefab, same AssetRef-travels-with-the-event shape
// as the rest of this session's asset-authored VFX.
event JuggernautEndExploded
{
    EntityRef  Entity;
    FPVector3  Position;
    FP         Radius;
    FP         Damage;
    AssetRef<AftershockSkillAction> Source;
}

// Fired by JuggernautLandingImpactSystem the moment an enemy marked by JuggernautLaunched touches
// ground again - Radius is the LANDED ENEMY's own real collider radius
// (EnemyMovementUtility.ResolveShapeRadius), so a bigger enemy's impact VFX reads bigger too. Source
// resolves ConcussiveImpactSkillAction.ImpactEffectPrefab, same AssetRef-travels-with-the-event shape
// as the rest of this session's asset-authored VFX.
event JuggernautLanded
{
    EntityRef  Entity;
    EntityRef  Owner;
    FPVector3  Position;
    FP         Radius;
    AssetRef<ConcussiveImpactSkillAction> Source;
}

// Generic - fired directly from StatusEffectUtility.ApplyRoot, so every Root source (not just
// Juggernaut's landing proc) gets this for free rather than each caller re-deriving its own
// position/radius and firing a bespoke event. Position/Radius are read off the target itself right
// as Root lands (Transform3D.Position, PhysicsCollider3D.Shape via
// EnemyMovementUtility.ResolveShapeRadius) - not authored on any asset, since there's no longer a
// per-source prefab to resolve (EffectsManager.rootEffectPrefab is a single shared VFX for every
// Root proc, not per-asset like JuggernautLanded's ImpactEffectPrefab).
event EntityRooted
{
    EntityRef  Entity;
    FPVector3  Position;
    FP         Radius;
}

// Fired by HitEffectUtility.ApplyShockwave - a knockback-only radial push around a point, deliberately
// generic (unlike AreaDetonated/JuggernautDischarged etc.) so ANY caller (Empty Chamber weapon perk,
// any other area pulse) can fire this same event/VFX instead of each needing its own bespoke hookup -
// same "no single upgrade asset to resolve a bespoke prefab from" reasoning ExplodeOnDeathDetonated
// already uses, see EffectsManager. Effect is invalid/default for every caller except Zara's Remix
// caller that resolved one deterministically - EffectsManager's own generic handler skips
// playing entirely whenever this is valid, deferring the (colored) shockwave visual to that caller
// instead, so a Remix pulse never plays two overlapping shockwave particles.
event ShockwaveReleased
{
    EntityRef                Entity;
    FPVector3                Position;
    FP                       Radius;
    AssetRef<HitEffectData>  Effect;
}

// Fired by WallSlamUtility.TryWallSlam whenever a knocked-back target actually finds a wall -
// deliberately generic, exactly like ShockwaveReleased above, because the wall check itself is now one
// shared implementation rather than one per Ascension. Every current and future knockback source that
// routes through that utility (Brute's Iron Shoulder dash, his Groundbreaker landing) gets the same
// impact VFX for free, with no per-source hookup.
//
// PushDirection is the normalized direction the target was shoved (i.e. INTO the wall), so a view can
// orient a directional impact/dust burst against the surface rather than playing a symmetric puff.
// Stunned reports whether the Stun genuinely LANDED, which is NOT the same as hitting the wall - a
// target inside a hard-CC immunity window, or an ImmuneToHardCC tier, hits the wall without being
// stunned (see EnemyTierResistanceConfig). A view can play a harder variant for the stunned case, which
// is also the one that opens Groundbreaker rank 3's Exposed window.
event WallSlammed
{
    EntityRef  Target;
    EntityRef  Owner;
    FPVector3  Position;
    FPVector3  PushDirection;
    Boolean    Stunned;
}

// Fired by DirectHitData.ApplyQuantumRounds whenever the perk actually chains a hit onto a second
// enemy - lets a per-asset ImpactEffectPrefab (see QuantumRoundsWeaponPerkData.View.cs) flash on
// the entity that took the chained hit, same Source-travels-with-the-event shape GroundPoundTriggered
// uses above. Position is the CHAINED TARGET's own live Transform3D, not the original shot's impact
// point, so the spark reads as landing on the second enemy rather than lingering at the first.
event QuantumRoundsTriggered
{
    EntityRef                                Entity;
    FPVector3                                Position;
    AssetRef<QuantumRoundsWeaponPerkData>    Source;
}

// Fired by HitEffectUtility.ApplyExplosion - a damage-only radial blast (no knockback), same
// "generic, no AssetRef/Source" reasoning as ShockwaveReleased above. Currently fired by Cataclysm
// Round and Explosive Sequence (see DirectHitData.ApplyTerminalWeaponPerks/
// WeaponSystem.ApplyHitscanWeaponPerks) - EffectsManager always plays defaultAreaBlastEffect for
// this one, deliberately with no dedicated prefab field, since neither perk has (or needs) its own
// bespoke VFX.
event WeaponExplosionReleased
{
    EntityRef  Entity;
    FPVector3  Position;
    FP         Radius;
}

// Fired once per lobbed shot via EnemyDeliveryData.FireLandingWarning - the View-side hook for a
// ground-anchored landing warning at Position, timed to Duration (the shot's own real solved flight
// time, not a separately-authored guess). Generic and delivery-agnostic - both
// MortarBarrageDeliveryData (several shells per Begin()) and ProjectileDeliveryData's own
// UseArc branch (a single lob, opt-in via ShowLandingWarning) fire it the same way, so any future
// lobbed attack gets the same ground telegraph for free. Deliberately carries no EntityRef/owner -
// several of these can be in flight independently at once, and the existing TelegraphManager pool
// (Get/Release) already supports any number of simultaneous independent instances on its own - only
// EnemyAttackVisualsView's own single-slot bookkeeping is limited to one telegraph at a time, not
// the pool itself. See GroundWarningTelegraphManager (View) for the listener.
event ProjectileLandingWarning
{
    FPVector3  Position;
    FP         Duration;
    FP         Radius;
}

// Fired by StatusEffectUtility.TryTriggerDetonation (Fire+RiftMark reaction - see
// docs/elemental-reactions.md), NOT WeaponExplosionReleased above - unlike Cataclysm Round/
// Explosive Sequence, this reaction wants its own distinct visual, so EffectsManager gives it a
// dedicated prefab field (detonationEffectPrefab) instead of always falling through to the
// shared defaultAreaBlastEffect.
event DetonationReleased
{
    EntityRef  Entity;
    FPVector3  Position;
    FP         Radius;
}

// Fired by StatusEffectUtility.TryTriggerSingularity (Void+RiftMark reaction - see
// docs/elemental-reactions.md) - pulls every enemy within Radius toward Position. Own dedicated
// visual (EffectsManager.singularityEffectPrefab), same pattern as DetonationReleased above.
event SingularityTriggered
{
    EntityRef  Entity;
    FPVector3  Position;
    FP         Radius;
}

// Fired by RiftMarkApplicationUtility.ApplyRequest (Overflowing Rift mutation - see
// docs/rift-mutations.md) when a Rift Mark application lands against a target already at
// ElementalReactionConfig.MaxStacks - a small pulse instead of wasting the application. Own
// dedicated visual (EffectsManager.overflowingRiftPulsePrefab), same pattern as
// DetonationReleased/SingularityTriggered above, but authored deliberately restrained/low-key.
event OverflowingRiftTriggered
{
    EntityRef  Entity;
    FPVector3  Position;
    FP         Radius;
}

// Fired once per Projectile actually reversed by Kai's Reflect dash ascension
// (MirrorStepSkillAction) - a point-in-space "parry" moment, not radius-scaled like the
// pulses above, since it marks a single deflected shot rather than an area effect. Position is the
// projectile's own position at the instant it's reflected, not Kai's, so the spark reads at the
// parry point even if Kai is still mid-dash toward/past it.
event ProjectileReflected
{
    EntityRef  Entity;
    FPVector3  Position;
}

// Fired by SkillSystem.Invoke immediately after a SkillActionData's Execute() call, one event per
// lifecycle phase, but only when that action actually has a particle configured for it (see
// SkillActionData.HasFx) - unlike every other generic event in this file, this one is gated at the
// fire site rather than firing unconditionally, since it fires from the same place EVERY skill
// action of EVERY equipped upgrade runs through, not a single specific perk. Action travels with
// the event (not just Entity/Position) so SkillActionFxView can resolve BeginFx/OnGoingFx/EndFx and
// EffectRadius directly off the asset - same "AssetRef travels with the event" shape
// VortexExploded/JuggernautDischarged already use. Kept as three separate events rather than one
// event carrying a SkillActionPhase, since that enum is plain C# (SkillActionData.cs), not
// DSL-declared, so it can't be a Quantum event field type.
event SkillActionBeginExecuted
{
    EntityRef  Entity;
    AssetRef<SkillActionData> Action;
    FPVector3  Position;
}

event SkillActionOnGoingExecuted
{
    EntityRef  Entity;
    AssetRef<SkillActionData> Action;
    FPVector3  Position;
}

event SkillActionEndExecuted
{
    EntityRef  Entity;
    AssetRef<SkillActionData> Action;
    FPVector3  Position;
}

// Fired once by SpawnSentrySkillAction.SpawnBarrel the instant a SentryBarrel is created for a given
// slot - the chassis's own view (SentryView) listens for its own Sentry entity, activates the
// matching gun sprite out of its authored list, and resolves Barrel's own View instance
// (QuantumEntityViewUpdater.GetView) to keep a direct Transform reference to that specific barrel.
// Purely cosmetic; the sim itself never re-reads this.
event SentryBarrelSpawned
{
    EntityRef Sentry;
    EntityRef Barrel;
    Byte      SlotIndex;
}

// Fired by DamageUtility.ApplyDamage instead of the usual Dead/DeathLingerTime path when a Filler-
// tier enemy dies (see EnemyDataAsset.Tier) - the entity is destroyed immediately with no lingering
// die animation, replaced by this explosion instead. Radius is the dying enemy's real collider
// radius (EnemyMovementUtility.ResolveShapeRadius, same resolution StatusEffectUtility.ApplyRoot
// uses). Source resolves EnemyDataAsset.ExplosionColor (EnemyDataAsset.View.cs) so each enemy
// type can tint the blast differently - the VFX prefab itself is shared across all enemy types
// (EffectsManager.deathEffect), unlike AreaHitData/JuggernautX's per-asset BlastEffectPrefab.
event EnemyExploded
{
    EntityRef              Entity;
    FPVector3              Position;
    FP                     Radius;
    AssetRef<EnemyDataAsset> Source;
}

// Fired by CurrencyOrbSystem the instant a player reaches an ExpOrb - a View hook for both the flying
// pickup-to-HUD-bar effect (FlyingXpManager, every client plays this identically since the shared
// Frame.Global.TotalExperience/Level update it accompanies is already deterministic/synced on its
// own) AND a per-character pickup glow (HitFeedback) on whichever character actually touched the
// orb - Collector is only used for that second, entity-scoped reaction, not for gating the shared
// bar/flying effect.
event ExpOrbCollected
{
    EntityRef Collector;
    FPVector3 Position;
    FP        Amount;
}

// Fired by ScrapOrbSystem the instant the owning Lux reaches a ScrapOrb - a View-only pickup-glow
// hook (see HitFeedback's own ExpOrbCollected subscription for the same shape), no simulation
// consumer. Unlike ExpOrbCollected, Collector is always the only entity Scrap ever means anything
// to (see ScrapOrbSystem), not one of several onlookers.
event ScrapOrbCollected
{
    EntityRef Collector;
    FPVector3 Position;
}

// Fired by CurrencyOrbSystem the instant a player reaches a RiftShard - same View-hook shape as
// ExpOrbCollected above (a pickup-to-HUD-bar effect plus a per-character pickup glow), mirroring
// that currency's own event since Rift Shards follow the same shared/deterministic-total pattern.
event RiftShardCollected
{
    EntityRef Collector;
    FPVector3 Position;
    FP        Amount;
}

// Fired by CurrencyOrbSystem the instant a player reaches a Coin - same View-hook shape as
// ExpOrbCollected/RiftShardCollected above, mirroring those currencies' own events.
event CoinCollected
{
    EntityRef Collector;
    FPVector3 Position;
    FP        Amount;
}

// Fired by WeaponSystem.Equip every time an entity's Weapon.WeaponData changes - including the
// very first spawn-time equip (CharacterSystem.SeedWeapon) and any later mid-match re-equip (e.g.
// LevelUpCategory.ChooseWeapon via WeaponChoiceUtility.Grant) - a single generic View hook so
// WeaponViewController doesn't need one bespoke call site per equip path. NOT needed for a
// reconnecting client to see the right weapon - WeaponViewController.Initialize already does its
// own cold read of the CURRENT Weapon.WeaponData the moment its view is (re)instantiated (see
// CustomQuantumEntityViewComponent's OnEntityInstantiated -> Initialize chain); this event is only
// for an ALREADY-connected client watching a later equip happen live.
event WeaponEquipped
{
    EntityRef Owner;
    AssetRef<WeaponDataAsset> WeaponData;
}

// Fired by ChestSystem the instant a player opens a Chest (see Chest.qtn/docs/chests.md) - a
// View-only hook for VFX/SFX/animation, no simulation consumer. Chest is the opened entity itself -
// lets a per-Chest view component (ChestView) filter to itself the same way e.g. SentryView filters
// EventSentryBarrelSpawned.Sentry against its own _entityRef. Kind is the Chest's own configured
// LevelUpCategory, in case the View wants a distinct effect per category (e.g. a weapon-chest pop
// vs. a rift-mutation-chest pop).
event ChestOpened
{
    EntityRef     Chest;
    EntityRef     Player;
    FPVector3     Position;
    LevelUpCategory Kind;
}

// Fired by BreakableUtility.TryBreak the instant a Breakable flips to Broken (see Breakable.qtn) - a
// View-only hook (BreakableView swaps to the broken visual + plays the break particle), no
// simulation consumer. Entity is the broken prop itself, so a per-entity view component can filter
// to its own _entityRef; Position travels with the event for a pooled, external break particle that
// outlives any view swap.
event BreakableBroken
{
    EntityRef Entity;
    FPVector3 Position;
}

// Fired when a player's Base Skill press redirects to an Interactable (see ContextInteraction.qtn)
// but the target utility's own TryInteract/TryBeginInteraction rejects it as
// ContextInteractionState.NotNeeded (e.g. HealingShrineUtility.TryInteract at full Health) -
// View-only hook for a quick-feedback ToastManager popup (InteractionPromptWidget), since not
// swapping the Base Skill icon alone is easy to miss on an actual button press. Generic across
// InteractableKind, not Healing-Shrine-specific, even though Healing Shrine is the only caller
// today - deliberately only fired on a REAL press, never from mere proximity to a NotNeeded POI.
event ContextInteractionRejected
{
    EntityRef Player;
    EntityRef Target;
}

// Fired by TraversalChallengeUtility.TryActivate the instant a player's Base Skill press starts a
// Traversal Challenge (see TraversalChallenge.qtn/docs/traversal-challenge.md) - View-only hook for
// the activator's own visual swap (TraversalChallengeView) and the platform-spawn VFX. Player is
// who pressed it, purely for UI messaging (e.g. "Player X started the crossing!") - completion is
// NOT restricted to this same player.
event TraversalChallengeActivated
{
    EntityRef Challenge;
    EntityRef Player;
}

// Fired by TraversalChallengeUtility.Complete the instant ANY player reaches the checkpoint in
// time - platforms are left alone (stay solid forever), SurvivalTime/enemy spawning resume next
// tick (see ActiveTraversalChallengeCount). View-only hook for the activator's terminal visual.
event TraversalChallengeCompleted
{
    EntityRef Challenge;
}

// Fired by TraversalChallengeUtility.Fail the instant RemainingTime runs out with nobody at the
// checkpoint - platforms are already destroyed by the time this fires, State is already back to
// Idle (retryable) - a View never actually observes TraversalChallengeState.Failed on the
// component itself, it reacts to this event instead (see that enum value's own comment).
event TraversalChallengeFailed
{
    EntityRef Challenge;
}

// Fired by PlayerLifeStateUtility.EnterDowned the instant a player's Health hits 0 (see
// docs/revive.md - replaces the old instant-respawn DamageUtility.RespawnPlayer path entirely).
// View-only hook for a downed pose/VFX - nothing consumes this yet, same "vocabulary now, wired
// later" precedent every other not-yet-wired event in this file follows.
event PlayerDowned
{
    EntityRef Entity;
}

// Fired by PlayerLifeStateUtility.EnterKO when a Downed player's own bleed-out timer runs out
// without being revived in time. View-only hook, not yet wired.
event PlayerKO
{
    EntityRef Entity;
}

// Fired by PlayerLifeStateUtility.Revive the instant a hold-to-revive channel (teammate or self)
// completes. Reviver == Target for a self-revive. View-only hook, not yet wired.
event PlayerRevived
{
    EntityRef Target;
    EntityRef Reviver;
}

// A Free Hit Guard (StatusEffects.FreeHitGuardRemaining) just negated a hit - the View-facing
// counterpart of the OnFreeHitGuardConsumed signal in Combat.qtn, carrying the position so the burst
// can play on the SAVED ally rather than on whoever granted the guard. Same reason AccessoryBlocked
// below exists: a fully negated hit fires no EntityDamaged, so without this a save reads as a miss.
event FreeHitGuardConsumed
{
    EntityRef Target;
    EntityRef Source;
    FPVector3 Position;
}

// Recoverable Accessory Guard (see AccessoryGuard.qtn/docs/accessory-guard.md). All five below are
// View-facing hooks for one-shot moments (impact FX, sounds, a pop of the collectible appearing) -
// the AccessoryView's own visibility deliberately does NOT read them, it polls AccessoryGuard.State
// directly, same self-healing "authoritative state, not an event replay" idiom
// BlobAnimationView/WeaponViewController already use for Downed/KO.

// The accessory just ate a hit. Damage is the RAW incoming amount, before any resolution - a block
// negates the hit outright, so nothing further was ever computed for it (see
// AccessoryGuardUtility.TryBlock). RemainingDurability is the value AFTER this block.
event AccessoryBlocked
{
    EntityRef Owner;
    EntityRef Attacker;
    FP        Damage;
    Byte      RemainingDurability;
    FPVector3 Position;
}

// The popped-off accessory's ballistic arc just ended - it's now lying on the ground and
// collectible by its owner. Separate from AccessoryBlocked since the landing happens some ticks
// later, wherever the arc actually came down.
event AccessoryLanded
{
    EntityRef Owner;
    FPVector3 Position;
}

// The owner walked over their own dropped accessory and put it back on, at whatever durability it
// still had - recovery never restores durability, only the accessory itself.
event AccessoryRecovered
{
    EntityRef Owner;

    // Who physically picked it up - equal to Owner when they fetched it themselves, a TEAMMATE
    // otherwise (co-op, see AccessoryGuardConfig.AllowAllyRecovery). Carried on the event so the
    // View can credit the right person without re-deriving it; the accessory always returns to
    // Owner regardless.
    EntityRef Recoverer;

    FPVector3 Position;
    Byte      Durability;
}

// Durability hit 0. No world collectible is spawned for this one - there is nothing to walk back
// for, only a Merchant replacement to buy.
event AccessoryBroken
{
    EntityRef Owner;
    FPVector3 Position;
}

// A Merchant service completed (see AccessoryServiceUtility.TryPurchaseService) - always back to
// full, so Durability is always MaxDurability. WasReplacement distinguishes a Broken replacement
// from a plain repair for presentation only; the simulation treats them identically.
event AccessoryRestored
{
    EntityRef Owner;
    Boolean   WasReplacement;
    Byte      Durability;
}
