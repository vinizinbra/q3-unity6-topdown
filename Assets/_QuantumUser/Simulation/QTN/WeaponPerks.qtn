// Optional per-weapon-owner components holding perk-specific state that used to live as flat
// fields directly on Weapon (see docs/weapon-perks.md). Split out because Weapon.qtn's
// auto-generated GetHashCode()/serializer nested one call per field, and 73 flat fields (most of
// them unused on any given weapon, since Weapon.Perks caps at 5 of ~18 perks that touch these)
// blew past clang's bracket-nesting limit compiling Quantum.Simulation for IL2CPP/Android.
// Added via f.AddOrGet<T> only when a perk that needs them is actually granted, removed
// unconditionally in WeaponSystem.SeedPerkRoster on every re-equip (same "reset before re-baking"
// invariant Weapon's core fields still follow) - so a missing component means exactly what a
// zeroed field used to mean: "this perk cluster wasn't rolled."

// A pending repeat-shot queued by Echo Chamber/Infinite Echo - see WeaponEchoState.PendingEchoes.
struct PendingEcho
{
    FP        Delay;
    FPVector3 Position;
    FPVector3 Direction;
    FP        Damage;
}

// A single free extra shot queued by Double Tap - see WeaponFireTimeMods.PendingDoubleTap. Delay
// counts down the same FP-seconds way PendingEcho.Delay does; Delay <= 0 means "nothing pending".
// Target/AimAtCenter keep the primary shot's lock: WeaponSystem.FireDoubleTapShot re-resolves the
// muzzle off the owner's current Transform3D/Aim and aims at that same target if it still exists
// (a lobbed Grenade/Napalm shot used to fly to a fixed free-aim distance and miss), falling back to
// SpawnPosition/AimDirection when it can't. IsExplosiveProc/IsCataclysm/GrantPierceAmount are snapshotted from the primary shot so
// the delayed shot still mirrors its already-resolved proc flags (see docs/weapon-perks.md's Double
// Tap simplification) instead of losing them the way an echo does.
struct PendingDoubleTapShot
{
    FP        Delay;
    FPVector3 SpawnPosition;
    FPVector3 AimDirection;
    EntityRef Target;
    Boolean   AimAtCenter;
    FP        Damage;
    Boolean   IsExplosiveProc;
    Boolean   IsCataclysm;

    // Kai's Phantom Strike (see PhantomStrikeUpgrade.PierceBonus) - a flat pierce amount rather than
    // a bool, so rank 2/3's higher bonus survives into a Double Tap's own free extra shot too.
    Int32     GrantPierceAmount;

    // Snapshotted from the primary shot so a Double Tap replay of the first bullet in a fresh
    // magazine still counts as firing "the first shot" for generic Damage Echo (Kai's Ghost Shot) -
    // see WeaponSystem.FireDoubleTapShot/DamageEchoUtility.TryScheduleEcho.
    Boolean   IsFirstBullet;
}

// -- Magazine-position perks (Opening Burst/Execution Rounds/Final Round/Escalating Rounds) --
// Read live off the existing Weapon.Ammo/MagazineSize ratio every shot in WeaponSystem.Update - no
// separate shot-index tracking needed. Threshold fields are a fraction of the magazine (e.g. 0.2 =
// "first/last 20%"). Absence of this component (or any zero field within it) means "no bonus", so
// an un-rolled weapon behaves exactly as it does with none of these perks equipped.
component WeaponMagazinePositionPerks
{
    FP OpeningBurstFireRateBonus;
    FP OpeningBurstThreshold;
    FP ExecutionRoundsDamageBonus;
    FP ExecutionRoundsThreshold;
    FP FinalRoundDamageBonus;
    FP EscalatingRoundsMaxDamageBonus;
}

// -- Shared ramp pool (Relentless Fire/Suppressive Cycle/Overcharge Cycle) --
// One counter every equipped ramp perk feeds - each perk's own Apply adds its own contribution
// into the bonus-per-stack fields and raises RampMaxStacks, rather than each tracking its own
// stack. Advances by 1 on every ISignalOnWeaponHitLanded this weapon's owner receives (see
// WeaponPerkReactionSystem), decays back down once Weapon.TimeSinceFireReleased (already tracked,
// reset every shot) exceeds RampDecayGrace - ticked in WeaponSystem.Update. Never baked into
// Weapon.DamageMultiplier/FireCooldownMultiplier; folded in live every shot instead, so there's
// nothing to revert.
component WeaponRampState
{
    Byte RampStacks;
    Byte RampMaxStacks;
    FP   RampDamageBonusPerStack;
    FP   RampFireRateBonusPerStack;
    FP   RampDecayGrace;
}

// -- Echo Chamber / Infinite Echo --
// HasEchoChamber only queues an echo for the first 3 shots of every magazine (checked against
// MagazineSize - Ammo at fire time, resets naturally every reload); HasInfiniteEcho queues one for
// every shot, no magazine-position check. EchoDelay is shared - whichever equipped perk asks for
// the longer delay wins, so combining them can't make echoes fire faster than either alone
// intends. Ticked/re-fired in WeaponSystem.Update/TickPendingEchoes.
component WeaponEchoState
{
    Boolean HasEchoChamber;
    Boolean HasInfiniteEcho;
    FP      EchoDelay;
    // 8, not 3: a fast weapon fires several shots inside one EchoDelay (BeamGun at 15/s against a
    // 0.25s delay is 4), and 3 slots silently dropped every echo past the third.
    array<PendingEcho>[8] PendingEchoes;
}

// -- Piercing Rounds / Ricochet / Double Tap --
// Piercing/Ricochet bonuses are added onto Projectile.RemainingPierces/RemainingBounces right
// after ProjectileSpawner.Spawn inside WeaponSystem.FireProjectile - only the weapon-fire path
// adds these, not every ProjectileSpawner.Spawn caller (enemy attacks, skills). Double Tap is
// rolled per shot in WeaponSystem.Update; DoubleTapDelay > 0 queues the extra shot into
// PendingDoubleTap instead of firing it the same tick, ticked down in
// WeaponSystem.Update/TickPendingDoubleTap same as WeaponEchoState.PendingEchoes.
component WeaponFireTimeMods
{
    Int32 BonusPierce;
    Int32 BonusBounces;
    FP    DoubleTapChance;
    FP    DoubleTapDelay;
    PendingDoubleTapShot PendingDoubleTap;
}

// -- Split Shot / Quantum Rounds / Explosive Sequence / Cataclysm Round --
// docs/weapon-perks.md's own "Post-impact perks" grouping (minus Ricochet, which is a fire-time
// bake, not a post-impact proc) - all four are read from the same two call sites
// (WeaponSystem.ApplyHitscanWeaponPerks / DirectHitData.ApplyTerminalWeaponPerks), so one lookup
// serves all of them instead of four. ShotsSinceExplosiveProc is runtime state (incremented every
// shot in WeaponSystem, reset when it reaches Interval), not perk-authored - the perk only bakes
// Interval/Radius/DamageMultiplier. HasCataclysmRound gates it since a bare Radius/DamageMultiplier
// of 0 is indistinguishable from "not equipped" once EscalatingRounds-style zero-effect weapons
// exist. Also written unconditionally (via f.AddOrGet) by WeaponSystem.ApplyPixieExplosiveWeapon
// for Pixie's Explosive Rounds passive ascension, independent of whether any Explosive
// Sequence/Cataclysm perk was ever rolled - see that method's own comment.
// QuantumRoundsSource is baked by QuantumRoundsWeaponPerkData.Apply ("procs->QuantumRoundsSource =
// this;", same self-referencing AssetRef pattern GroundPoundUpgrade.Source uses) purely so the view
// can resolve ImpactEffectPrefab (see QuantumRoundsWeaponPerkData.View.cs) off the exact asset that
// granted this, once DirectHitData.ApplyQuantumRounds actually chains a hit onto a second enemy.
component WeaponPostImpactProcs
{
    Boolean HasSplitShot;
    Int32   SplitShotCount;
    FP      SplitShotDamageMultiplier;

    // Mirrors SplitShotWeaponPerkData's own ProjectileOverride/LaunchAngleOverride verbatim -
    // stamped unconditionally by its Apply (see there for what Invalid/-1 mean), so this is never
    // read before being set for real. Lives here (not read off the perk asset directly) so
    // WeaponPerkUtility.SpawnSplitProjectiles - called from both DirectHitData and AreaHitData -
    // never needs to know which perk asset granted Split Shot, only whether HasSplitShot is true.
    AssetRef<ProjectileDataAsset> SplitShotProjectileOverride;
    FP SplitShotLaunchAngleOverride;

    // Total arc the fragments fan across when a real travel direction is available, centered on it -
    // mirrors SplitShotWeaponPerkData.SplitAngle verbatim, same "stamped unconditionally, never read
    // before being set for real" reasoning as the two fields above. See
    // WeaponPerkUtility.SpawnSplitProjectiles.
    FP SplitShotArcDegrees;

    Boolean HasQuantumRounds;
    FP      QuantumRoundsRadius;
    FP      QuantumRoundsDamageMultiplier;
    AssetRef<QuantumRoundsWeaponPerkData> QuantumRoundsSource;

    Int32 ExplosiveSequenceInterval;
    FP    ExplosiveSequenceRadius;
    FP    ExplosiveSequenceDamageMultiplier;
    Int32 ShotsSinceExplosiveProc;

    // Probability (0-1) that an otherwise-due explosive proc actually fires. 0 or >= 1 means "always"
    // - which is what the Explosive Sequence PERK sets, so its every-Nth-shot behavior is completely
    // unchanged. Pixie's Explosive Rounds ascension is the one consumer that authors a real chance:
    // it makes every shot due (Interval = 1) and then gates on this, which is how "15%/22%/30% of
    // weapon hits explode" is expressed without a second, parallel proc mechanism. Rolled through
    // DamageUtility.RollChance (f.RNG), so it stays deterministic.
    FP ExplosiveSequenceChance;

    // OPTIONAL internal cooldown between explosive procs, in seconds - 0 (the default, and what every
    // perk authors) disables it entirely, preserving existing behavior exactly. Exists so a very
    // high-Fire-Rate weapon carrying a per-shot proc chance can be reined in from data if playtesting
    // shows it needs it, rather than by hardcoding a limit in WeaponSystem. Ticked in
    // WeaponSystem.Update alongside the weapon's other timers.
    FP ExplosiveSequenceCooldown;
    FP ExplosiveSequenceCooldownRemaining;

    Boolean HasCataclysmRound;
    FP      CataclysmRadius;
    FP      CataclysmDamageMultiplier;
}

// -- Empty Chamber / Combat Reboot / Emergency Reload --
// All three are magazine-empty/reload-lifecycle hooks triggered from WeaponSystem.StartReload
// (Empty Chamber/Combat Reboot via ApplyMagazineEmptiedPerks) or the reload-window itself
// (Emergency Reload). EmergencyReloadApplied is a runtime latch (mirrors
// FullThrottleUpgrade.Applied) so WeaponSystem.TryApplyEmergencyReload/RevertEmergencyReload
// add/remove the CharacterStats bonuses exactly once per reload, not every tick the timer is
// running - WeaponSystem.SeedPerkRoster must revert this latch (if set) before removing this
// component on a weapon swap, or the CharacterStats bonus permanently leaks.
component WeaponReloadHooks
{
    Boolean HasEmptyChamber;
    FP      EmptyChamberRadius;
    FP      EmptyChamberKnockback;

    Boolean HasCombatReboot;
    FP      CombatRebootCooldownReduction;

    Boolean HasEmergencyReload;
    FP      EmergencyReloadMoveSpeedBonus;
    FP      EmergencyReloadDamageReduction;
    Boolean EmergencyReloadApplied;
}

// -- Predator Magazine / Killer Instinct --
// Both react to WeaponPerkReactionSystem.OnEntityKilled. KillerInstinctTimer is runtime
// state, ticked down in WeaponSystem.Update; the fire-rate bonus folds into the live
// fire-cooldown read while it's > 0, same "read live, never baked" idiom the ramp pool uses -
// restarted to KillerInstinctDuration on every kill.
component WeaponOnKillReactions
{
    Boolean HasPredatorMagazine;
    FP      PredatorMagazineRestoreFraction;

    FP KillerInstinctFireRateBonus;
    FP KillerInstinctDuration;
    FP KillerInstinctTimer;
}

// -- Bottomless Momentum / Critical Rebound / Explosive Crit / Crit Stun --
// All four react to WeaponPerkReactionSystem.OnCriticalHit, via a granted WeaponPerkData
// (Critical Rebound) or one authored straight into a weapon's own WeaponDataAsset.BaseTraits
// (ExplosiveCritWeaponPerkData/CritStunWeaponPerkData - Hellshot/Disruptor's own signature, see
// WeaponSystem.ApplyBaseTraits) - both paths bake through the exact same WeaponPerkData.Apply,
// so this component can't tell a rolled pick from a weapon's own baseline. Critical Rebound fires
// a secondary projectile toward the nearest other enemy from the crit's target position - no-op
// for a Hitscan weapon (nothing to aim a secondary projectile off of), documented simplification.
component WeaponOnCritReactions
{
    FP    CritAmmoRestoreChance;
    Int32 CritAmmoRestoreAmount;

    Boolean HasCriticalRebound;
    FP      CriticalReboundRadius;
    FP      CriticalReboundDamageMultiplier;

    // Re-entrancy latch for a HITSCAN rebound, which lands synchronously inside OnCriticalHit -
    // before the crit's own target has lost any Health. A rebound that crit again bounced straight
    // back to the first target and so on, unbounded (a stack overflow at 100% crit chance). Set
    // around that nested hit so a rebound can never itself rebound in the same call.
    Boolean ReboundInProgress;

    Boolean HasExplosiveCrit;
    FP      CriticalExplosionRadius;
    FP      CriticalExplosionDamageMultiplier;

    FP      CritStunDuration;
}

// -- Element Infusion (ElementInfusionWeaponPerkData) --
// A perk that grafts an EXTRA on-hit element onto the weapon, independent of the weapon's own
// WeaponDataAsset.Element (which keeps flowing via Projectile.Element and applies unconditionally,
// see StatusEffectUtility.TryApplyElementalStatus) - this one carries its own ProcChance and never
// overrides the native element, the two apply side by side per hit. Baked once by
// ElementInfusionWeaponPerkData.Apply,
// carried to impact via Projectile.PerkElement/PerkElementChance (projectile shots) or read live off
// this component (hitscan), and applied through StatusEffectUtility.TryApplyInfusedElement. Only one
// extra element per weapon - a second element-infusion perk last-wins, overwriting both fields.
// Removed on every re-equip in WeaponSystem.SeedPerkRoster, same as every other perk cluster here.
component WeaponElementInfusion
{
    ElementType Element;
    FP          ProcChance;
}

// -- Sequenced burst-fire (Double Barrel, Burst Rifle) --
// BurstCount/Delay/CritOnFinalShot are baked ONCE at Equip by BurstFireWeaponPerkData.Apply (a
// weapon's own baseline pick, see WeaponDataAsset.BaseTraits/WeaponSystem.ApplyBaseTraits) and
// never touched again except by WeaponSystem.Update's burst-start block re-deriving the very same
// values into a fresh runtime state - this component's mere PRESENCE is what tells WeaponSystem
// "this weapon bursts" (no BurstCount flag on WeaponDataAsset itself to check anymore). Distinct
// from the simultaneous cone-spread PelletCount on WeaponDataAsset: a burst fires ShotsRemaining
// more shots one at a time, Delay apart. SpawnPosition/AimDirection are deliberately NOT stored
// here (unlike PendingDoubleTapShot/PendingEcho's own snapshots) - TickWeaponBurst re-resolves
// them fresh off the owner's current Transform3D/Aim every queued shot, since a twin-stick shooter
// keeps moving/turning across BurstDelay and a frozen muzzle position reads as visibly wrong for a
// weapon that fires every tick. ShotsRemaining == 0 means idle (added but no burst in flight).
// Ticked/fired in WeaponSystem.Update/TickWeaponBurst (WeaponFireType is irrelevant - both Hitscan
// and Projectile weapons can burst).
component WeaponBurstState
{
    Int32     ShotsRemaining;
    Int32     NextShotIndex;
    FP        Timer;
    FP        Delay;
    Boolean   CritOnFinalShot;
    Int32     BurstCount;

    // Only what belongs to the TRIGGER PULL carries across the burst - Kai's Phantom Strike (its
    // damage factor and bonus pierce, consumed once for the whole pull). Everything magazine-driven
    // (damage from the magazine-position perks, Final Round/Cataclysm's last bullet, the Explosive
    // Sequence counter) is re-resolved per burst shot in TickWeaponBurst: each one is a real bullet,
    // and freezing shot 0's values meant a burst could never land on the magazine's actual last round.
    FP        DamageBonusMultiplier;
    Int32     GrantPierceAmount;
}
