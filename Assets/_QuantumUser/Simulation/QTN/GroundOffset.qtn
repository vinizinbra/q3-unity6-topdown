// Optional - only entities that need to settle into a resting height carry this (Sentry, Vortex,
// Chest, ...). GroundOffsetUtility.Apply resolves the ground once - right after
// SpawnedEntitySpawner.Spawn places a skill/projectile-spawned entity's Position, or right when a
// map-baked entity materializes (see MapGroundSettleSystem) - then either snaps straight to
// groundY + <collider bottom clearance> + Offset or, if the relevant approach rate below is
// authored, tags the entity with SettlingToGround so GroundSettleSystem eases it there over
// subsequent ticks instead of teleporting into place. The clearance term
// (GroundOffsetUtility.ResolveGroundClearance) already accounts for the entity's own collider
// sitting centered on its pivot, so Offset itself is a pure adjustment from true-flush: 0 sits
// flush on the ground (Sentry); a positive Offset hovers above that (Vortex); a negative Offset
// embeds it into the ground on purpose (a bomb lodged in the dirt).
component GroundOffset
{
    FP Offset;

    // Descending approach only (spawn Y above the resting height) - accelerates like real gravity
    // (SettlingToGround.FallVelocity builds up each tick) rather than moving at a flat speed, so a
    // drop reads as an actual fall instead of a lift descending on a cable. A multiplier against
    // f.SimulationConfig.Physics.Gravity (the same shared value PhysicsBody3D.GravityScale scales
    // for real dynamic bodies), not a standalone acceleration - 1 falls at the project's normal
    // gravity, 2 falls twice as fast, 0.5 drifts down softly. 0 = snap straight down instead of
    // easing.
    FP FallGravityMultiplier;

    // Ascending approach only (spawn Y below the resting height, e.g. Vortex's hover Offset) - a
    // flat speed, not gravity-accelerated, since floating up should read as a controlled levitation
    // rather than a launch. 0 = snap straight up instead of easing.
    FP FloatSpeed;
}
