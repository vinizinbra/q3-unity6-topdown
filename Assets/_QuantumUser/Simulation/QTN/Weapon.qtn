// A pending repeat-shot queued by Echo Chamber/Infinite Echo - see Weapon.PendingEchoes.
struct PendingEcho
{
    FP        Delay;
    FPVector3 Position;
    FPVector3 Direction;
    FP        Damage;
}

component Weapon
{
    AssetRef<WeaponDataAsset> WeaponData;

    // What this roll actually is - kept so UI can name the perks and two drops can be compared.
    // Never re-resolved into the stats below; WeaponSystem.Equip bakes them once. Fixed ceiling; a
    // roll asks for however many it wants up to this (see WeaponGenerator.Roll).
    array<AssetRef<WeaponPerkData>>[5] Perks;

    // Seeded from WeaponDataAsset at equip, then mutated in place by each perk. A perk is never
    // removed, so none of this is re-derived per tick.
    Int32 MagazineSize;
    FP    ReloadDuration;
    FP    CriticalChance;
    FP    CriticalDamageBonus;

    // Damage/FireCooldown are NOT baked absolutes like the stats above - WeaponSystem reads
    // WeaponDataAsset.Damage/FireCooldownTime fresh every fire and scales it by these, so tuning
    // the asset's base value in the Inspector takes effect immediately on already-equipped weapons
    // instead of only on the next Equip. Perks (DamageMultiplierWeaponPerkData,
    // CooldownMultiplierWeaponPerkData, FireRateWeaponPerkData) and the sentry-only
    // SentryFireRateUpgrade compound into these in place instead of mutating an absolute stat -
    // same reasoning CharacterStats keeps a standing multiplier rather than baking. Seeded to 1 at
    // equip (see WeaponSystem.SeedStats).
    FP    DamageMultiplier;
    FP    FireCooldownMultiplier;

    FP    FireCooldownTimer;
    Int32 Ammo;
    FP    ReloadTimer;
    FP    TimeSinceFireReleased;

    // -- Long Barrel (RangeMultiplierWeaponPerkData) --
    // Scales WeaponDataAsset.Range (hitscan) directly in WeaponSystem.FireHitscan, and
    // Projectile.MaxDistanceMultiplier (seeded from this at fire time) for a Projectile weapon -
    // see ProjectileSystem.TryExpire. Seeded to 1 at equip, same as DamageMultiplier.
    FP RangeMultiplier;

    // -- Magazine-position perks (Opening Burst/Execution Rounds/Final Round/Escalating Rounds) --
    // Read live off the existing Ammo/MagazineSize ratio every shot in WeaponSystem.Update - no
    // separate shot-index tracking needed. Threshold fields are a fraction of the magazine (e.g.
    // 0.2 = "first/last 20%"). Zero/unset (every field defaults to 0) means "no bonus", so an
    // un-rolled weapon behaves exactly as it does today.
    FP OpeningBurstFireRateBonus;
    FP OpeningBurstThreshold;
    FP ExecutionRoundsDamageBonus;
    FP ExecutionRoundsThreshold;
    FP FinalRoundDamageBonus;
    FP EscalatingRoundsMaxDamageBonus;

    // -- Shared ramp pool (Relentless Fire/Suppressive Cycle/Overcharge Cycle) --
    // One counter every equipped ramp perk feeds - each perk's own Apply adds its own contribution
    // into the bonus-per-stack fields and raises RampMaxStacks, rather than each tracking its own
    // stack. Advances by 1 on every ISignalOnWeaponHitLanded this weapon's owner receives (see
    // WeaponPerkReactionSystem), decays back down once TimeSinceFireReleased (already tracked,
    // reset every shot) exceeds RampDecayGrace - ticked in WeaponSystem.Update. Never baked into
    // DamageMultiplier/FireCooldownMultiplier; folded in live every shot instead, so there's
    // nothing to revert.
    Byte RampStacks;
    Byte RampMaxStacks;
    FP   RampDamageBonusPerStack;
    FP   RampFireRateBonusPerStack;
    FP   RampDecayGrace;

    // -- Piercing Rounds / Ricochet --
    // Added onto Projectile.RemainingPierces/RemainingBounces right after ProjectileSpawner.Spawn
    // inside WeaponSystem.FireProjectile - only the weapon-fire path adds these, not every
    // ProjectileSpawner.Spawn caller (enemy attacks, skills).
    Int32 BonusPierce;
    Int32 BonusBounces;

    // -- Double Tap --
    FP DoubleTapChance;

    // -- Split Shot --
    Boolean HasSplitShot;
    Int32   SplitShotCount;
    FP      SplitShotDamageMultiplier;

    // -- Quantum Rounds --
    Boolean HasQuantumRounds;
    FP      QuantumRoundsRadius;
    FP      QuantumRoundsDamageMultiplier;

    // -- Explosive Sequence --
    // ShotsSinceExplosiveProc is runtime state (incremented every shot in WeaponSystem, reset when
    // it reaches Interval), not perk-authored - the perk only bakes Interval/Radius/DamageMultiplier.
    Int32 ExplosiveSequenceInterval;
    FP    ExplosiveSequenceRadius;
    FP    ExplosiveSequenceDamageMultiplier;
    Int32 ShotsSinceExplosiveProc;

    // -- Cataclysm Round --
    // Triggers on the shot fired when Ammo == 1 (the last bullet), same moment Final Round reads -
    // HasCataclysmRound gates it since a bare Radius/DamageMultiplier of 0 is indistinguishable
    // from "not equipped" once EscalatingRounds-style zero-effect weapons exist.
    Boolean HasCataclysmRound;
    FP      CataclysmRadius;
    FP      CataclysmDamageMultiplier;

    // -- Echo Chamber / Infinite Echo --
    // HasEchoChamber only queues an echo for the first 3 shots of every magazine (checked against
    // MagazineSize - Ammo at fire time, resets naturally every reload); HasInfiniteEcho queues one
    // for every shot, no magazine-position check. Ticked/re-fired in WeaponSystem.Update.
    Boolean HasEchoChamber;
    Boolean HasInfiniteEcho;
    FP      EchoDelay;
    array<PendingEcho>[3] PendingEchoes;

    // -- Empty Chamber --
    Boolean HasEmptyChamber;
    FP      EmptyChamberRadius;
    FP      EmptyChamberKnockback;

    // -- Combat Reboot --
    Boolean HasCombatReboot;
    FP      CombatRebootCooldownReduction;

    // -- Predator Magazine --
    // Reacts on kill (WeaponPerkReactionSystem.OnEntityKilled), not on the magazine-empty hook -
    // restores ammo, doesn't care whether the magazine happens to be empty.
    Boolean HasPredatorMagazine;
    FP      PredatorMagazineRestoreFraction;

    // -- Emergency Reload --
    // EmergencyReloadApplied is a runtime latch (mirrors WeaponDamageOverdrive.Applied) so
    // WeaponSystem.StartReload/UpdateReload add/remove the CharacterStats bonuses exactly once per
    // reload, not every tick the timer is running.
    Boolean HasEmergencyReload;
    FP      EmergencyReloadMoveSpeedBonus;
    FP      EmergencyReloadDamageReduction;
    Boolean EmergencyReloadApplied;

    // -- Killer Instinct --
    // KillerInstinctTimer is runtime state, ticked down in WeaponSystem.Update; the fire-rate bonus
    // folds into the live fire-cooldown read while it's > 0, same "read live, never baked" idiom as
    // the ramp pool above - restarted to KillerInstinctDuration on every kill
    // (WeaponPerkReactionSystem.OnEntityKilled).
    FP KillerInstinctFireRateBonus;
    FP KillerInstinctDuration;
    FP KillerInstinctTimer;

    // -- Bottomless Momentum --
    FP    CritAmmoRestoreChance;
    Int32 CritAmmoRestoreAmount;

    // -- Critical Rebound --
    // Fires a secondary projectile toward the nearest other enemy from the crit's target position
    // (WeaponPerkReactionSystem.OnCriticalHit) - no-op for a Hitscan weapon (nothing to aim a
    // secondary projectile off of), documented simplification.
    Boolean HasCriticalRebound;
    FP      CriticalReboundRadius;
    FP      CriticalReboundDamageMultiplier;
}
