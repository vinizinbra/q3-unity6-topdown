component Weapon
{
    AssetRef<WeaponDataAsset> WeaponData;

    // What this roll actually is - kept so UI can name the perks and two drops can be compared.
    // Never re-resolved into the stats below; WeaponSystem.Equip bakes them once. Fixed ceiling; a
    // roll asks for however many it wants up to this (see WeaponGenerator.Roll).
    array<AssetRef<WeaponPerkData>>[5] Perks;

    // Seeded from WeaponDataAsset at equip, then mutated in place by each perk. A perk is never
    // removed, so none of this is re-derived per tick.
    Int32 MagazineSize;
    FP    ReloadDuration;
    FP    CriticalChance;
    FP    CriticalDamageBonus;

    // Damage/FireCooldown are NOT baked absolutes like the stats above - WeaponSystem reads
    // WeaponDataAsset.Damage/FireRate fresh every fire and scales it by these, so tuning
    // the asset's base value in the Inspector takes effect immediately on already-equipped weapons
    // instead of only on the next Equip. Perks (DamageMultiplierWeaponPerkData,
    // CooldownMultiplierWeaponPerkData, FireRateWeaponPerkData) and the sentry-only
    // Lux's sentry fire-rate composition compounds into these in place instead of mutating an absolute stat -
    // same reasoning CharacterStats keeps a standing multiplier rather than baking. Seeded to 1 at
    // equip (see WeaponSystem.SeedStats).
    FP    DamageMultiplier;
    FP    FireCooldownMultiplier;

    // Set either by Store's "Increase Weapon Level" purchase (StoreUtility.BuyWeaponLevelUp) or by a
    // freshly-rolled weapon offer's own starting Level (LevelUpOption.RolledWeaponLevel, applied via
    // WeaponChoiceUtility.Grant - see docs/store-blacksmith.md) - a per-weapon-instance counter, reset
    // to 0 on every Equip alongside DamageMultiplier (see WeaponSystem.SeedStats). Pure bookkeeping
    // for pricing/display; the actual +damage bonus is baked straight into DamageMultiplier
    // (WeaponSystem.AddLevel), same compounding idiom DamageMultiplierWeaponPerkData.Apply already
    // uses for a rolled perk - Level itself is never read back into live damage math. Distinct from
    // BOTH CharacterStats.WeaponTalentLevel (pure bookkeeping now, no longer drives perk-count rolls
    // - see LevelUpConfig.WeaponOfferCurve) and RuntimePlayer.Talents.WeaponLevel (permanent
    // meta-progression that seeds the former at spawn) - this one only affects the specific Weapon
    // instance currently equipped, resets on any re-equip.
    Byte  Level;

    FP    FireCooldownTimer;
    Int32 Ammo;
    FP    ReloadTimer;
    FP    TimeSinceFireReleased;

    // -- Long Barrel (RangeMultiplierWeaponPerkData) --
    // Scales WeaponDataAsset.Range - directly in WeaponSystem.FireHitscan for a Hitscan weapon, and
    // via WeaponPerkUtility.ResolveWeaponRange into Projectile.MaxTravelDistance (seeded at fire
    // time, see WeaponSystem.ApplyProjectilePerks) for a Projectile one - see
    // ProjectileSystem.TryExpire. Seeded to 1 at equip, same as DamageMultiplier.
    FP RangeMultiplier;

    // Every other weapon-perk field (magazine-position perks, the shared ramp pool, post-impact
    // procs, reload hooks, on-kill/on-crit reactions, hit-tracking perks, etc.) now lives on
    // optional components in WeaponPerks.qtn instead of directly on this component - see that
    // file's own header comment. Split out because this component's auto-generated
    // GetHashCode()/serializer nested one call per field, and 73 flat fields (most unused on any
    // given weapon, since Perks caps at 5 of ~18 perks that touch those fields) blew past clang's
    // bracket-nesting limit compiling Quantum.Simulation for IL2CPP/Android.
}
