// Recoverable Accessory Guard (see docs/accessory-guard.md) - every hero wears a Signature
// Accessory that eats one incoming hit outright, loses a durability point, and physically pops off
// into the world. Deliberately hero-AGNOSTIC: nothing here (or in any system reading it) knows
// whether the accessory is Max's cap, Zara's headset or Brute's mask - that's purely presentation,
// authored per hero on CharacterData's own View partial (CharacterData.View.cs) and resolved only
// by the View layer.

// Equipped is deliberately enum value 0 so a freshly-added component reads as "worn" with no
// explicit seeding needed, same zero-default convention PlayerLifeStateKind.Alive/GameState.Lobby
// already use.
//
// Airborne vs Dropped are two halves of ONE world collectible entity's life, not two entities: the
// collectible exists (and is visible) in both, but is only PICKABLE once it has actually landed -
// which is exactly what PopVelocity's own presence/removal already tracks (see
// OrbSpawnUtility.SpawnWithPop/PopMotionSystem), so AccessoryGuardSystem reads that rather than
// tracking a second timer of its own.
//
// Broken (durability 0) has NO world collectible at all - there is nothing to recover, only a
// Merchant replacement to buy (see AccessoryServiceUtility).
enum AccessoryGuardState : Byte
{
    Equipped,
    Airborne,
    Dropped,
    Broken
}

// Per-player. Seeded once at spawn from AccessoryGuardConfig (CharacterSystem.SeedAccessoryGuard),
// then never reset by anything except an explicit Merchant repair/replacement - durability
// deliberately PERSISTS across Survival -> Breathing -> Survival, which is the whole point of the
// economic decision it creates (see docs/accessory-guard.md).
component AccessoryGuard
{
    AccessoryGuardState State;

    // Current/Max rather than "missing", so a View or a shop card can render "1/3" straight off the
    // component. MaxDurability is copied off the config at seed time rather than re-read from it on
    // every check, so a mid-run config swap can never leave a player at 4/3.
    Byte CurrentDurability;
    Byte MaxDurability;

    // The world collectible this player's accessory currently IS, while Airborne/Dropped -
    // EntityRef.None while Equipped or Broken. Owned one-to-one: a player can never have two
    // outstanding accessories, since the guard can only pop off while Equipped.
    EntityRef Accessory;

    // Hard opt-out: this player has no Accessory at all and can never block, recover, repair or
    // repurchase one (Last Bastion trades the whole mechanic away for raw Health - see
    // docs/rift-mutations.md). A genuine availability flag rather than "keep durability pinned at
    // 0", so the Store's own service card correctly resolves to AccessoryServiceKind.None instead
    // of forever offering a replacement that would be immediately meaningless.
    //
    // Zero-default is deliberately "enabled", same reasoning as State's own Equipped = 0 above -
    // a freshly-seeded guard needs no explicit write. Honoured by AccessoryGuardUtility.TryBlock/
    // Restore, AccessoryServiceUtility.ResolveService and AccessoryGuardSystem.ResolveRecoverer.
    Boolean Disabled;
}

// Generic "this player's Accessory just ate a hit" hook, fired by AccessoryGuardUtility.TryBlock
// the instant a block actually resolves - in EVERY branch (dropped / degraded-in-place / broken),
// since from a reaction's point of view all three are "the accessory saved me". broken is true
// only on the branch that took durability to 0 AND wasn't rescued by an emergency reserve below.
//
// Deliberately ONE signal rather than the separate Blocked/Dropped/Destroyed/Recovered/Purchased
// set a first pass might reach for: the other four moments already have View-facing events
// (AccessoryBlocked/Landed/Recovered/Broken/Restored, Events.qtn) and no simulation consumer, and
// this is the only one an ability can meaningfully react to. Fires strictly on a real block, so a
// recovery, a Merchant purchase or a manual drop can never trigger a reaction wired to it.
signal OnAccessoryBlocked(EntityRef owner, EntityRef attacker, Boolean broken);

// Generic "this player's Accessory was recovered from the world" hook, fired by
// AccessoryGuardUtility.Recover. Deliberately NOT fired by Restore (a Merchant repair or
// replacement), because that is a purchase, not a recovery - which is what makes a reaction wired
// here impossible to farm at a shop.
//
// owner is always the accessory's OWNER, never whoever physically collected it: a teammate can pick
// it up, but it always returns to its owner, so any reward belongs to them. recoverer is passed
// separately purely so a consumer can credit the helper if it wants to.
//
// One drop passes through Recover exactly once (the guard's own state machine guarantees it), so
// "once per block/drop cycle" needs no extra bookkeeping from consumers.
signal OnAccessoryRecovered(EntityRef owner, EntityRef recoverer);

// Generic emergency reserve - a would-be BREAK instead consumes one charge and puts the accessory
// straight back on the player's head, bypassing the normal "destroyed accessories wait for the next
// Breathing Break" rule. Optional: absent on every player who hasn't been granted one.
//
// Nothing anywhere refills Charges, so "once per run, and NOT reset at Breathing Time, and NOT
// re-armed by repairing or repurchasing" is structural rather than a rule some system has to
// police - the component simply runs out. Spare Parts (docs/rift-mutations.md) is today's only
// grantor, but nothing here knows that.
component AccessoryEmergencyReserve
{
    Byte Charges;

    // What CurrentDurability is set to when a charge is consumed - clamped to MaxDurability, so a
    // player whose max is lower than this (or raised by Glass Core) still gets a sane result.
    Byte RestoreDurability;
}

// The generic dropped-accessory collectible - one component on the shared prototype
// (RuntimeConfig.Prefabs.DroppedAccessoryPrototype), identical for every hero. Ownership is the only
// thing that varies, and the View resolves its sprite through that owner (see
// DroppedAccessoryView), so there is exactly ONE prototype rather than one per hero.
component DroppedAccessory
{
    // Only this player may collect it - unlike a currency orb (CurrencyOrbSystem), which any player
    // can pick up for the whole party. Also the key the View resolves presentation through.
    EntityRef Owner;

    // True on the DEBRIS spawned by the killing block - the one that took durability to 0. It flies
    // the exact same arc as a recoverable drop (the accessory visibly gets knocked off either way),
    // but is never collectible and is NOT tracked by its owner's AccessoryGuard.Accessory: it's
    // fire-and-forget, destroyed by AccessoryGuardSystem the moment it lands, which is also where
    // AccessoryBroken fires so the destruction VFX plays at the landing point rather than at the
    // player. The owner's own State is already Broken from the instant of the hit, so the worn
    // visual disappears immediately while this is still in the air.
    Boolean Broken;
}
