// Timed debuffs applied to a target, refreshed via StatusEffectUtility and ticked by
// StatusEffectSystem. Optional - like Armor/Shield, only added in the Editor to prototypes that
// should be affectable.
component StatusEffects
{
    // Refresh-only: reapplying always extends BurnRemaining to the new duration, but only
    // overwrites BurnDamagePerTick/BurnOwner/BurnSource when the incoming tick damage is >= the
    // current one - see StatusEffectUtility.ApplyBurn. A weak follow-up hit can't downgrade an
    // already-strong burn, only extend it.
    FP BurnRemaining;
    FP BurnTickTimer;
    FP BurnDamagePerTick;
    EntityRef BurnOwner;
    DamageSource BurnSource;

    // Rift Mark - a stackable status (0..ElementalReactionConfig.MaxStacks) only a dedicated skill/
    // perk effect applies (RiftMarkEffectData), never a weapon's own Element roll. Landing Fire/Ice/
    // Rock/Lightning/Void on a target with at least one stack consumes StacksConsumedPerReaction and
    // fires that element's own reaction (see StatusEffectUtility.TryConsumeRiftMarkReaction) - the
    // mark itself is never what triggers a reaction, only what backs one. All stacks share one
    // duration (RiftMarkRemaining), refreshed on every reapply per RefreshDurationOnApply. See
    // docs/elemental-reactions.md.
    Byte RiftMarkStacks;
    FP RiftMarkRemaining;

    // Global lockout after any Rift Mark reaction consumes a stack (ElementalReactionConfig.
    // ReactionLockoutDuration) - stops a single proc event (or several damage callbacks from one)
    // from consuming more than one stack, independent of each reaction's own *CooldownRemaining
    // below. Checked-then-set atomically inside TryConsumeRiftMarkReaction.
    FP RiftMarkReactionLockoutRemaining;

    // One independent cooldown per elemental reaction (see docs/elemental-reactions.md) - stops a
    // fast-firing weapon from re-triggering the same reaction every single elemental-proc tick.
    // Plain countdowns, ticked in StatusEffectSystem alongside everything else; each reaction's own
    // TryTrigger* in StatusEffectUtility checks and resets its own field independently, so triggering
    // one reaction never gates any other. Fire->Detonation, Ice->Deep Freeze, Rock->Rupture,
    // Lightning->Overload, Void->Singularity.
    FP DetonationCooldownRemaining;
    FP DeepFreezeCooldownRemaining;
    FP OverloadCooldownRemaining;
    FP RuptureCooldownRemaining;
    FP SingularityCooldownRemaining;

    // Shared per-mechanic cooldown slots for Rift Mark *applications* (Weapon Perks + Rift Mutations -
    // see docs/rift-mutations.md/docs/weapon-perks.md), as opposed to the reaction cooldowns above -
    // indexed by RiftMarkCooldownKey (plain C# enum, Simulation-side only, never persisted itself).
    // Checked-then-set atomically inside RiftMarkApplicationUtility.TryConsumeCooldown, same shape as
    // every *CooldownRemaining field on this component.
    array<FP>[8] MarkApplicationCooldowns;

    // First Contact mutation - one-time-ever flag, not a cooldown (see docs/rift-mutations.md). Once
    // true it never resets - a fresh enemy spawn gets a fresh StatusEffects component regardless.
    Boolean FirstContactTriggered;

    // Overflowing Rift mutation's own pulse cooldown - separate from MarkApplicationCooldowns above
    // since it's triggered from inside the core apply path itself (RiftMarkApplicationUtility.
    // ApplyRequest, when a request resolves against an already-maxed target), not by an external
    // mechanic requesting a mark. See docs/rift-mutations.md.
    FP OverflowingRiftCooldownRemaining;

    // Fractured Presence mutation - per (player, this entity) exposure-time accumulator, same
    // find-or-evict-soonest shape as HasteRemaining/HasteSource above but counting UP while a player
    // stays within ElementalReactionConfig.FracturedPresenceRadius instead of counting down. Sized to
    // 4 - one slot per concurrently-exposing player, this project's established co-op cap (matches
    // Haste's own array size). See docs/rift-mutations.md.
    array<EntityRef>[4] FracturedPresenceExposedBy;
    array<FP>[4] FracturedPresenceExposureTime;

    // Slows movement - see StatusEffectUtility.GetSpeedMultiplier, read by PlayerMovementProcessor
    // and EnemySystem's chase movement. Plain overwrite-on-reapply.
    FP IceRemaining;
    FP IceSpeedMultiplier;

    // Freezes the state machine/movement/firing entirely - see StatusEffectUtility.IsStunned, read
    // by EnemySystem, PlayerMovementProcessor and WeaponSystem. Plain overwrite-on-reapply.
    FP StunRemaining;

    // Ice+RiftMark's Deep Freeze reaction - stretches an enemy's own AttackPhase.Preparation/Telegraph windup
    // (read only where EnemySystem.UpdatePreparation decrements StateTimer), not a lockout. Mirrors
    // TimeDilationRemaining's shape (a duration + a multiplier, read at one specific timer) but
    // targets the opposite phase - TimeDilationMultiplier is explicitly scoped to the Active-phase
    // timer only (see that field's own comment), so this needs its own dedicated fields rather than
    // widening TimeDilation's scope. Plain overwrite-on-reapply. See docs/elemental-reactions.md.
    FP AnticipationSlowRemaining;
    FP AnticipationSlowMultiplier;

    // Pins movement only - unlike Stun, attacking/skills/firing are untouched. See
    // StatusEffectUtility.IsRooted, read by PlayerMovementProcessor and EnemySystem. Plain
    // overwrite-on-reapply.
    FP RootRemaining;

    // Multiplies incoming damage - see StatusEffectUtility.GetIncomingDamageMultiplier, applied
    // once inside DamageUtility.ApplyDamage so every damage source respects it identically. Only
    // ever granted by the Rock+RiftMark Rupture reaction - see docs/elemental-reactions.md. Plain
    // overwrite-on-reapply.
    FP RuptureRemaining;
    FP RuptureDamageMultiplier;

    // Temporary attack-speed buff - see StatusEffectUtility.GetAttackSpeedMultiplier, folded into
    // StatUtility.GetFireCooldown alongside CharacterStats.AttackSpeedMultiplier. Stacks by source
    // (unlike Ice/Stun/Root/Break) - each slot is one HasteSource's own application, refreshed in
    // place if that same source re-applies (e.g. SentryAuraSystem re-triggering every tick it's in
    // range) rather than consuming a new slot every time, so a continuous aura and a pulsed source
    // like Zara's Speaker can both hold their own slot simultaneously. GetAttackSpeedMultiplier
    // multiplies every active slot together. Capped at 4 - only two sources exist today (a Sentry's
    // Fire Rate aura, Zara's Healing Chorus), with headroom for more; ApplyHaste evicts the
    // soonest-to-expire slot once all 4 are occupied, same shape as Poison.
    array<FP>[4] HasteRemaining;
    array<FP>[4] HasteAttackSpeedMultiplier;
    array<EntityRef>[4] HasteSource;

    // Temporary shield-recharge-rate buff - see StatusEffectUtility.GetShieldRegenMultiplier, folded
    // into ShieldSystem's own RechargeRate. Plain overwrite-on-reapply, same as Haste - a buff has no
    // "downgrade feels bad" concern the way Burn's tick damage does.
    FP ShieldRegenRemaining;
    FP ShieldRegenMultiplier;

    // Slows this entity's own attack-execution timers (Kai's Void Pressure passive ascension) - a
    // true time dilation on the entity's own clock, independent of Ice (which only ever affects
    // movement speed). See StatusEffectUtility.ApplyTimeDilation/GetLocalTimeMultiplier, read only by
    // each EnemyDeliveryData's own Active-phase timer - never the Preparation/Telegraph windup or
    // Recovery, and never attack cooldowns, so a slowed enemy's tell still reads at normal speed and
    // it doesn't attack less often, just slower while actually mid-attack. Plain overwrite-on-reapply,
    // same as Ice/Break.
    FP TimeDilationRemaining;
    FP TimeDilationMultiplier;

    // Temporary incoming-damage reduction (Max's Too Angry to Die passive ascension) - a timed
    // counterpart to CharacterStats.DamageReduction's permanent fraction, same 0-1 convention (0 =
    // no reduction, 1 = fully immune). See StatusEffectUtility.ApplyDamageReduction/
    // GetDamageReductionMultiplier, folded into DamageUtility.ResolveDamageReduction alongside the
    // permanent stat - the two stack rather than one replacing the other. Plain overwrite-on-reapply,
    // same as Ice/Break/TimeDilation.
    FP DamageReductionRemaining;
    FP DamageReductionAmount;

    // Guardian ascension's own dedicated pair (Brute's Protector Aura, ally-targeted - see
    // ProtectorAuraSystem.ApplyToAllies) - deliberately NOT folded into the generic
    // DamageReductionRemaining/DamageReductionAmount pair above, even though the effect (a timed
    // incoming-damage reduction) is identical - Guardian's aura refreshes every tick an ally stays
    // in range, so sharing the generic slot with Max's Too Angry to Die would let either one
    // silently overwrite the other's duration/amount if both ever land on the same entity in the
    // same tick. Same 0-1 convention, same StatusEffectUtility.ApplyGuardianDamageReduction/
    // GetGuardianDamageReductionMultiplier shape, folded into DamageUtility.ResolveDamageReduction
    // alongside the other two (all three stack multiplicatively).
    FP GuardianDamageReductionRemaining;
    FP GuardianDamageReductionAmount;

    // A second, independent timed DR pair, generic (not Guardian-named) since two different reactive
    // procs both write to it: Brute's Guardian ascension rank 3 (an ally in the aura losing
    // Shield/Health from an enemy hit) and Bodyguard rank 3 (allies near a completed Dash) - both are
    // occasional reactive bonuses layered ON TOP of the continuous Guardian aura DR above, not a
    // replacement for it, so they can't share that pair (which the aura rewrites every single tick -
    // see ProtectorAuraSystem.ApplyToAllies - and would immediately stomp a longer/rarer reactive
    // bonus). See StatusEffectUtility.ApplyTemporaryDamageReduction/GetTemporaryDamageReductionMultiplier,
    // folded into DamageUtility.ResolveDamageReduction alongside the other two (all three stack
    // multiplicatively). Take-the-stronger/longer semantics on reapply, unlike the plain
    // overwrite-on-reapply every other timed multiplier here uses - a weak proc landing right after a
    // strong one shouldn't cut the strong one's window short.
    FP TemporaryDamageReductionRemaining;
    FP TemporaryDamageReductionAmount;

    // Guardian ascension rank 3's own per-ally cooldown, so a target getting hit repeatedly in quick
    // succession doesn't refresh the reactive DR bonus above on every single hit - see
    // BruteProtectorReactionSystem. Bodyguard's own proc needs no equivalent cooldown - it's already
    // paced by the Dash's own cooldown.
    FP GuardianReactiveCooldownRemaining;

    // Reduces the AFFECTED entity's own OUTGOING damage (Brute's Protector Aura Intimidate debuff) -
    // the mirror of Break, which reduces INCOMING damage instead. Read via
    // StatusEffectUtility.GetOutgoingDamageMultiplier, folded into
    // DamageUtility.ResolveOutgoingDamage BEFORE that method's CharacterStats gate, since this has
    // to affect enemies too and enemies never carry CharacterStats. Plain overwrite-on-reapply.
    FP IntimidateRemaining;
    FP IntimidateDamageMultiplier;

    // Multiplies incoming knockback (values > 1 = more knockback taken) - Brute's Iron Presence
    // ascension applies this to Intimidated enemies alongside Ice's own slow. Folded into
    // DamageUtility.ResolveKnockbackScale alongside CharacterStats.KnockbackTakenMultiplier and the
    // enemy-tier resistance multiplier - all three stack rather than one replacing another. Plain
    // overwrite-on-reapply.
    FP KnockbackTakenRemaining;
    FP KnockbackTakenMultiplier;

    // Brief full-immunity window opened by Max's Too Angry to Die Hero Skill Upgrade the instant a
    // cheat-death save actually triggers (see CheatDeathUtility.TryPreventLethal) - NOT the same
    // mechanism as DamageReductionRemaining above, which belongs to a separate, unrelated Adrenaline-
    // based "Too Angry to Die" passive ascension. This one just gates when the Invulnerable tag
    // CheatDeathUtility adds gets removed again - see StatusEffectSystem's own tick.
    FP CheatDeathImmunityRemaining;

    // Temporary Weapon Damage buff (Max's Last Stand rank 2 retaliation proc, Run & Gun rank 2) -
    // see StatusEffectUtility.ApplyTemporaryWeaponDamage/GetTemporaryWeaponDamageMultiplier, folded
    // into DamageUtility.ResolveOutgoingDamage's existing DamageSource.Weapon block. Take-the-
    // stronger/longer semantics on reapply, same shape as TemporaryDamageReductionRemaining/Amount -
    // two independent reactive procs both write here, so a weak one landing right after a strong one
    // can't cut the strong one's window short.
    FP TemporaryWeaponDamageRemaining;
    FP TemporaryWeaponDamageAmount;

    // Last Stand rank 2's own per-owner proc cooldown, so getting hit repeatedly in quick succession
    // doesn't refresh the retaliation buff above on every single hit - see MaxOverdriveReactionSystem,
    // same shape as Brute's GuardianReactiveCooldownRemaining (read/written directly by the reacting
    // system, not via a StatusEffectUtility getter).
    FP RetaliationCooldownRemaining;

    // Timed window where WeaponSystem skips consuming Ammo entirely (Max's Run & Gun rank 3) -
    // checked directly via StatusEffectUtility.HasNoAmmoConsumption right before WeaponSystem's own
    // unconditional Weapon.Ammo--.
    FP NoAmmoConsumptionRemaining;

    // Generic (not Kai-named) - marks this entity as a valid target for "bonus damage to Bound
    // enemies" effects (Kai's Undertow rank 3 "Gravitational Bond" is the first consumer). See
    // StatusEffectUtility.ApplyBound/IsBound, read in DamageUtility.ResolveOutgoingDamage. Plain
    // overwrite-on-reapply, same as Ice/Stun/Root.
    FP BoundRemaining;

    // Temporary move-speed buff (Store's Energy Drink food offer - see docs/store-blacksmith.md) -
    // see StatusEffectUtility.ApplyTempMoveSpeed/GetTempMoveSpeedMultiplier, folded into
    // PlayerMovementProcessor.BeforeMove alongside CharacterStats.MoveSpeedMultiplier/Ice's own
    // slow. Plain overwrite-on-reapply, same as Ice/Haste - a buff has no "downgrade feels bad"
    // concern the way Burn's tick damage does.
    FP TempMoveSpeedRemaining;
    FP TempMoveSpeedMultiplier;

    // Post-revive grace window (see docs/revive.md/PlayerLifeStateUtility.Revive) - a second,
    // independent reason the Invulnerable tag is present alongside CheatDeathImmunityRemaining
    // above, same "own dedicated field, never a shared slot" convention this file already
    // establishes. Just gates when Invulnerable gets removed again - see
    // StatusEffectSystem.TickReviveImmunity.
    FP ReviveImmunityRemaining;
}
