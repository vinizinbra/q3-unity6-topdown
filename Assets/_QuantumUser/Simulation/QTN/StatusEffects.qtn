// Timed debuffs applied to a target, refreshed via StatusEffectUtility and ticked by
// StatusEffectSystem. Optional - like Armor/Shield, only added in the Editor to prototypes that
// should be affectable.
component StatusEffects
{
    // The FIRST of Fire/Ice/Rock/Lightning to ever land a baseline status on this entity (Neutral
    // until then) - set exactly once, by ApplyBurn/ApplyIce/ApplyIntimidate/ApplyElectrified (see each
    // one's own MarkFirstElementApplied call), and never overwritten again even if a different element
    // lands afterward. Purely a presentation hook - HitFeedback polls this directly every frame (via
    // StatusEffectUtility.GetFirstElementApplied) alongside the matching IsBurning/IsSlowed/
    // IsElectrified/IsIntimidated to give the entity a rest-color tint (e.g. Fire orange, Lightning
    // yellow, Ice cyan) WHILE that first status is still actually active, reverting to the entity's
    // original rest color once it expires - no event needed, since the tint has to track live
    // active/inactive state rather than a one-shot "was ever hit".
    ElementType FirstElementApplied;

    // Refresh-only: reapplying always extends BurnRemaining to the new duration, but only
    // overwrites BurnDamagePerTick/BurnOwner/BurnSource when the incoming tick damage is >= the
    // current one - see StatusEffectUtility.ApplyBurn. A weak follow-up hit can't downgrade an
    // already-strong burn, only extend it.
    FP BurnRemaining;
    FP BurnTickTimer;
    FP BurnDamagePerTick;
    EntityRef BurnOwner;
    DamageSource BurnSource;

    // Shock/Electrified - Lightning's baseline status (see StatusEffectUtility.ApplyElectrified/
    // IsElectrified), applied the same way Fire->Burn/Ice->Slow are. Plain overwrite-on-reapply, no
    // tier duration scaling - Boss stays vulnerable to this soft-CC-flavored DoT-analog the same way
    // it stays vulnerable to Burn/Slow. See docs/elemental-reactions.md.
    FP ElectrifiedRemaining;

    // Counts down from ElementalReactionConfig.JoltInterval while ElectrifiedRemaining > 0; on
    // reaching 0, StatusEffectSystem.TickElectrified applies a Jolt (a brief Stagger, see
    // StatusEffectUtility.ApplyStagger) and resets this back to JoltInterval. Purely deterministic,
    // interval-based - no proc chance.
    FP ElectrifiedJoltTimer;

    // Stagger - pauses (never cancels/resets) an enemy's own Preparation/Telegraph windup timer for
    // as long as this is > 0 (see EnemySystem.UpdatePreparation). Flat unconditional decrement, no
    // dedicated Tick method needed - same shape as RootRemaining. Deliberately no diminishing-returns
    // immunity window like Stun has - Shock's Jolt needs to be repeatably interruptive, an immunity
    // window would defeat that identity.
    FP StaggerRemaining;

    // One independent cooldown per elemental reaction (see docs/elemental-reactions.md) - stops a
    // fast-firing weapon from re-triggering the same reaction every single elemental-proc tick.
    // Plain countdowns, ticked in StatusEffectSystem alongside everything else; each reaction's own
    // TryTrigger* in StatusEffectUtility checks and resets its own field independently, so triggering
    // one reaction never gates any other. Burn+Chill->Thermal Shock, Burn+Shock->Overload,
    // Chill+Shock->Shatter - reactions are symmetric (order-independent), gated only by whichever
    // field the firing reaction owns.
    FP ThermalShockCooldownRemaining;
    FP OverloadCooldownRemaining;
    FP ShatterCooldownRemaining;

    // Overload's own chain-continuation state - lives on the ORIGIN entity (the one that actually
    // triggered the reaction) even as the chain's logical position moves node-to-node to OTHER
    // entities each hop, since this is just data, not something that needs to migrate to whichever
    // entity the chain currently sits at. Ticked by StatusEffectSystem.TickOverloadChain, advanced by
    // StatusEffectUtility.TryAdvanceOverloadChain - see docs/elemental-reactions.md. HopsRemaining
    // == 0 means no chain is in progress (the live-check every other consumer of this state uses).
    FP OverloadChainHopTimer;
    Byte OverloadChainHopsRemaining;
    EntityRef OverloadChainOwner;
    DamageSource OverloadChainSource;
    FPVector3 OverloadChainPosition;
    array<EntityRef>[8] OverloadChainVisited;
    Byte OverloadChainVisitedCount;

    // The damage the chain is CURRENTLY carrying - seeded from the origin's own hit
    // (hitDamage * OverloadInitialDamagePercent) and multiplied by OverloadChainDamagePercent every
    // subsequent hop, so the chain decays hop over hop rather than dealing a flat number
    // disconnected from how hard the triggering hit landed. See StatusEffectUtility.
    // TryTriggerOverload/TryAdvanceOverloadChain.
    FP OverloadChainCurrentDamage;

    // Slows movement - see StatusEffectUtility.GetSpeedMultiplier, read by PlayerMovementProcessor
    // and EnemySystem's chase movement. Plain overwrite-on-reapply.
    FP IceRemaining;
    FP IceSpeedMultiplier;

    // Freezes the state machine/movement/firing entirely - see StatusEffectUtility.IsStunned, read
    // by EnemySystem, PlayerMovementProcessor and WeaponSystem. Plain overwrite-on-reapply.
    FP StunRemaining;

    // Generic hard-CC diminishing-returns windows (see EnemyTierResistanceConfig.
    // TierStatusResistance.StunImmunityDuration/InterruptImmunityDuration). While > 0, a further
    // Stun (StatusEffectUtility.ApplyStun) or action-interrupt (EnemyActionUtility.TryInterrupt) is
    // REJECTED outright rather than refreshing - which is what stops a repeating pulse (Kai's
    // Singularity gravity pulses, Zara's Bass Drop, Brute's Concussive Impact shockwaves) from
    // perma-locking a protected enemy. Seeded to (the applied CC's own duration + that tier's
    // authored immunity window) at the moment the CC lands, so the gap is measured from the end of
    // the CC, not its start. Stays 0 forever for anything with no tier resistance (the player, any
    // non-Enemy), reproducing the pre-existing refresh-on-reapply behavior exactly.
    FP StunImmunityRemaining;
    FP InterruptImmunityRemaining;

    // Stretches an enemy's own AttackPhase.Preparation/Telegraph windup (read only where
    // EnemySystem.UpdatePreparation decrements StateTimer), not a lockout - applied by FreezeEffectData,
    // a standalone freely-authorable skill effect. Mirrors TimeDilationRemaining's shape (a duration +
    // a multiplier, read at one specific timer) but targets the opposite phase - TimeDilationMultiplier
    // is explicitly scoped to the Active-phase timer only (see that field's own comment), so this needs
    // its own dedicated fields rather than widening TimeDilation's scope. Plain overwrite-on-reapply.
    FP AnticipationSlowRemaining;
    FP AnticipationSlowMultiplier;

    // Pins movement only - unlike Stun, attacking/skills/firing are untouched. See
    // StatusEffectUtility.IsRooted, read by PlayerMovementProcessor and EnemySystem. Plain
    // overwrite-on-reapply.
    FP RootRemaining;

    // Multiplies incoming damage - see StatusEffectUtility.GetIncomingDamageMultiplier, applied
    // once inside DamageUtility.ApplyDamage so every damage source respects it identically. Granted
    // by Brute's Groundbreaker, the Scrapjaw boss's combo-chain finish, Scrapstorm, and a wall-hit
    // charge expose - see ApplyRupture's own callers. Plain overwrite-on-reapply (take-the-stronger/
    // longer, see ApplyRupture).
    FP RuptureRemaining;
    FP RuptureDamageMultiplier;

    // Temporary attack-speed buff - see StatusEffectUtility.GetAttackSpeedMultiplier, folded into
    // StatUtility.GetFireCooldown alongside CharacterStats.AttackSpeedMultiplier. Stacks by source
    // (unlike Ice/Stun/Root/Break) - each slot is one HasteSource's own application, refreshed in
    // place if that same source re-applies (e.g. SentryAuraSystem re-triggering every tick it's in
    // range) rather than consuming a new slot every time, so a continuous aura and a pulsed source
    // like Zara's Speaker can both hold their own slot simultaneously. GetAttackSpeedMultiplier
    // multiplies every active slot together. Capped at 4 - only two sources exist today (a Sentry's
    // Fire Rate aura, Zara's Healing Chorus), with headroom for more; ApplyHaste evicts the
    // soonest-to-expire slot once all 4 are occupied, same shape as Poison.
    array<FP>[4] HasteRemaining;
    array<FP>[4] HasteAttackSpeedMultiplier;
    array<EntityRef>[4] HasteSource;

    // Temporary shield-recharge-rate buff - see StatusEffectUtility.GetShieldRegenMultiplier, folded
    // into ShieldSystem's own RechargeRate. Plain overwrite-on-reapply, same as Haste - a buff has no
    // "downgrade feels bad" concern the way Burn's tick damage does.
    FP ShieldRegenRemaining;
    FP ShieldRegenMultiplier;

    // Slows this entity's own attack-execution timers (Kai's Void Pressure passive ascension) - a
    // true time dilation on the entity's own clock, independent of Ice (which only ever affects
    // movement speed). See StatusEffectUtility.ApplyTimeDilation/GetLocalTimeMultiplier, read only by
    // each EnemyDeliveryData's own Active-phase timer - never the Preparation/Telegraph windup or
    // Recovery, and never attack cooldowns, so a slowed enemy's tell still reads at normal speed and
    // it doesn't attack less often, just slower while actually mid-attack. Plain overwrite-on-reapply,
    // same as Ice/Break.
    FP TimeDilationRemaining;
    FP TimeDilationMultiplier;

    // Temporary incoming-damage reduction (Max's Too Angry to Die passive ascension) - a timed
    // counterpart to CharacterStats.DamageReduction's permanent fraction, same 0-1 convention (0 =
    // no reduction, 1 = fully immune). See StatusEffectUtility.ApplyDamageReduction/
    // GetDamageReductionMultiplier, folded into DamageUtility.ResolveDamageReduction alongside the
    // permanent stat - the two stack rather than one replacing the other. Plain overwrite-on-reapply,
    // same as Ice/Break/TimeDilation.
    FP DamageReductionRemaining;
    FP DamageReductionAmount;

    // The shared CONTINUOUS-AURA damage-reduction slot (Brute's Guardian, Lux's Fire Support - any
    // "stand inside my radius and take less damage" source). Deliberately NOT folded into the generic
    // DamageReductionRemaining/DamageReductionAmount pair above, even though the effect (a timed
    // incoming-damage reduction) is identical - an aura refreshes every tick an ally stays in range,
    // so sharing that slot with Max's Too Angry to Die would let either one silently overwrite the
    // other's duration/amount if both ever land on the same entity in the same tick.
    //
    // Renamed off the old Guardian-specific name once a second hero's aura needed the same slot -
    // this ONE slot is the explicit stacking policy the spec asks for: two aura sources (two Brutes,
    // or a Brute plus a Lux Sentry) never stack additively, the STRONGEST simply wins for as long as
    // it keeps refreshing (see StatusEffectUtility.ApplyAuraDamageReduction's take-the-stronger
    // semantics). Same 0-1 convention as the pairs above, folded into
    // DamageUtility.ResolveDamageReduction alongside them (all three stack multiplicatively).
    FP AuraDamageReductionRemaining;
    FP AuraDamageReductionAmount;

    // A second, independent timed DR pair, generic (not Guardian-named) since two different reactive
    // procs both write to it: Brute's Guardian ascension rank 3 (an ally in the aura losing
    // Shield/Health from an enemy hit) and Bodyguard rank 3 (allies near a completed Dash) - both are
    // occasional reactive bonuses layered ON TOP of the continuous Guardian aura DR above, not a
    // replacement for it, so they can't share that pair (which the aura rewrites every single tick -
    // see ProtectorAuraSystem.ApplyToAllies - and would immediately stomp a longer/rarer reactive
    // bonus). See StatusEffectUtility.ApplyTemporaryDamageReduction/GetTemporaryDamageReductionMultiplier,
    // folded into DamageUtility.ResolveDamageReduction alongside the other two (all three stack
    // multiplicatively). Take-the-stronger/longer semantics on reapply, unlike the plain
    // overwrite-on-reapply every other timed multiplier here uses - a weak proc landing right after a
    // strong one shouldn't cut the strong one's window short.
    FP TemporaryDamageReductionRemaining;
    FP TemporaryDamageReductionAmount;

    // Per-ally cooldown for a REACTIVE damage-reduction proc, so a target getting hit repeatedly in
    // quick succession doesn't refresh the bonus above on every single hit - Brute's Guardian rank 3
    // is the only writer today (see BruteProtectorReactionSystem), but the name is generic so any
    // future "ally took a hit -> brief DR" proc shares one pacing slot rather than each adding a
    // field.
    FP ReactiveDamageReductionCooldownRemaining;

    // Per-ally cooldown for an ALLY-GUARD-GRANT proc (Brute's Bodyguard rank 1-3). Its own slot
    // rather than sharing the reactive-DR one just above: the two are granted by different sources
    // with different pacing, and a Brute running both shouldn't have one silently gate the other.
    // Deliberately per-ALLY (on the receiving entity) rather than per-Brute, so a dash-cooldown build
    // can't funnel unlimited protection into one teammate - see docs/brute-ascensions.md.
    FP AllyGuardGrantCooldownRemaining;

    // FREE HIT GUARD - a one-shot, timed, COMPLETE negation of the next damaging hit. Generic and
    // hero-agnostic; Brute's Bodyguard is simply its first consumer.
    //
    // Consumed by DamageUtility.ApplyDamage immediately ABOVE the Accessory Guard hook, under the
    // same bypassOutgoingResolution == false gate, so it is spent before any accessory durability is
    // and negates just as cleanly (no crit roll, no elemental proc, no Rage build, no
    // on-hit signal). Reapply is take-the-longer, matching every other timed slot here.
    //
    // Source is who GRANTED the guard, not who is protected by it - it's what lets a granter be paid
    // back when their guard actually saves someone (see OnFreeHitGuardConsumed in Combat.qtn). The
    // reward itself deliberately lives with the granting ability, never here, so this stays a
    // primitive rather than a Bodyguard field.
    FP FreeHitGuardRemaining;
    EntityRef FreeHitGuardSource;

    // The FULL duration of the guard currently running, purely so a View can render Remaining as a
    // fraction (CharacterUiWidget's radial fill). Every other timed status here gets away without a
    // denominator because they only ever show a countdown NUMBER (StatusIndicator.timerText) - a fill
    // is the first readout that needs to know what "full" was, and re-deriving it View-side by
    // remembering the largest Remaining ever seen breaks the moment a longer guard refreshes a
    // shorter one. Written by ApplyFreeHitGuard alongside Remaining, cleared with it.
    FP FreeHitGuardDuration;


    // Generic timed OUTGOING-damage buff (Zara's Power Chord Support Beat is the first consumer) -
    // the mirror of TemporaryWeaponDamageRemaining/Amount just below, but applying to EVERY
    // DamageSource rather than only DamageSource.Weapon, since a tempo-support buff is meant to speed
    // up whatever the buffed ally's own build actually does. See
    // StatusEffectUtility.ApplyTempOutgoingDamage/GetTempOutgoingDamageMultiplier, folded into
    // DamageUtility.ResolveOutgoingDamage before its own per-source blocks. Take-the-stronger/longer
    // semantics on reapply, same shape as TemporaryWeaponDamage - a pulsing source re-applying every
    // beat must never cut a stronger window short.
    FP TempOutgoingDamageRemaining;
    FP TempOutgoingDamageAmount;

    // Reduces the AFFECTED entity's own OUTGOING damage (Brute's Protector Aura Intimidate debuff) -
    // the mirror of Break, which reduces INCOMING damage instead. Read via
    // StatusEffectUtility.GetOutgoingDamageMultiplier, folded into
    // DamageUtility.ResolveOutgoingDamage BEFORE that method's CharacterStats gate, since this has
    // to affect enemies too and enemies never carry CharacterStats. Plain overwrite-on-reapply.
    FP IntimidateRemaining;
    FP IntimidateDamageMultiplier;

    // Multiplies incoming knockback (values > 1 = more knockback taken) - Brute's Iron Presence
    // ascension applies this to Intimidated enemies alongside Ice's own slow. Folded into
    // DamageUtility.ResolveKnockbackScale alongside CharacterStats.KnockbackTakenMultiplier and the
    // enemy-tier resistance multiplier - all three stack rather than one replacing another. Plain
    // overwrite-on-reapply.
    FP KnockbackTakenRemaining;
    FP KnockbackTakenMultiplier;

    // Brief full-immunity window opened by Max's Too Angry to Die Hero Skill Upgrade the instant a
    // cheat-death save actually triggers (see CheatDeathUtility.TryPreventLethal) - NOT the same
    // mechanism as DamageReductionRemaining above, which belongs to a separate, unrelated Adrenaline-
    // based "Too Angry to Die" passive ascension. This one just gates when the Invulnerable tag
    // CheatDeathUtility adds gets removed again - see StatusEffectSystem's own tick.
    FP CheatDeathImmunityRemaining;

    // Temporary Weapon Damage buff (Max's Last Stand rank 2 retaliation proc, Run & Gun rank 2) -
    // see StatusEffectUtility.ApplyTemporaryWeaponDamage/GetTemporaryWeaponDamageMultiplier, folded
    // into DamageUtility.ResolveOutgoingDamage's existing DamageSource.Weapon block. Take-the-
    // stronger/longer semantics on reapply, same shape as TemporaryDamageReductionRemaining/Amount -
    // two independent reactive procs both write here, so a weak one landing right after a strong one
    // can't cut the strong one's window short.
    FP TemporaryWeaponDamageRemaining;
    FP TemporaryWeaponDamageAmount;

    // Last Stand rank 2's own per-owner proc cooldown, so getting hit repeatedly in quick succession
    // doesn't refresh the retaliation buff above on every single hit - see MaxOverdriveReactionSystem,
    // same shape as Brute's GuardianReactiveCooldownRemaining (read/written directly by the reacting
    // system, not via a StatusEffectUtility getter).
    FP RetaliationCooldownRemaining;

    // Timed window where WeaponSystem skips consuming Ammo entirely (Max's Run & Gun rank 3) -
    // checked directly via StatusEffectUtility.HasNoAmmoConsumption right before WeaponSystem's own
    // unconditional Weapon.Ammo--.
    FP NoAmmoConsumptionRemaining;

    // Generic (not Kai-named) - marks this entity as a valid target for "bonus damage to Bound
    // enemies" effects (Kai's Undertow rank 3 "Gravitational Bond" is the first consumer). See
    // StatusEffectUtility.ApplyBound/IsBound, read in DamageUtility.ResolveOutgoingDamage. Plain
    // overwrite-on-reapply, same as Ice/Stun/Root.
    FP BoundRemaining;

    // Temporary move-speed buff (Store's Energy Drink food offer - see docs/store-blacksmith.md) -
    // see StatusEffectUtility.ApplyTempMoveSpeed/GetTempMoveSpeedMultiplier, folded into
    // PlayerMovementProcessor.BeforeMove alongside CharacterStats.MoveSpeedMultiplier/Ice's own
    // slow. Plain overwrite-on-reapply, same as Ice/Haste - a buff has no "downgrade feels bad"
    // concern the way Burn's tick damage does.
    FP TempMoveSpeedRemaining;
    FP TempMoveSpeedMultiplier;

    // Post-revive grace window (see docs/revive.md/PlayerLifeStateUtility.Revive) - a second,
    // independent reason the Invulnerable tag is present alongside CheatDeathImmunityRemaining
    // above, same "own dedicated field, never a shared slot" convention this file already
    // establishes. Just gates when Invulnerable gets removed again - see
    // StatusEffectSystem.TickReviveImmunity.
    FP ReviveImmunityRemaining;
}
