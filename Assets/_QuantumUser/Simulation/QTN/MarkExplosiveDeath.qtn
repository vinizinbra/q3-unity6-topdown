// Granted/revoked by an upgrade (see Skills/MarkExplosiveDeathSkillAction - shared by Max's Berserk
// and Pixie's bomb, or anything else that wants it) - while present, DamageUtility.ApplyDamage marks
// every enemy the owner lands a hit on with its own ExplodeOnDeath, so each one explodes in turn
// whenever it eventually dies. No DamagePercent here anymore - that's centralized on
// ExplodeOnDeathConfig (RuntimeConfig.ExplodeOnDeathConfig) as one shared balance knob instead of
// being authored per upgrade.
component MarkExplosiveDeath
{
    Byte Stacks;

    // Pixie-only - gates marking to genuine explosive damage only (her bomb, a weapon perk that
    // procs an explosion, or a chained blast - see DamageUtility.TryMarkExplodeOnDeath's own
    // isExplosion/isChainedExplosion handling). Defaults false, so Max's Berserk (the only other
    // grantor, via MarkExplosiveDeathSkillAction, which never touches this field) still marks on any
    // hit exactly as before this field existed. Pixie's own passive sets this true.
    Boolean RequiresExplosion;

    // Pixie-only tier gate for her own Chain Reaction passive. HasTierGate defaults false (the
    // component's own zero-init), so Max's Berserk (the only other grantor, via
    // MarkExplosiveDeathSkillAction, which never touches either field) marks every tier exactly as
    // before this pair existed - Filler (enum value 0) would have silently become the gate otherwise,
    // which is exactly the regression this boolean avoids. Pixie's own passive sets HasTierGate true
    // and MaxAffectedTier to Normal (Filler/Normal only); her Heavy Payload ascension raises the
    // latter to Elite (marks everything except Boss).
    //
    // MaxAffectedTier is a raw EnemyTier ordinal (Byte), not the enum itself - EnemyTier is a plain
    // C# enum (EnemyDataAsset.cs), never declared through the qtn DSL the way every other enum used
    // as a component field here is (see DamageSource.qtn/ElementType.qtn/etc.), so the codegen can't
    // resolve it directly as a field type. Cast at every read/write site instead
    // ((byte)EnemyTier.Whatever / (EnemyTier)mark->MaxAffectedTier) rather than duplicating/moving
    // that enum's declaration into the DSL, which would risk the existing, widely-used C# enum.
    Boolean HasTierGate;
    Byte MaxAffectedTier;

    // Pixie Chain Reaction only - probability [0,1] that a qualifying explosion hit actually applies
    // the death mark, rolled per hit (DamageUtility.RollChance in TryMarkExplodeOnDeath). HasMarkChance
    // gates it the same way HasTierGate gates MaxAffectedTier: default false (zero-init) means NO
    // chance gate at all, so Max's Berserk grant (MarkExplosiveDeathSkillAction, which sets neither
    // field) still marks on every single hit exactly as before. Pixie's base passive sets HasMarkChance
    // true with a sub-1 MarkChance; her guaranteed-chain ascension raises MarkChance to 1.
    Boolean HasMarkChance;
    FP MarkChance;

    // Pixie-only ascensions on the shared death-explosion math (DamageUtility.TryExplodeOnDeath) -
    // all "no effect" by default (1/1/0/false) so Max's Berserk is completely unaffected by any of
    // them. Both are Unstable Mixture's own fields now (Bigger Boom/Heavy Payload were folded into
    // it - see UnstableMixturePassiveUpgradeData):
    FP BonusRadiusMultiplier;
    FP BonusDamageMultiplier;

    // Chain Reaction ascension - 0 (off) means a secondary/chained blast (see
    // DamageUtility.TryExplodeOnDeath's own isChainedExplosion flag) never re-marks anyone it also
    // catches; above 0, it does, at this fraction of a direct hit's normal mark duration.
    FP ChainReactionMultiplier;

    // Unstable Mixture ascension - multiplies a Specialist+/Heavy+ kill's own death-explosion RADIUS
    // only (not damage - see DamageUtility.TryExplodeOnDeath), on top of BonusRadiusMultiplier above.
    // Unstable Mixture also raises MaxAffectedTier to Heavy so Specialist/Heavy kills actually become
    // markable in the first place (this used to be Heavy Payload's own role, before it was folded in).
    FP TierRadiusMultiplier;

    // Unstable Targeting ascension - a live outgoing-damage multiplier read in DamageUtility.
    // ResolveOutgoingDamage whenever the target currently carries ExplodeOnDeath ("Unstable" - i.e.
    // marked to explode on death, from this or any other source), same "read live, never baked into
    // CharacterStats" idiom Max's Hot Target already uses for its own conditional bonus. Distinct
    // from BonusDamageMultiplier above, which only scales a marked enemy's own death-explosion
    // payout (TryExplodeOnDeath) - this instead rewards hitting an already-marked enemy while it's
    // still alive, encouraging focus-firing a target Chain Reaction (or anything else) has primed.
    // Defaults to 1 (no effect), same as every other Pixie-only multiplier here.
    FP DamageBonusVsUnstable;
}
