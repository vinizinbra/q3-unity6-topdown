// A single pending "go off shortly, over there" area blast, parked on the OWNER's own entity and
// counted down by DelayedBlastSystem. Generic and hero-agnostic - the same "countdown component on
// the hero, ticked by its own tiny System" shape Zara's ZaraAfterbeat already uses,
// chosen over spawning a marker entity because there is nothing physical or visual to represent
// between scheduling and firing.
//
// One consumer today: Brute's Aftershock rank 3 "Earthquake" (a second shockwave half a second after
// the first). Pixie's old Unstable Mixture rank 3 secondary blast used it too until that line was
// reworked into a flat Unstable damage upgrade (2026-10-21).
//
// Exactly one pending blast per owner - a fresh schedule overwrites whatever was pending rather than
// queueing, which is also what stops these accumulating under a fast repeat. That cap is fine because
// no single hero has two lines that schedule one.
component DelayedBlast
{
    FP Remaining;
    FPVector3 Position;
    FP Damage;
    FP Radius;

    // Optional - 0 skips the stun sweep entirely. Routed through StatusEffectUtility.ApplyStun like
    // any other stun, so it respects the generic per-tier hard-CC immunity window.
    FP StunDuration;

    // Whether this counts as a genuine explosion for the systems that care (Pixie's Chain Reaction
    // marking, Direct Hit's proximity bonus, Pocket Bombs). Brute's Earthquake is a shockwave, not an
    // explosion, and leaves both false.
    Boolean IsExplosion;

    // Marks this blast as PROC-GENERATED rather than a fresh player action - the generic source tag
    // that stops a payout blast from re-entering the mechanic that spawned it (see
    // DamageUtility.TryMarkExplodeOnDeath's isChainedExplosion). Only meaningful alongside IsExplosion.
    Boolean IsChainedExplosion;

    // Optional - invalid/default plays the generic blast (EffectsManager.OnWeaponExplosionReleased).
    // Set by Brute's Aftershock rank 3 "Earthquake" so
    // DelayedBlastSystem can fire the same JuggernautEndExploded event the primary blast uses,
    // resolving AftershockSkillAction.BlastEffectPrefab instead of falling back to the generic
    // default blast VFX - see AftershockSkillAction.View.cs.
    AssetRef<AftershockSkillAction> Source;
}
