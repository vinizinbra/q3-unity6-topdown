// Seeded from CharacterData when the component is added, then mutated in place by passives and
// upgrades - same shape as Weapon. Crit is rolled in DamageUtility.ApplyDamage, so it applies to
// every damage path (weapon, projectile, explosion, skill).
component CharacterStats
{
    AssetRef<CharacterData> CharacterData;

    // Offense. DamageMultiplier scales every hit; the two below stack on top of it and apply only
    // to their own DamageSource, which is what lets a gun build and a skill build diverge.
    FP DamageMultiplier;
    FP WeaponDamageMultiplier;
    FP SkillDamageMultiplier;

    // Scales MovementDataAsset's WalkSpeed/RunSpeed in PlayerMovementProcessor - the base speeds
    // are shared across all characters, this is what lets individual heroes diverge.
    FP MoveSpeedMultiplier;

    FP CriticalChance;
    FP CriticalDamageMultiplier;

    FP ElementalChance;

    FP AttackSpeedMultiplier;
    FP ReloadSpeedMultiplier;

    FP ProjectileSpeedMultiplier;
    FP AreaRadiusMultiplier;

    // Attacker-side range falloff - DamageUtility.ResolveRangeDamageMultiplier lerps between these
    // two off the attacker-target distance (Close Quarters/Longshot Rift Mutations). Both default
    // to 1 (no falloff) same as every other multiplier here; picking both Close Quarters and
    // Longshot just partially cancels rather than being blocked outright - no exclusivity system
    // between distinct Rift Mutations, only within one (see RiftMutationPicks).
    FP NearDamageMultiplier;
    FP FarDamageMultiplier;

    // Split rather than one shared CooldownMultiplier (that field never had a real consumer) since
    // Dash and Hero Skill are picked independently at level-up - see StatUtility.GetSkillCooldown.
    FP DashCooldownMultiplier;
    FP SkillCooldownMultiplier;

    // Scales how long a skill's spawned effects last - a decoy, a fire trail. Only applies to
    // DamageSource.Skill, so a weapon-spawned area keeps its authored lifetime.
    FP SkillDurationMultiplier;

    FP KnockbackMultiplier;

    FP LifeSteal;
    FP OutgoingStatusDurationMultiplier;

    // Defense. The two multipliers scale CharacterData's BaseMaxHealth/BaseMaxShield rather than
    // Health/Shield directly - changing one mid-run needs CharacterSystem.RefreshMaxHealth/
    // RefreshMaxShield, since Max is stored on the component, not derived on read.
    FP MaxHealthMultiplier;
    FP MaxShieldMultiplier;

    // Flat additive shield capacity (NOT a multiplier) - folded into CharacterSystem.SeedShield /
    // RefreshMaxShield as BaseMaxShield * MaxShieldMultiplier + BonusMaxShield, so a flat "+10
    // Shield" Global Upgrade (ShieldUpgradeData) survives every later RefreshMaxShield the
    // multiplier path triggers. Defaults to 0; LastBastionMutationData clears it too, since it
    // removes shield outright.
    FP BonusMaxShield;

    FP DamageReduction;
    FP KnockbackTakenMultiplier;
    FP HealingReceivedMultiplier;

    // Utility
    FP PickupRangeMultiplier;
    FP Luck;
    FP ExperienceGainMultiplier;
    FP RiftShardGainMultiplier;
    FP CoinGainMultiplier;

    // Per-player wallets (unlike Experience, which stays a shared Frame.Global total - see
    // Experience.qtn) - a pickup credits every connected player the same base amount, each scaled
    // by their OWN gain multiplier above (CoinUtility.GrantAll/RiftShardUtility.GrantAll), so each
    // player then spends independently (e.g. a Cursed Rift Coin/Rift Shard Offering only affects
    // the interacting player - see docs/breathing-poi.md). Survive death/respawn for free, same as
    // every other CharacterStats field (the entity itself is never destroyed on death).
    FP Coins;
    FP RiftShards;

    // Choose-Weapon talent level - increments once each time this entity actually picks a
    // LevelUpCategory.ChooseWeapon option (see WeaponChoiceUtility.Grant), independent of overall
    // player level. Drives LevelUpUtility.RollWeaponOption's per-slot perk-count roll - see
    // LevelUpConfig.ChancePerLevelPerSlot/MaxRolledPerks. ALSO drives StoreUtility's own weapon
    // offer count (Store buys reuse this exact stat, same "picking a weapon" meaning either way -
    // see docs/store-blacksmith.md), independent of ShopWeaponOfferCount below.
    Byte WeaponTalentLevel;

    // Meta-progression Store talent, seeded once at spawn from RuntimePlayer.Talents (same
    // "carried in from outside this match, never written by the simulation" shape as
    // WeaponTalentLevel/RerollQuantity - see docs/talents.md). StoreUtility.ResolveWeaponOfferCount
    // reads this as Clamp(ShopWeaponOfferCount + 1, 1, StoreConfig.MaxWeaponOfferSlots) - rank 0 ->
    // 1 offer, rank 1 -> 2, rank 2 -> 3. See docs/store-blacksmith.md.
    Byte ShopWeaponOfferCount;

    // How many times this entity can redraw its own current LevelUpChoice.Options in place - see
    // LevelUpUtility.RerollOptionsFor (spends one, called from RerollLevelUpOptionsCommand). NOT a
    // Global Upgrade - seeded once at spawn from RuntimePlayer.Talents.RerollQuantity, a pre-run
    // meta-progression talent (PlayerSpawnUtility.Spawn), same "seeded once, never written by the
    // simulation" shape as WeaponTalentLevel below. Only ever decreases for the rest of a match.
    // Per-character (this component), not shared run-wide.
    Byte RerollQuantity;

    // Meta-progression talent, same "seeded once at spawn from RuntimePlayer.Talents, never
    // written back to it, only decreases" shape as RerollQuantity just above (see docs/talents.md/
    // docs/revive.md). Consumed by ReviveUtility.TryPerformSelfRevive (SelfReviveCommand) - lets a
    // Downed or KO player hold to revive themselves regardless of team composition, independent of
    // any teammate's own SelfReviveCharges.
    Byte SelfReviveCharges;

    // Incremented/decremented by any active effect (e.g. BerserkSkillData) that guarantees Burn
    // on every weapon hit for as long as it's up - a counter rather than a bool so two overlapping
    // grants can't have one's End wipe out the other's still-active one. Checked in
    // StatusEffectUtility.TryApplyElementalStatus, independent of the weapon's own Element and
    // ElementalChance roll - a flat guarantee, not a proc chance.
    Byte BurnOnHitStacks;

    // Rift Mutation reactive fields - all mutation-only (no CharacterData baseline, default to
    // their natural zero/false, same category as BurnOnHitStacks above). See docs/rift-mutations.md.
    //
    // Infinite Momentum: flat Shield (spilling to Health, floored at 1) drained by
    // RiftMutationReactionSystem.OnSkillActivated every time SkillSlotId.DashSkill fires.
    FP DashShieldCost;

    // Critical Focus: flat cooldown seconds refunded on BOTH Hero Skill and Dash by
    // RiftMutationReactionSystem.OnCriticalHit - one merged mutation, not two independent ones
    // (an earlier design split this per-slot; merged since Rift Mutations don't stack).
    FP CritSkillCooldownReduction;

    // Shield Breaker: grants an immediately-usable Dash charge (+1 CurrentStacks, capped at
    // MaxStacks - not a permanent capacity increase) the instant Shield.OnShieldBroken fires - see
    // RiftMutationReactionSystem.OnShieldBroken.
    Boolean ShieldBreakGrantsDashCharge;

    // All or Nothing: read by LevelUpUtility.RollOptionsFor to force a single, rarity-shifted
    // option on this entity's next level-up roll instead of the normal 3.
    Boolean AllOrNothingActive;

    // -- Rift Mark content pool (Weapon Perks live on Weapon, not here - see Weapon.qtn) --
    // All mutation-only flags, same category as the Rift Mutation fields above - see
    // docs/rift-mutations.md for the full roster. Evaluated by RiftMutationMarkUtility (damage-hook
    // mutations), DashSkillData (Rift Dash), and StatusEffectSystem (Fractured Presence).
    Boolean HasCriticalFractureMutation;
    Boolean HasSkillFractureMutation;
    Boolean HasRiftDashMutation;
    Boolean HasHeavyFractureMutation;
    Boolean HasCloseFractureMutation;
    Boolean HasLongFractureMutation;
    Boolean HasExecutionFractureMutation;
    Boolean HasFirstContactMutation;
    Boolean HasFracturedPresenceMutation;
    Boolean HasOverflowingRiftMutation;
    Boolean HasLastStandMutation;

    // Last Stand - per-PLAYER cooldown (not per-target, so it doesn't fit
    // StatusEffects.MarkApplicationCooldowns), ticked in StatusEffectSystem alongside everything
    // else CharacterStats-adjacent.
    FP LastStandCooldownRemaining;
}
