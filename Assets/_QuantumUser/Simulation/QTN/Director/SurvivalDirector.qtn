// Match-wide Survival Director state - merged by the DSL compiler into the same Frame.Global
// struct as Chunk.qtn's global block (kept in its own file since it's conceptually unrelated to
// level generation). Driven entirely by CombatDirectorSystem (SurvivalProgressionUtility.Tick +
// CombatDirectorUtility.TryPulse). RelevantPressure/alive-enemy-count are deliberately NOT cached
// here - both are recomputed each pulse from a plain f.Filter<Enemy, EnemyLifecycle>() pass
// (bounded by MaxAliveEnemies, so tens of entities at most), avoiding a stale-value bug for no
// real performance win at this scale.
global
{
    FP SurvivalTime;
    Int32 CurrentPhaseIndex;
    FP PhaseTimer;

    // Credited by SurvivalPhase.BudgetPerPulse each pulse AND by EnemyLifecycleSystem's refunds on
    // retirement; spent only by CombatDirectorUtility's purchase loop. One shared field, two
    // writers, one reader/spender - no separate refund queue.
    FP DirectorBudget;
    FP DirectorPulseTimer;

    // --- Co-op player-cluster split spawning (see docs/survival-director.md "Player clusters" +
    // PlayerClusterDirectorUtility). DirectorSplitActive is the COMMITTED cohesive<->split mode,
    // hysteresis-debounced by DirectorSplitTimer (DirectorConfig.ClusterSplit/MergeDelay) so it
    // can't flicker at the ClusterDistance boundary. The three scalars are recomputed every combat
    // tick by UpdateRuntimeScalars: SplitThreatMultiplier (>=1, capped by MaxSplitThreatMultiplier)
    // scales DirectorBudget accrual + TargetPressure + MaxAliveEnemies; PerEnemyXpScale/
    // PerEnemyCoinScale (<=1) are applied by CurrencyOrbSystem so the extra enemies splitting spawns
    // don't become an XP/Coin farm. All default to 0 but are written before use each combat tick,
    // and read defensively as 1 if still 0 (pre-first-tick / non-combat states).
    Boolean DirectorSplitActive;
    FP DirectorSplitTimer;
    FP SplitThreatMultiplier;
    FP PerEnemyXpScale;
    FP PerEnemyCoinScale;
}
