// Combat is a normal Director-spawning phase; Breathing turns the entry into a Breathing Break
// instead (see docs/run-phase.md). Was a plain Boolean IsBreathing - promoted to an enum since
// "what kind of phase is this" reads clearer in the Inspector/logs than a bare bool, and left
// room for exactly this: Boss/Elite. Both behave like Combat for SurvivalProgressionUtility.Tick
// purposes (SurvivalTime keeps advancing, only Breathing freezes it - see Tick's own comment) -
// they exist so far purely as a vocabulary/authoring distinction the HUD can key off
// (DirectorTimelineUiWidget shows a phase-specific icon for anything other than Combat), not a
// gameplay behavior change to CombatDirectorSystem/CombatDirectorUtility yet. A real DSL enum (not
// hand-written C#, see SurvivalConfig.cs's own comment) specifically so Global.CurrentPhaseKind
// below can exist - Quantum's asset types (SurvivalPhase.Kind's own declared type) don't need DSL
// declarations, but a Global FIELD of that type does.
enum SurvivalPhaseKind : Byte
{
    Combat,
    Breathing,
    Boss,
    Elite
}

// Match-wide Survival Director state - merged by the DSL compiler into the same Frame.Global
// struct as Chunk.qtn's global block (kept in its own file since it's conceptually unrelated to
// level generation). Driven entirely by CombatDirectorSystem (SurvivalProgressionUtility.Tick +
// CombatDirectorUtility.TryPulse). RelevantPressure/alive-enemy-count are deliberately NOT cached
// here - both are recomputed each pulse from a plain f.Filter<Enemy, EnemyLifecycle>() pass
// (bounded by MaxAliveEnemies, so tens of entities at most), avoiding a stale-value bug for no
// real performance win at this scale.
global
{
    FP SurvivalTime;
    Int32 CurrentPhaseIndex;
    FP PhaseTimer;

    // The current phase's own Kind (Combat/Breathing/Elite/Boss), mirrored here every tick by
    // SurvivalProgressionUtility.Tick purely as a cheap convenience read - avoids BotInputSystem
    // (per-bot, every tick) and View code needing their own SurvivalConfig asset lookup just to
    // answer "is the timeline currently sitting on a Breathing-kind phase boundary" (distinct from
    // Global.CurrentState == GameState.Breathing, which since the Announcer/event-driven-HUD pass
    // only becomes true once BreathingAreaSecured is ALSO true - see GameState.qtn's own comment
    // and CombatDirectorSystem.ResolveDesiredState). Combined with BreathingAreaSecured == false,
    // this is what "the phase has reached Breathing but enemies are still being cleared" means.
    SurvivalPhaseKind CurrentPhaseKind;

    // Reset to false by SurvivalProgressionUtility.Tick the moment CurrentPhaseIndex changes;
    // consumed by CombatDirectorSystem.Update to fire SurvivalPhase.GuaranteedGroup exactly once
    // per phase entry, regardless of Breathing/Traversal Challenge/budget. See SurvivalConfig.cs's
    // own GuaranteedGroup comment.
    Boolean PhaseGuaranteedSpawnDone;

    // Credited by SurvivalPhase.BudgetPerPulse each pulse AND by EnemyLifecycleSystem's refunds on
    // retirement; spent only by CombatDirectorUtility's purchase loop. One shared field, two
    // writers, one reader/spender - no separate refund queue.
    FP DirectorBudget;
    FP DirectorPulseTimer;

    // --- Co-op player-cluster split spawning (see docs/survival-director.md "Player clusters" +
    // PlayerClusterDirectorUtility). DirectorSplitActive is the COMMITTED cohesive<->split mode,
    // hysteresis-debounced by DirectorSplitTimer (DirectorConfig.ClusterSplit/MergeDelay) so it
    // can't flicker at the ClusterDistance boundary. The three scalars are recomputed every combat
    // tick by UpdateRuntimeScalars: SplitThreatMultiplier (>=1, capped by MaxSplitThreatMultiplier)
    // scales DirectorBudget accrual + TargetPressure + MaxAliveEnemies; PerEnemyXpScale/
    // PerEnemyCoinScale (<=1) are applied by CurrencyOrbSystem so the extra enemies splitting spawns
    // don't become an XP/Coin farm. All default to 0 but are written before use each combat tick,
    // and read defensively as 1 if still 0 (pre-first-tick / non-combat states).
    Boolean DirectorSplitActive;
    FP DirectorSplitTimer;
    FP SplitThreatMultiplier;
    FP PerEnemyXpScale;
    FP PerEnemyCoinScale;
}
