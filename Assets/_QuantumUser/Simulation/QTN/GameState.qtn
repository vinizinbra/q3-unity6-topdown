// Structured top-level match-flow state machine. Lobby is deliberately enum value 0 (Global
// starts zeroed, so a fresh match begins there with no explicit seeding needed).
enum GameState : Byte
{
    Lobby,      // Pre-run: players spawn, walk out of the LobbyStart chunk's own footprint (see
                // LobbyBoundarySystem). CombatDirectorSystem stays idle (SurvivalTime/enemy
                // spawning paused) but GameplaySystemGroup itself is NOT paused - players must be
                // able to move to ever leave the lobby.

    Survival,   // Normal run: SurvivalTime counts, the Survival Director spawns enemies (see
                // CombatDirectorSystem/docs/survival-director.md). The only state that gate runs in.

    Upgrade,    // A level-up/Chest upgrade-choice screen is open (Global.LevelUpScreenOpen) -
                // GameplaySystemGroup itself is disabled (LevelUpUtility.OpenUpgradeScreen/
                // Resolve, unchanged mechanism), which also freezes CombatDirectorSystem for free
                // since it lives inside that group. Always returns to whichever state it
                // interrupted (Global.PreUpgradeState) - not hardcoded to Survival, since a
                // talent-granted Chest can be opened while still in Lobby.

    Event,      // Scaffolded only - mirrors RuntimePlayer.HasEvent (also scaffolded, see
                // docs/talents.md). No Event system exists yet, so nothing transitions into or
                // out of this today.

    Boss,       // Entered the instant a Kind == Boss SurvivalPhase begins (see
                // CombatDirectorSystem.ApplyPhaseGameState) - RunPhaseUtility.BeginBossEncounter
                // teleports players/seals the arena/spawns the boss(es), then briefly disables
                // GameplaySystemGroup itself for Global.BossPauseTimer seconds (see below) so the
                // Boss Window reveal plays with everything frozen, before play resumes.

    Breathing,  // A repeating Breathing Break between Survival segments (see docs/run-phase.md) -
                // just another entry in SurvivalConfig.Phases[] (SurvivalPhase.Kind),
                // detected by CombatDirectorSystem/SurvivalProgressionUtility, the same place
                // that already walks that same Phases[] timeline for Survival. Enemy spawning
                // stays paused for free via that system's own CurrentState != Survival &&
                // != Breathing gate on the Director-pulse half only, same as Lobby, but
                // GameplaySystemGroup itself is NOT disabled - players must stay fully
                // controllable to explore/use Breathing-only POIs (Healing Shrine, Cursed Rift).

    RunFailed,  // Fired once by RunFailureSystem the instant every connected player is
                // simultaneously Downed/KO AND every one of them has 0 SelfReviveCharges left (see
                // docs/revive.md). GameplaySystemGroup is deliberately NOT disabled here. Consumed
                // by RunResultManager (View) to show the end-of-run Lose popup.

    Victory,    // Fired once by VictorySystem the instant the boss on the LAST authored
                // SurvivalConfig.Phases[] entry actually dies (BossRuntimeState filter goes
                // empty) - nothing else ever transitions CurrentState out of Boss (CombatDirector
                // System's own Update gate excludes it entirely once entered), so this is the one
                // place that closes that loop. GameplaySystemGroup is deliberately NOT disabled
                // here, same as RunFailed. Consumed by RunResultManager (View) to show the
                // end-of-run Win popup.

    TeamChallenge,      // An overlay on top of whatever Global.CombatPhaseState actually is
                        // (almost always Survival, but can also be Breathing) - entered the
                        // instant CombatDirectorSystem.ApplyEffectiveState sees
                        // TeamChallengeUtility.AnyBannerActive(f) == true (Starting or
                        // ChallengeActive), cleared the instant it isn't. GameplaySystemGroup
                        // stays fully enabled; only Director purchases pause
                        // (Global.ActiveTeamChallengeCount, unchanged). See
                        // docs/optional-team-challenge.md.

    TraversalChallenge  // Same overlay shape as TeamChallenge above, entered while
                        // Global.ActiveTraversalChallengeCount > 0. See docs/traversal-challenge.md.
}

// Resolution order CombatDirectorSystem.ApplyEffectiveState uses when more than one of the above
// could apply at once (most specific/urgent wins): Boss > TeamChallenge > TraversalChallenge >
// whatever Global.CombatPhaseState actually is - Boss always wins since nothing else can be
// meaningfully showing during a hard-paused boss reveal; TeamChallenge is placed ahead of
// TraversalChallenge only because the two aren't expected to ever overlap in practice, not for any
// deeper reason. This used to be a separate HudBannerKind/Global.HudBanner field, deliberately kept
// out of GameState because GameState gates real simulation behavior (PoiAvailabilityUtility,
// CombatDirectorSystem's own spawn gate, GameplaySystemGroup disables, ...) that a Traversal/Team
// Challenge must not disturb elsewhere in the level. Folded into GameState anyway (confirmed with
// the user) so the 5 top-screen HUD widgets can react to the real GameStateChanged event instead of
// each independently polling a separate field every tick - see Global.CombatPhaseState below for
// how the real simulation-gating concerns are still kept safe.

global
{
    // The effective, presentation-facing state - what every HUD widget and every OTHER GameState
    // consumer (PoiAvailabilityUtility, etc.) should read. Boss/TeamChallenge/TraversalChallenge
    // resolution happens here (CombatDirectorSystem.ApplyEffectiveState); Lobby/Upgrade/RunFailed/
    // Victory are written directly by their own owning systems, unaffected by any overlay.
    GameState CurrentState;

    // The REAL Survival Director phase - Survival/Breathing/Boss only, immune to any
    // TeamChallenge/TraversalChallenge overlay. Written exclusively by
    // CombatDirectorSystem.ApplyPhaseGameState, whose own one-shot-transition side effects
    // (CancelUncommittedCursedRiftInteractions/CloseStoreInteractionsOnBreathingEnd/
    // CloseBlacksmithInteractionsOnBreathingEnd/BreathingIndex++/BeginBossEncounter) are gated on
    // THIS field, not CurrentState - otherwise a Team/Traversal Challenge starting or ending mid-
    // Breathing would spuriously refire them even though the real phase never left Breathing.
    // Read CurrentState for everything else; this field exists only for that one internal compare
    // plus BotInputSystem's own Breathing-shop check, which needs the real phase regardless of any
    // challenge overlay elsewhere in the level.
    GameState CombatPhaseState;

    // Set by LevelUpUtility.OpenUpgradeScreen right before switching CurrentState to Upgrade,
    // read back by Resolve to restore exactly the state that was interrupted - see GameState.
    // Upgrade's own comment above for why this can't just hardcode Survival.
    GameState PreUpgradeState;

    // Seconds left in the current Breathing Break - only meaningful while CurrentState ==
    // Breathing, maintained by CombatDirectorSystem as the current SurvivalPhase's own Duration
    // minus PhaseTimer. See docs/run-phase.md.
    FP BreathingTimeRemaining;

    // How many Breathing Breaks have completed this run so far (0-based, incremented by
    // CombatDirectorSystem the instant a Breathing phase ends) - the reset key
    // PoiUsagePolicy.OncePerPlayerPerBreak compares against (see Poi.qtn).
    Int32 BreathingIndex;

    // True only while CurrentState == Breathing AND every currently-alive enemy is gone (killed or
    // naturally expired via EnemyLifecycle) - maintained every tick by SurvivalProgressionUtility.
    // Tick off the same IsEncounterCleared check Elite/Boss phases already use, just applied to
    // Breathing too (see docs/run-phase.md). Spawning stops and SurvivalTime freezes the INSTANT
    // Breathing begins regardless of this flag, but PhaseTimer - and therefore
    // BreathingTimeRemaining/the Break actually ending - only starts advancing once this is true:
    // the area isn't "secured" just because the phase boundary was crossed, only once nothing
    // hostile is left. Read by BreathingCountdownWidget to gate the "AREA SECURED" banner/countdown/
    // skip-vote UI the same way.
    Boolean BreathingAreaSecured;

    // Counts down from CurrencyOrbVacuumUtility.Duration (1s) to 0 the instant
    // BreathingAreaSecured flips true - while > 0, CurrencyOrbVacuumUtility.Tick is actively
    // sweeping every leftover CurrencyOrb (XP/Coin/Rift Shard) to its nearest player, spread evenly
    // across whatever's left of this window rather than all in the same tick. Also held by
    // DebugCheatSystem.TryOpenNextPendingLevelUp as one more precondition (same idiom as its own
    // GameState.Boss gate) - a level-up screen earned mid-sweep is deliberately held, not
    // discarded, until every orb has actually finished landing. See docs/experience-drops.md.
    FP OrbVacuumTimeRemaining;

    // Counts down to 0 while GameplaySystemGroup is deliberately disabled right after
    // RunPhaseUtility.BeginBossEncounter spawns the boss(es) - ticked by the new always-on
    // BossPauseSystem (must live OUTSIDE that group, same reasoning LevelUpSystem's own header
    // comment already documents, since it's what re-enables the group once this hits 0). Seeded
    // from the current SurvivalPhase's own PauseDuration - <= 0 means no pause is in progress.
    FP BossPauseTimer;

    // True only while a Breathing phase's own Duration has elapsed (and the area is Encounter-
    // cleared) but at least one connected player still has a Cursed Rift/Store/Blacksmith Choice
    // Window open - RunPhaseUtility.TickBreathingGraceHold holds the phase transition open instead
    // of instantly force-closing that window, for up to SurvivalPhase.GracePeriodDuration seconds
    // (BreathingGraceTimeRemaining, below) or until every open window closes, whichever comes
    // first. PoiInteractionLockUtility.IsInputLocked reads this to fully lock (movement/weapon/
    // skill) every player who does NOT themselves have a window open, so nobody can wander off
    // while a teammate finishes. See docs/run-phase.md.
    Boolean BreathingGraceActive;

    // Seconds left in the current grace hold - only meaningful while BreathingGraceActive is true.
    FP BreathingGraceTimeRemaining;
}

// Per-player vote to end the CURRENT Breathing Break early (see docs/run-phase.md) - lazily added
// the first time a player sends SkipBreathingCommand, never pre-seeded at spawn, so "has this
// player voted" is checked via TryGetPointer (component presence), not just the field's own
// value - a never-voted player has no component at all, avoiding a false-positive match against
// BreathingIndex's own default-0 value on the very first Break of a run. VotedAtBreathingIndex is
// compared against Global.BreathingIndex - same self-cleaning "which iteration did this happen"
// convention PoiUsageEntry.UsedAtBreathingIndex already uses (Poi.qtn), so a stale vote from an
// earlier Break never silently counts toward the next one; no explicit clear-all-votes step needed.
component BreathingSkipVote
{
    Int32 VotedAtBreathingIndex;
}
