component Projectile
{
    FPVector3 Velocity;

    // Where this shot actually left from, kept for the VIEW's benefit only - nothing in the
    // simulation reads it back. A projectile's view is created on the frame the entity first
    // appears in Frames.Predicted, which for anything fired by a remote player is several ticks
    // after the shot really happened (this client only learns about the input later, rolls back and
    // resimulates - by the time the view exists the bullet is already meters downrange).
    // ProjectileView puts its visual back here on spawn and lets it catch up, so a shot reads as
    // leaving the barrel instead of popping into existence halfway to the target.
    FPVector3 SpawnPosition;

    FP        Damage;
    FP        RemainingLifetime;
    EntityRef Owner;

    AssetRef<ProjectileDataAsset> ProjectileData;
    Int32 RemainingPierces;

    // -- Weapon-perk fields (Ricochet/Long Barrel/Explosive Sequence/Cataclysm Round) --
    // All seeded at spawn time from the firing Weapon's own baked stats (see
    // WeaponSystem.FireProjectile) - zero/false for anything not fired by a weapon perk (enemy
    // attacks, skills), so they never affect a projectile that didn't opt in. MaxDistanceMultiplier
    // is the one exception: a component defaults to 0, but "no Long Barrel perk" has to read as "no
    // range change" (x1), not "always expires at distance 0" - ProjectileSystem.TryExpire treats
    // <= 0 as 1 rather than the literal value, same convention as Weapon.RangeMultiplier itself
    // being seeded to 1 (not left at 0) in WeaponSystem.SeedStats.
    Int32   RemainingBounces;
    FP      MaxDistanceMultiplier;
    Boolean IsExplosiveProc;
    Boolean IsCataclysm;

    // Forces this shot's crit roll outright (Burst Rifle's 3rd-shot-always-crits) - stamped in
    // WeaponSystem.ApplyProjectilePerks from a forceCritical param threaded down from FireShot, read
    // via HitEffectContext.ForceCritical (ProjectileHitData.ApplyEffects) into
    // DamageUtility.ResolveOutgoingDamage. False (default) leaves crit resolution untouched for
    // everything that isn't a forced-crit shot.
    Boolean ForceCritical;

    // Captured at fire time and carried to impact - the shooter holds both a weapon and skills, so
    // it can't be asked which one launched this.
    DamageSource Source;

    // Captured at fire time from WeaponDataAsset.Element, carried to impact for
    // StatusEffectUtility.TryApplyElementalStatus to roll against - enemy attacks have no Element
    // concept, so this stays Neutral for anything not fired by WeaponSystem.
    ElementType Element;

    // The firing weapon's own asset, captured at fire time (WeaponSystem/WeaponPerkReactionSystem/
    // WeaponPerkUtility/DirectHitData each seed it through ProjectileSpawner.Spawn's weaponData param,
    // same as Element above) rather than re-resolved off Owner's live Weapon later - the owner may
    // have swapped weapons by the time this shot lands, and re-reading their CURRENT weapon would
    // silently reattribute a stale shot's config to the wrong one. Invalid for anything not fired by a
    // Weapon (a skill, an enemy attack, Kai's Ghost Shot echo) - Source distinguishes those, not this.
    // Read only by the VIEW (WeaponDataAsset.View's sprite/particle config) - nothing in the
    // simulation itself reads this back.
    AssetRef<WeaponDataAsset> WeaponData;

    // The EXTRA element grafted on by an Element Infusion weapon perk (WeaponElementInfusion),
    // seeded at spawn in WeaponSystem.ApplyProjectilePerks and applied at impact via
    // StatusEffectUtility.TryApplyInfusedElement rolling PerkElementChance - independent of Element
    // above (a weapon can land both). Neutral/0 for anything without the perk, so it no-ops for free.
    ElementType PerkElement;
    FP          PerkElementChance;

    // None unless a skill fired this (weapons/enemy attacks leave it None) - lets ProjectileSystem
    // clear the firing SkillSlot's ProjectilePending on termination without an EntityRef back to it.
    SkillSlotId SourceSlot;

    // Locked at fire time, re-read every tick rather than a one-shot aim point - only meaningful to
    // a movement that re-aims over time (HomingProjectileMovementData); anything else ignores it.
    // None for a free-aimed shot with nothing locked.
    EntityRef Target;

    // Counts down from ProjectileDataAsset.SpawnDelay before ProjectileSystem starts moving/aging
    // this projectile - a windup/telegraph where it exists but sits inert first.
    FP RemainingSpawnDelay;

    // Set once a hit settles this instead of detonating it - see AreaHitData.DetonateOnLevelGeometry.
    // ThrownProjectileMovementData stops re-applying gravity once this is true, so a grounded bomb
    // sits still while it waits out its fuse instead of sinking through the floor.
    Boolean Grounded;

    // 0 for anything fired directly (a throw, a weapon shot); N+1 for whatever a depth-N
    // detonation's own spawn-upgrades (Fireworks/ClusterBomb) spawned - see
    // AreaHitData.MaxSpawnUpgradeDepth. A hard ceiling independent of any one asset's
    // TriggersSpawnUpgrades authoring, so a misconfigured or self-referencing cluster bomblet
    // prototype still can't cascade more than one generation deep.
    Byte SpawnDepth;

    // Running total of ground actually covered, summed from each tick's real moveDelta - checked
    // against MaxTravelDistance (or, absent that, ProjectileDataAsset.MaxDistance) in
    // ProjectileSystem.TryExpire. Explicit rather than inferring "distance" from Lifetime and an
    // assumed constant speed, so it stays correct even if something changes a projectile's speed
    // mid-flight.
    FP TraveledDistance;

    // An absolute world-unit cap seeded from the firing Weapon's own engagement range
    // (WeaponPerkUtility.ResolveProjectileMaxTravelDistance - WeaponDataAsset.Range *
    // Weapon.RangeMultiplier, the same distance FireHitscan already limits a raycast to, padded per
    // ProjectileMovementData.ResolveMaxTravelDistance for a movement whose real flight path covers
    // more ground than that flat distance, e.g. an arc) by every weapon-fire spawn site -
    // WeaponSystem.ApplyProjectilePerks (primary shot, Double Tap's replay, Echo Chamber/Infinite
    // Echo), WeaponPerkReactionSystem.TryFireCriticalRebound, and DirectHitData.
    // SpawnSplitProjectiles - so a shotgun with Range 6 can't have any weapon-fired projectile,
    // including one spawned mid-flight by another perk, outrun that same 6 units (padded first for an
    // arc, so it still finishes its descent). <= 0 (the default - an enemy attack, a skill, anything
    // not fired by a Weapon) means "no weapon-driven cap", falling back to ProjectileDataAsset.
    // MaxDistance * MaxDistanceMultiplier exactly as before this existed.
    FP MaxTravelDistance;

    // Which pellet of a fanned volley this is (0 for anything not fanned - a single-shot weapon, a
    // skill, an enemy attack) - carried through HitEffectContext.HitIndex to DamageUtility.
    // ApplyDamage so pellets landing on one stationary target in the same tick stay distinct events
    // instead of hash-colliding and getting silently dropped by Quantum's per-tick event dedup. See
    // WeaponSystem.FireProjectile/ProjectileSpawner.Spawn and Events.qtn's EntityDamaged.HitIndex.
    Byte PelletIndex;

    // Live multiplier on this tick's actual displacement (Velocity itself is never touched) - reset
    // to 1 and recomputed every tick by VoidFieldSystem for an enemy-owned projectile currently
    // inside a ProjectileSlowField, so leaving every field instantly restores normal speed with
    // nothing to revert. 1 for anything not affected (every projectile not near a field, or any
    // player-owned one - Kai's field only ever slows enemy fire).
    FP SpeedMultiplier;

    // Generic per-entity override of ProjectileDataAsset.Movement, preferred every tick by
    // ProjectileSystem.Update over the asset's own Movement. Kai's Mirror Step (MirrorStepSkillAction)
    // is the current user - it writes this directly onto an already-live projectile mid-flight (not at
    // spawn) to curve a reflected bolt in on its shooter via HomingProjectileMovementData. Invalid (the
    // default) for every projectile nothing has touched, which is every projectile by default.
    AssetRef<ProjectileMovementData> MovementOverride;

    // Every entity this shot has actually hit so far (pierced through, or bounced off of) - lets a
    // Ricochet redirect PREFER a target it hasn't already hit over one it has, instead of only ever
    // excluding the single most-recently-hit entity (see DirectHitData.TryRicochet's own `exclude`
    // param), which let a 2+-bounce chain ping-pong back onto an enemy it already hit two bounces
    // ago. EntityRef.None is the empty-slot sentinel - a shot with fewer hits than slots just has
    // trailing Nones, skipped by WeaponPerkUtility.TryFindNearestUnhitEnemy's own scan. Sized well
    // above any realistic Pierce+Bounce total; a shot that somehow fills every slot just stops
    // recording further hits (silently, no error) rather than needing a ring buffer for an edge
    // case that shouldn't come up in practice.
    array<EntityRef>[8] RecentHits;

    // Per-shot override of ProjectileDataAsset.Hit, same shape/reasoning as MovementOverride above -
    // resolved once at spawn and preferred every tick by ProjectileSystem over the asset's own Hit.
    // Kai's Ghost Shot (Neutral Mastery R3, see DamageEchoSystem.SpawnEchoProjectile) is the first
    // user: it spawns using the OWNER'S CURRENTLY EQUIPPED weapon's own ProjectileDataAsset (so the
    // echo looks and flies exactly like a normal shot from whatever weapon Kai is holding - same
    // Prototype, same Movement) but overrides just the Hit to EchoHitData, so the echo still only
    // ever delivers its own pre-resolved damage with no re-triggering of that weapon's normal Effects/
    // elemental status/procs and no risk of scheduling another echo. Invalid (the default) for every
    // projectile not fired through that override path, which is every existing spawn site unchanged.
    AssetRef<ProjectileHitData> HitOverride;
}
