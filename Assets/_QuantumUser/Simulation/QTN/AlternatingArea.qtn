// Drives AreaDamage through two alternating pulse configs instead of one fixed one - see
// AlternatingAreaSystem, which runs right before AreaDamageSystem and swaps AreaDamage's
// Damage/TargetMask/Effects into whichever phase is about to fire. One shared
// AreaDamage.TickInterval drives both the pulse rate and the swap: pulse 1 damages, pulse 2 heals,
// pulse 3 damages, and so on (CurrentlyHealing seeded true at spawn so the first flip resolves to
// Damage, not Healing - see SpawnAlternatingAreaEffectData/PortableSpeakerSkillAction) - no separate
// phase-duration to keep in sync.
//
// Every field below (and AreaDamage.TickInterval) is overwritten at spawn by
// SpawnAlternatingAreaEffectData - see its own comment for why the numbers live there, on the
// skill's own asset chain, instead of authored here. Whatever's set on the prototype in the
// Inspector is inert placeholder, never actually read.
component AlternatingArea
{
    Boolean CurrentlyHealing;

    DamageTargetMask HealTargetMask;
    array<AssetRef<HitEffectData>>[4] HealEffects;

    // Seeds AreaDamage.Damage during a heal pulse, mirroring DamageAmount below - a heal percent
    // (of the target's own MaxHealth), read by ScaledHealEffectData via HitEffectContext.Damage. Was
    // unused (heal pulses always got AreaDamage.Damage = 0) before Healing Chorus needed a baked,
    // ranked heal magnitude the same shape Amplifier already has on the damage side.
    FP HealAmount;

    FP DamageAmount;

    // Generic per-pulse effectiveness scalar applied to BOTH HealAmount and DamageAmount at the moment
    // a beat fires (see AlternatingAreaSystem). 1 = unchanged, and every spawn path that doesn't touch
    // it gets exactly that.
    //
    // Exists so an owner's LIVE state can scale an already-deployed area without the area having to be
    // respawned, and without this generic system knowing anything about who is scaling it or why.
    // Zara's Headliner rank 2 is the first consumer: it rewrites this on her own areas when her Flow
    // crosses into or out of Max (see ZaraFlowUtility.RefreshOwnedAreaEffectiveness) rather than being
    // baked at deploy time, so a Totem planted before she hit Max Flow still benefits.
    FP EffectivenessMultiplier;
    DamageTargetMask DamageMask;
    array<AssetRef<HitEffectData>>[4] DamageEffects;

    // Counts damage pulses only (heal pulses don't touch this) - see
    // AlternatingAreaSystem.TryApplyBassDropStun, which checks this against Amplifier's own
    // AmplifierUpgrade.StunInterval every damage pulse. Never resets; "every Nth" just reads off
    // the running total modulo Interval.
    Byte DamagePulseCount;
}
