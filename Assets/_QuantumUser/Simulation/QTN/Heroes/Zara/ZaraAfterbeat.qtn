// Dash Ascension (Afterbeat, ranked) - added by AfterbeatSkillAction.Begin/End when Zara's dash
// starts/ends, ticked down by ZaraAfterbeatSystem. Stores both delayed pulses' own position/damage/
// radius/knockback directly on Zara's own entity rather than spawning marker entities - simpler than
// the other heroes' "needs a standalone EntityPrototype authored by hand" dash ascensions (Kai's
// SlowArea, Lux's Decoy Beacon, Brute's Barricade, Pixie's Bombs Away), since this needs no physical/
// visual representation of its own, just two independent countdowns. Two named slots (Start/End)
// rather than an array - rank 3 "Double Beat" needs exactly Start (from Begin) and End (from End)
// live at once, never more, and a second dash before either fires simply overwrites the pending one
// (only the most recent dash's own pulses ever land).
component ZaraAfterbeat
{
    FP StartRemaining;
    FPVector3 StartPosition;
    FP StartDamage;
    FP StartRadius;
    FP StartKnockbackForce;

    FP EndRemaining;
    FPVector3 EndPosition;
    FP EndDamage;
    FP EndRadius;
    FP EndKnockbackForce;

    // Resonance generated by enemies HIT (rank 1: swept through by the dash itself; rank 3: caught by
    // either delayed pulse - see ZaraAfterbeatSystem.Fire). One shared per-dash allowance covers both
    // sources, which is what keeps a dash through a dense pack from filling the whole bar; it resets
    // on every dash Begin. 0 ResonancePerEnemyHit grants nothing beyond the flat on-dash amount.
    FP ResonancePerEnemyHit;
    FP MaxResonancePerDash;
    FP ResonanceGrantedThisDash;

    // Rank 1's dash-sweep dedupe - an enemy the dash passes through should pay out once per dash, not
    // once per tick it stays inside the sweep radius. Same fixed-capacity "already-affected this
    // activation" array idiom Brute's IronShoulderHitTracker/Max's VendettaStrikeHitTracker use
    // (Quantum's qtn DSL has no set type); once full, a further new enemy simply isn't deduped, an
    // accepted limitation rather than a silent bug. Reset on every dash Begin.
    array<EntityRef>[8] SweptEnemies;
    Byte SweptCount;
}
