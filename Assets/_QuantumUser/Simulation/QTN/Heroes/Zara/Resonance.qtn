// Zara's Resonance passive - added directly onto her own entity by ResonancePassiveData (same
// "field lives on the hero" shape Kai's ProjectileSlowField/Brute's ProtectorAura already use).
// Builds purely from dealing damage (see ResonanceUtility.OnDamageDealt, hooked into
// DamageUtility.ApplyDamage) - no decay, since nothing in the design calls for it to drain back
// down. Once Current reaches Max, ResonanceUtility.FirePulse heals nearby
// allies and damages nearby enemies in one simultaneous burst, then Current wraps back down
// (carrying any remainder rather than dropping it to 0).
// One pool entry for the Remix ascension (see RemixPassiveUpgradeData/ZaraRemixUtility) - a status
// effect plus its own rank-2 "strengthened" multipliers, so Remix's own code never needs to know
// which concrete HitEffectData it drew; each effect's own 4-arg Apply(Frame, ref HitEffectContext,
// FP, FP) override decides what duration/magnitude scaling means for its own kind (see
// BurnEffectData/SlowEffectData/StunEffectData/RiftMarkEffectData).
struct RemixPoolEntry
{
    AssetRef<HitEffectData> Effect;
    FP Rank2DurationMultiplier;
    FP Rank2MagnitudeMultiplier;
}

component Resonance
{
    FP Current;
    FP Max;

    // Resonance generated per point of damage dealt - the Faster Tempo ascension raises this.
    FP GenerationPerDamage;

    FP Radius;
    FP HealPercent;
    FP DamageAmount;

    // Every pulse is a shockwave from the base passive onward (see ResonancePassiveData) - the
    // Heavy Bass ascension raises this by one tier (capped at Strong) rather than being the only
    // source of knockback. Raw KnockbackTier ordinal (Byte), not the enum itself - KnockbackTier is
    // a plain C# enum (EffectConfig.cs), never declared through the qtn DSL the way every other enum
    // used as a component field here is, so the codegen can't resolve it directly as a field type -
    // same reasoning/cast-at-every-site fix as MarkExplosiveDeath.MaxAffectedTier. Force/UpwardForce
    // for a given tier are read from the shared RuntimeConfig.EffectConfig (see
    // EffectConfig.GetKnockback), the exact same table every KnockbackEffectData hit effect already
    // reads, so Zara's shockwave pushes exactly as hard as everything else on a given tier.
    Byte KnockbackTier;

    // Counts pulses fired so far - never resets. The Remix ascension reads this modulo 3.
    Byte PulseCount;

    // Faster Tempo rank 3 "Never Stop" - fraction of Max retained instead of fully wrapping to 0
    // when a pulse fires (see ResonanceUtility.AddResonance). 0 (every other rank/unpicked) fully
    // wraps, same as before this field existed.
    FP RetainFraction;

    // -- Protective Rhythm (Passive line 2/3) --
    // Zara's defensive support path, deliberately NOT more HP healing: the Pulse grants allies a
    // temporary Overshield and (rank 2+) a brief damage reduction. Both 0 (unpicked) grant nothing,
    // so the base Pulse stays a plain heal + damage + shockwave.
    //
    // OvershieldPercentOfMaxShield is a fraction of the ALLY's own Max Shield, so it scales to
    // whoever it lands on rather than needing per-hero tuning. DamageReduction routes through the
    // shared REACTIVE damage-reduction slot (StatusEffectUtility.ApplyTemporaryDamageReduction), the
    // same one Brute's Guardian rank 3 and Bodyguard rank 3 use - so the codebase's generic
    // take-the-stronger policy arbitrates a co-op stack instead of three sources adding up.
    FP OvershieldPercentOfMaxShield;
    FP OvershieldCapMultiplier;
    FP DamageReductionAmount;
    FP DamageReductionDuration;

    // Remix rank 2 - fraction of Max retained specifically AFTER a Remix pulse (as opposed to
    // RetainFraction above, which Faster Tempo rank 3 applies to EVERY pulse). Resolution when a
    // build holds both is explicitly TAKE-THE-MAXIMUM, not additive: ResonanceUtility.AddResonance
    // applies RetainFraction's floor first, then FirePulse raises it to this one on a Remix pulse if
    // it happens to be higher. Documented here because "avoid accidental double-retention" is a
    // stated requirement - there is exactly one floor, never two stacked.
    FP RemixRetainFraction;

    // Remix ascension's own rank, 0 = not picked. Separate from reading RemixPool's own occupancy so
    // "picked but every pool slot happens to be empty" and "never picked" stay distinguishable if
    // that ever matters, and so ZaraRemixUtility can gate rank-2/3 behavior with a plain number
    // instead of re-deriving it from UpgradeHistory.
    Byte RemixRank;

    // Remix ascension's authored pool - every third pulse applies 1 (rank 1-2) or 2 distinct (rank
    // 3) randomly-chosen entries from here to every enemy the pulse damages (see
    // ResonanceUtility.FirePulse/ZaraRemixUtility). Filled contiguously from index 0 by
    // RemixPassiveUpgradeData.Apply; every slot empty (the base passive's default) means the
    // ascension hasn't been taken, so every third pulse does nothing extra.
    array<RemixPoolEntry>[5] RemixPool;
}
