// Passive Ascension (Heavy Bass rank 3 "Subwoofer") - added by ResonanceUtility.FirePulse directly
// onto Zara's own entity when Resonance.SubwooferDamagePercent > 0, ticked down by
// ZaraSubwooferPulseSystem, same "countdown component ticked by its own tiny System" shape
// ZaraAfterbeat/ZaraAfterbeatSystem already use for Afterbeat's own delayed pulses.
component ZaraSubwooferPulse
{
    FP Remaining;
    FPVector3 Position;
    FP Damage;
    FP Radius;
    FP KnockbackForce;
}
