// Kai's Undertow Ascension (Passive line 2/3) - see docs/kai-ascensions.md. A weapon hit on an enemy
// (OnWeaponHitLanded) starts/refreshes a continuous pull dragging that enemy toward whichever OTHER
// enemy is currently nearest to it, exactly like VortexSystem's own pull (DamageUtility.ApplyPull,
// recomputed every tick against a live target rather than a fixed point) - just retargeted per-victim
// instead of toward one shared vortex center. Refresh-only (KaiUndertowSystem.OnWeaponHitLanded just
// resets Remaining), same idiom VoidFieldSystem.EnemyRefreshDuration already uses, so it decays on its
// own the instant the target stops getting hit rather than needing removal logic.
component UndertowUpgrade
{
    FP PullForce;
    FP PullDuration;

    // Rank 2 "improved effectiveness against heavier enemy types" - multiplies pull.Force when the
    // target's own EnemyTier is Specialist or above. 1.0 (no bonus) at rank 1.
    FP HeavyTierMultiplier;

    // Rank 3 "Gravitational Bond" - 0 at ranks 1-2 (no Bound applied at all). When >0, every landed
    // pull also calls StatusEffectUtility.ApplyBound(f, target, BoundDuration).
    FP BoundDuration;

    // Rank 3 only (0 at ranks 1-2) - bonus damage Kai deals to any Bound enemy, read in
    // DamageUtility.ResolveOutgoingDamage. Not per-source (any Kai with this upgrade benefits from any
    // Bound enemy) - Bound is a status on the enemy like Stun/Intimidate, not an attribution-scoped
    // mark.
    FP BoundDamageBonus;
}

// Added to (and removed from, once Remaining hits 0) the struck enemy itself by KaiUndertowSystem -
// not on Kai's own entity, since each victim pulls independently toward its own nearest neighbour.
// Force is baked from UndertowUpgrade.PullForce (already Heavy-Tier-scaled) at grant/refresh time
// rather than looked up from the (possibly long-gone-by-then) owner every tick.
component UndertowPull
{
    FP Remaining;
    FP Force;

    // Baked from UndertowUpgrade.BoundDuration at grant/refresh time (0 at ranks 1-2) - applied via
    // StatusEffectUtility.ApplyBound every tick the pull actually lands on a target (see
    // KaiUndertowSystem.TickUndertowPulls), not just once at grant.
    FP BoundDuration;

    // View-only data - the OTHER enemy this one is currently being dragged toward, refreshed every
    // tick alongside the pull itself. Simulation only authors this; KaiUndertowLinksView polls it every
    // frame to draw the tether line - see that class for the actual rendering. Remaining (already
    // ~0.2s at rank 1) doubles as the visual's own lifetime, no separate duration field needed.
    EntityRef LinkTarget;

    // Optional style identifier for the view (spec's own ask) - defaulted 0, authorable per rank
    // later if a visual variant is ever wanted. Not read by any simulation logic.
    Byte StyleId;
}
