// Pixie's "Demolition Mastery" Hero Traits - a themed batch of 4 ordinary Passive Upgrades (Direct
// Hit/Concussive Force/Volatile Payload/Mini Ordnance), all reacting to ANY of Pixie's explosions
// (Bunny Bomb, dash bombs, explosive weapons) rather than one specific mechanic - see
// DemolitionMasteryUtility.cs/PixieDemolitionMasterySystem.cs and the new
// OnExplosionCriticalHit/OnAreaExplosionDetonated signals in Combat.qtn.
//
// Mini Ordnance is deliberately NOT named/shaped like ClusterBombUpgrade (see Heroes/Pixie/
// ClusterBombSkillAction.cs) - that's a different, pre-existing Hero Skill Upgrade (deterministic
// Projectile-based bomblet count from Bunny Bomb specifically) and must not be confused with or
// touched by this trait, which is a chance-based Mini Bomb drop from any qualifying explosion.

// Direct Hit - a binary "inner zone" bonus: within InnerRadiusFraction of an explosion's own
// radius, damage is multiplied by 1 + DamageMultiplierBonus. Read live in
// DemolitionMasteryUtility.ApplyProximityEffects, never baked into CharacterStats.
component DirectHitUpgrade
{
    FP InnerRadiusFraction;
    FP DamageMultiplierBonus;
}

// Concussive Force - an arcade-style knockback falloff: full Force out to InnerRadiusFraction of
// the blast radius (a generous sweet spot, not a pinpoint), then a linear taper to 0 at the edge -
// see DemolitionMasteryUtility.ApplyProximityEffects. EliteMultiplier further scales the result
// against Elite-tier enemies (<1, reduced effect); Bosses need no dedicated handling here at all -
// TierStats.CanBeInterruptedByKnockback/KnockbackMultiplier already resist the displacement itself,
// and BossRuntimeState.StaggerMeter already accumulates from any damage taken regardless of source.
component ConcussiveForceUpgrade
{
    FP InnerRadiusFraction;
    FP Force;
    FP UpwardForce;
    FP EliteMultiplier;
}

// Volatile Payload - a critical hit that is ALSO an explosion (see OnExplosionCriticalHit, fired
// from DamageUtility.ApplyDamage only when both isCritical and isExplosion are true) applies Burn
// to the target it crit. BurnIntensity is a flat damage-per-tick value, same convention
// StatusSpreadOnDeath.BurnIntensity already uses - not a percent-of-hit scale.
component VolatilePayloadUpgrade
{
    FP BurnDuration;
    FP BurnIntensity;
}

// Mini Ordnance (the design's own "Cluster Charges" trait name - kept distinct here on purpose, see
// this file's own header comment) - any qualifying explosion (see OnAreaExplosionDetonated, fired
// once per genuine radius blast, never from a Mini Bomb's own detonation) rolls Chance to drop a
// stationary Mini Bomb at the blast center. Damage/Explosion are flat, authored values - not
// multipliers of the parent blast - same convention ExplodeOnDestroy.Damage already established;
// Explosion's own AreaHitData.BlastRadius is what actually makes this smaller than the parent.
component MiniOrdnanceUpgrade
{
    FP Chance;
    FP Damage;
    FP Fuse;
    AssetRef<EntityPrototype> MiniBombPrototype;
    AssetRef<AreaHitData> Explosion;
}
