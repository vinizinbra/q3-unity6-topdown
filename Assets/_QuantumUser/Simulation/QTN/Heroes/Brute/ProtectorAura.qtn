// Brute's Protector Aura - added directly onto his own entity by ProtectorPassiveData (so it
// follows him via his own Transform3D, same "field lives on the hero, no separate tracking entity"
// shape Kai's ProjectileSlowField already uses). Driven every tick by ProtectorAuraSystem, which
// continuously re-applies Intimidate to nearby enemies and Damage Reduction to nearby allies -
// refresh-only, same idiom SentryAuraSystem already uses, so nothing needs removing when a target
// leaves radius.
component ProtectorAura
{
    // Set once at spawn by ProtectorPassiveData.Apply, never touched again - the Guardian ascension's
    // own ranked RadiusBonus is added on top of THIS, not accumulated onto Radius directly, so a
    // re-pick (rank 2 -> rank 3) can SET a correct total (BaseRadius + RadiusBonus[rank]) rather than
    // needing to know/undo whatever bonus a previous rank already added.
    FP BaseRadius;
    FP Radius;

    // Multiplies an Intimidated enemy's own outgoing damage - see StatusEffectUtility.ApplyIntimidate.
    FP IntimidateDamageMultiplier;

    // 0 (the base passive's default) means the Guardian ascension hasn't been taken - allies get no
    // Damage Reduction from the aura until it is.
    FP AllyDamageReductionAmount;

    // 0 (off) until the Iron Presence ascension sets it - the movement-speed multiplier applied to
    // Intimidated enemies via the existing, generic StatusEffectUtility.ApplyIce.
    FP IntimidateSlowMultiplier;

    // 1 (no effect) until Iron Presence raises it above 1 - reduced knockback resistance on
    // Intimidated enemies, see StatusEffectUtility.ApplyKnockbackTaken.
    FP IntimidateKnockbackTakenMultiplier;

    // 0 (off) until Iron Presence rank 2+ sets it - bonus damage Brute himself deals against an
    // Intimidated target, see ProtectorAuraUtility.GetFearlessBonusMultiplier. (Absorbed from the old
    // standalone Fearless ascension into Iron Presence - see docs/brute-ascensions.md.)
    FP FearlessBonusVsIntimidated;

    // 1 (no effect) until Guardian rank 2 lowers it - knockback resistance for allies in the aura,
    // via the same generic StatusEffectUtility.ApplyKnockbackTaken Iron Presence already uses in the
    // opposite direction on enemies (0.70 = allies take 30% less knockback).
    FP AllyKnockbackTakenMultiplier;

    // Guardian rank 3 - the reactive DR proc (see BruteProtectorReactionSystem). All three values are
    // authored on the Ascension rather than hardcoded in that system, per the brief's
    // "balance-sensitive values must be editable without code changes". Amount 0 (ranks 1-2) is what
    // gates the proc off entirely.
    FP ReactiveDamageReductionAmount;
    FP ReactiveDamageReductionDuration;
    FP ReactiveCooldownPerAlly;
}
