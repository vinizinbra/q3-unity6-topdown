// Granted/revoked by VendettaRushSkillAction (Begin/End paired to Berserk/Overdrive itself) -
// presence means consuming a Vendetta mark (see MaxVendettaSystem.OnEntityKilled) also extends the
// current Overdrive activation by ExtensionSeconds (see OverdriveUtility.TryExtend). Cold config,
// re-seeded fresh every Begin (see VendettaRushSkillAction) rather than accumulating anything of
// its own - unlike UncontrolledFuryExtension, a single Vendetta kill has no per-activation cap to
// track.
component VendettaRushExtension
{
    FP ExtensionSeconds;
}
