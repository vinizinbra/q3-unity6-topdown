// Overdrive line 1 ("Last Stand") - granted by LastStandSkillAction.Execute on every Overdrive
// Begin, which SETs every tuned field below to the picked rank's cumulative values. Persistent
// (never revoked) - every reaction that reads it already gates on Overdrive actually running.
//
//  - Rank 1+: RageLossFraction - a softer fraction of CURRENT Rage lost per hit than Overdrive's own
//    baseline (RageOverdriveUtility.ResetStacks takes the lower of the two). MaxRageDamageReduction -
//    flat CharacterStats.DamageReduction toggled on/off exactly at the max-Rage threshold, the same
//    enter/exit hook Full Throttle and Ignition use (MaxAscensionUtility.ApplyLastStand/
//    RevertLastStand).
//  - Rank 2+: BlocksFirstHit - a self-granted Free Hit Guard at Overdrive Begin, so the first hit of
//    each activation is negated outright (and therefore costs no Rage either). Cleared at End.
//  - Rank 3 ("Too Angry to Die"): needs no field here - it just grants the existing CheatDeathGuard
//    component directly.
component LastStandUpgrade
{
    FP RageLossFraction;
    FP MaxRageDamageReduction;
    Boolean BlocksFirstHit;

    // The DamageReduction actually added by ApplyLastStand, so RevertLastStand subtracts exactly that
    // even if a rank-up re-tuned MaxRageDamageReduction in between. Zero = not currently applied.
    FP AppliedDamageReduction;
}
