// Overdrive rank 3 ("Uncontrolled Fury") - granted once by UncontrolledFurySkillAction.Apply, which
// SETs every field below to the picked rank's cumulative tuned values. KillCount/KillsPerExtension
// gate the main per-N-kills extension (see MaxOverdriveReactionSystem.OnEntityKilled) instead of
// firing on every single kill; PerKillExtension/MaxExtension/AccumulatedExtension are the same
// per-activation-capped pool the original mechanism already used, reset fresh every Begin.
// VendettaKillExtension is rank 3's own separate, UNCAPPED bonus - killing an enemy that still
// carries this owner's own Vendetta mark grants this many extra seconds independent of the capped
// pool above (0 for ranks 1-2, so the check is a natural no-op until rank 3 is actually picked).
component UncontrolledFuryExtension
{
    FP PerKillExtension;
    FP MaxExtension;
    FP AccumulatedExtension;

    Byte KillCount;
    Byte KillsPerExtension;

    FP VendettaKillExtension;
}
