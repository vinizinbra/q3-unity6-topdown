// Overdrive rank 2 ("Full Throttle") - granted once by FullThrottleSkillAction.Apply, which SETs
// every field below to the picked rank's cumulative tuned values (same "bake the rank's total, not
// an increment" convention every ranked Ascension uses). Applied/toggled at the max-Rage threshold
// by RageOverdriveUtility.TryAdvanceStack/ResetStacks (entering/leaving max Rage) via
// MaxAscensionUtility.ApplyFullThrottle/RevertFullThrottle - not active for the whole Overdrive
// window, only while Rage is actually maxed. Rank 3's instant-reload benefit is NOT a field here -
// it's carried by the separate, pre-existing InstantReloadOverdrive tag (see FullThrottleSkillAction/
// WeaponSystem.IsInstantReloadOverdriven), same "read an existing tag component" idiom
// RageRetentionUpgrade already uses for Last Stand rank 1.
component FullThrottleUpgrade
{
    FP WeaponDamageBonus;
    FP ReloadSpeedBonus;

    // Latches whether the toggle is currently applied, so entering/leaving max Rage twice in a row
    // (or a stray extra call) can't double-apply or double-revert the multipliers.
    Boolean Applied;
}
