// Max's "Fire Mastery" Hero Traits - a themed batch of 4 ordinary Passive Upgrades (Hot Target/
// Cremation/Wildfire/Flashpoint), independent of Vendetta itself (see Vendetta.qtn) even though
// Wildfire composes onto the same StatusSpreadOnDeath component Burning Vengeance uses. See
// docs/max-vendetta-fire-mastery.md.

// Hot Target - bonus Critical Chance vs a currently-Burning target. Never baked into
// CharacterStats.CriticalChance (Max's base Critical Chance must not be permanently modified) -
// read live every crit roll instead, see DamageUtility.ResolveOutgoingDamage.
component ConditionalCriticalModifier
{
    FP CriticalChanceBonusVsBurning;
}

// Wildfire's own component - the SINGLE Burn-spread mechanism in Max's kit. An earlier design had a
// second, near-identical line (Burning Vengeance, scoped to Vendetta kills) composing onto this same
// instance; the two were merged, so TriggerOnVendettaKill/HasFieryBurst are gone and
// MaxFireMasteryReactionSystem.OnEntityKilled is now the one and only trigger path.
component StatusSpreadOnDeath
{
    Boolean TriggerOnAnyBurningDeath;
    FP Radius;
    FP BurnDuration;
    FP BurnIntensity;
    Int32 MaxTargets;

    // Wildfire rank 3 - when > 0, the spread reads the dying enemy's OWN live Burn
    // (StatusEffects.BurnRemaining/BurnDamagePerTick) scaled by this fraction instead of the flat
    // authored BurnDuration/BurnIntensity above, so a fire that's already burning hot/long propagates
    // that same intensity/duration onward (scaled down) rather than resetting every jump back to the
    // base amount. 0 (the default) keeps every lower rank's flat-authored behavior unchanged. See
    // MaxFireMasteryReactionSystem.OnEntityKilled.
    //
    // The retained fraction being < 1 is also what makes the chain self-terminating: each jump
    // inherits strictly less than the fire it came from, so a spread-ignited enemy dying spreads a
    // weaker fire again rather than sustaining itself forever. Same-tick recursion is separately
    // impossible - TriggerOnAnyBurningDeath lives on the owner, not per-enemy, and OnEntityKilled
    // fires once per genuine death event.
    FP WildfireRetainedFraction;
}

// Cremation (Flashpoint rank 3) - forces a Burning target's Health the rest of the way to 0 once
// it's already below its own tier's threshold, letting the existing death branch in
// DamageUtility.ApplyDamage handle the rest unmodified. Filler/Normal share NormalHealthThreshold;
// Specialist/Heavy share the (lower) SpecialistHealthThreshold; Elite and Boss are NEVER executable
// at all - instead they take EliteBossDamageBonus extra damage while Burning and below
// EliteBossDamageThreshold, so the line still pays off against them without deleting a boss outright.
// See MaxFireMasteryReactionSystem.ResolveExecuteThreshold/DamageUtility.ResolveOutgoingDamage.
component ExecuteAgainstStatus
{
    FP NormalHealthThreshold;
    FP SpecialistHealthThreshold;

    FP EliteBossDamageThreshold;
    FP EliteBossDamageBonus;
}

// Flashpoint - a crit against an already-Burning target detonates a capped-radius explosion
// centered on it. CooldownRemaining is a live per-tick timer (see
// MaxFireMasteryReactionSystem.Update), not a config value - ticked down independent of whether
// Flashpoint is actually proccing this frame, same shape WeaponOnKillReactions.
// KillerInstinctTimer already uses.
component ExplosionOnConditionalHit
{
    FP Radius;
    FP DamageCoefficient;
    FP ProcCooldown;
    FP CooldownRemaining;
    Int32 MaxTargets;
    Boolean AllowRecursiveProc;
}
