// Granted (never revoked) by LastStandSkillAction rank 3 ("Too Angry to Die") - presence means
// lethal Health damage right now should clamp to 1 and force-end the current Overdrive activation
// instead of killing the owner (see CheatDeathUtility, hooked into DamageUtility.ApplyDamage's own
// Health clamp). Safe to leave granted between activations - the trigger condition (would this hit
// be lethal) is only ever evaluated while an active HeroSkill exists to force-end, so it's already a
// no-op outside Overdrive. The trigger condition itself is evaluated live where the damage resolves
// - ImmunityDuration is the one thing baked in at grant time, read once the save actually triggers
// to open a brief Invulnerable window (see StatusEffects.CheatDeathImmunityRemaining/
// StatusEffectSystem).
component CheatDeathGuard
{
    FP ImmunityDuration;
}
