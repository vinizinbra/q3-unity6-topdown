// WHY this player is currently airborne - carried through OnPlayerLanded so a landing reaction can
// discriminate. Generic and hero-agnostic; Brute's Groundbreaker is the first consumer and exposes it
// as an authored mask (GroundbreakerUpgrade.AllowedLandingSources), so "which airborne mechanics
// qualify" is data rather than code.
//
// Fall is the default and needs no writer: it's simply what "left the ground and nothing else claimed
// responsibility" means (walking off a ledge). The other two are set at the exact moment something
// else causes the airtime, and PlayerMovement.AirborneSource resets to Fall on landing, right after
// the signal fires.
enum LandingSource : Byte
{
    Fall     = 0,
    Jump     = 1,
    Launched = 2
}

component PlayerMovement
{
    AssetRef<MovementDataAsset> MovementData;

    Boolean HasAirJumped;
    FP      JumpCooldownTimer;

    // Updated by AutoJumpSystem whenever grounded; PlayerFallSystem respawns here on a fall.
    FPVector3 LastGroundedPosition;

    // Counts down (seconds) after PlayerFallSystem detects a fall, before it actually teleports
    // the player back - see LevelConfig.FallRespawnDelay. 0 means no fall is currently pending.
    FP FallRespawnTimer;

    // See LandingSource above. Written by AutoJumpSystem.DoJump (Jump) and
    // DamageUtility.ApplyResolvedImpulse (Launched); reset to Fall by AutoJumpSystem on landing.
    LandingSource AirborneSource;

    // True only for the airtime opened by the player's own Jump input (AutoJumpSystem's
    // input->Jump.WasPressed branch). Deliberately NOT set by either auto-hop path - not
    // PlayerMovementProcessor's predictive ledge/mantle detection, and not AutoJumpSystem's own
    // isOnEdge fallback - since both of those are movement assistance the player didn't ask for,
    // including the known false-positive at chunk-cube seams. A reaction that means "the player
    // deliberately jumped" should read this rather than AirborneSource == Jump, which today is set
    // identically by the isOnEdge fallback too. Reset to false alongside AirborneSource on landing.
    Boolean WasManualJump;

    // Seconds the player has been continuously walking straight at an unrecoverable-fall edge (no
    // ground ahead even on PlayerMovementProcessor's own deep WaterCheckDistance probe) with no
    // dry-ground axis left to slide onto. Held at 0 as long as movement is anything else - real
    // ground ahead, a survivable deeper ledge, or a diagonal that still has a safe axis to redirect
    // along - so this only ever grows on a straight walk-in and resets the instant that stops being
    // true. See PlayerMovementProcessor.ResolveWaterEdgeMovement.
    FP WaterEdgeHesitationTimer;
}

// Fired from AutoJumpSystem's own wasGrounded->isGrounded edge (auto-hop/mantle, the manual jump
// button, walking off a ledge, or being launched) - hero-agnostic, no effect for anyone without a
// reaction gated on it.
//
// fallDistance is the drop in LastGroundedPosition.Y between takeoff and landing: 0 for a flat hop or
// an upward mantle (it's clamped at 0), positive for a genuine fall off high ground. AutoJumpSystem
// just reports it and leaves "how much counts as a real fall" entirely to whoever reacts - which is
// what lets a reaction key off a configurable height threshold instead of hardcoded map tiles or
// height levels. It is also what makes the known false auto-hop at chunk-cube seams harmless to any
// consumer: a spurious hop reports ~0 fall distance and fails any meaningful threshold.
//
// heightDelta is the SAME takeoff-to-landing Y difference as fallDistance, but signed and unclamped:
// positive means landed lower than takeoff, negative means landed higher, ~0 means landed at
// approximately the same height. fallDistance can't express "landed at the same height" on its own
// (it clamps a same-height landing and an upward mantle to the same 0), which is why this exists
// alongside it rather than replacing it.
//
// source says WHY the entity was airborne (see LandingSource), so a reaction can accept or reject
// jumps/launches/plain falls independently rather than treating all airtime alike. wasManualJump
// narrows "source == Jump" further down to only the player's own Jump input - see
// PlayerMovement.WasManualJump above for why that distinction exists.
//
// Consumer: Brute's Groundbreaker Passive Ascension (BruteGroundbreakerSystem).
signal OnPlayerLanded(EntityRef entity, FP fallDistance, FP heightDelta, LandingSource source, Boolean wasManualJump);
