// Per-dash-activation dedupe for the Rift Dash mutation (see docs/rift-mutations.md) - "each enemy
// can be marked only once during the same dash". Reset to empty every DashSkillData.Begin, appended
// to during DashSkillData.Tick's own overlap check. Same array<EntityRef>[8]+Byte-count shape as
// Brute's own IronShoulderHitTracker - a separate component since Rift Dash isn't a hero-specific
// ascension, it applies to the universal dash for anyone holding the mutation.
component RiftDashMarkTracker
{
    array<EntityRef>[8] MarkedEntities;
    Byte MarkedCount;
}
