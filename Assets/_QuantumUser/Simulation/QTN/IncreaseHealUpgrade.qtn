// Granted by an upgrade (e.g. Heroes/Zara/IncreaseHealSkillAction) - read live by
// HealUtility.ApplyHeal every time a heal lands, multiplying HealPercent by (1 + HealBonus).
// Doesn't need baking into anything at spawn the way PoisonDamageWavesUpgrade/HasteOnHealUpgrade
// do - ApplyHeal already receives the owner on every single call, so reading it there directly is
// both simpler and immune to the same End-before-spawn race those two had to work around, since
// it's re-checked fresh on every heal rather than baked in once.
component IncreaseHealUpgrade
{
    FP HealBonus;
}
