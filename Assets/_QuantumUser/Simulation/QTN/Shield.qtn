// Optional - only entities that actually have a shield carry this, so an unshielded enemy costs
// nothing. Absorbed before Health, and unlike Health it recharges itself back to full once the
// entity has gone RechargeDelay without being hit.
component Shield
{
    FP Current;
    FP Max;

    // Reset to RechargeDelay by every hit that lands, including one the shield fully soaks, so
    // sustained fire keeps it suppressed. ShieldSystem recharges only once this reaches zero.
    FP RechargeTimer;
    FP RechargeDelay;

    // Points per second once recharging starts.
    FP RechargeRate;
}

// Fired by DamageUtility.AbsorbWithShield the exact tick Current crosses from >0 to <=0 - not on
// every hit taken while already broken, and not on a hit that only partially drains it. Today's
// only consumer is Shield Breaker (Rift Mutation, see RiftMutationReactionSystem), but this is
// generic enough for any future "on shield break" reaction to reuse.
signal OnShieldBroken(EntityRef entity);
