component Health
{
    FP CurrentHealth;
    FP MaxHealth;

    // Flat HP/sec added back every tick while below Max - seeded from CharacterData.
    // BaseHealthRegenRate (0 for most heroes) and raised further by HealthRegenUpgradeData grants.
    // No delay gate unlike Shield.RechargeRate - this is meant to be a small continuous trickle,
    // not a big chunk worth suppressing while under fire.
    FP RegenRate;
}
