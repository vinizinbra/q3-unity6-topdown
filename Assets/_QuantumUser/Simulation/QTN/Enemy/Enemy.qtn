component Enemy
{
    AssetRef<EnemyDataAsset> EnemyData;

    EntityRef  Target;
    EnemyActionPhase Phase;
    FP         StateTimer;

    // Counts down from EnemySystem.SpawnGraceDuration, seeded once by SeedFromEnemyData - while
    // above 0, EnemySystem.Update skips the whole Phase state machine (no targeting/movement/
    // attacking) for every enemy type, no per-prototype opt-in needed. Physics (gravity, knockback
    // recovery, stuck recovery) still runs during the window so a freshly-spawned enemy still
    // settles onto the ground normally instead of hanging mid-air.
    FP SpawnGraceRemaining;

    // Time before EnemyDataAsset.BasicAction is usable again - ticked every tick regardless of
    // Phase (EnemySystem.TickAttackCooldown), independent of DownTime/StateTimer, so the enemy
    // could resume chasing before this action specifically comes back off cooldown. SkillActions
    // get their own cooldowns on the optional EnemyActionSlots component instead - this field is
    // always BasicAction's (slot 0), never repurposed for a skill slot.
    FP AttackCooldownRemaining;

    // 0 = BasicAction is the action currently in Preparation/Telegraph/Active/Recovery; 1-7 =
    // EnemyDataAsset.SkillActions[slot-1]. Set once by EnemyDecisionUtility.TrySelectAction on
    // committing to an action (Chasing -> Preparation) and read by every phase handler afterward
    // so they all agree on which EnemyActionData/EnemyDeliveryData is currently running. Lives here
    // (not on the optional EnemyActionSlots component) since every enemy needs to track this
    // regardless of whether it has any SkillActions at all.
    Byte CurrentActionSlot;

    // Captured once by EnemyDeliveryData.Begin() for a delivery that needs a locked point to move
    // toward (e.g. ChargeDeliveryData's dash target, LeapDeliveryData's landing spot) - never
    // re-homed mid-delivery.
    FPVector3 SkillTargetPosition;

    // Captured once by EnemyDeliveryData.Begin() for a delivery that needs to interpolate from its
    // own starting position rather than just move toward SkillTargetPosition at a constant speed
    // (e.g. LeapDeliveryData's jump arc, lerped between this and SkillTargetPosition over time).
    FPVector3 SkillStartPosition;

    // A traversal hop in progress (EnemyHeightData.CanClimbCliffs/CanJumpGaps, started by
    // EnemyMovementUtility.BeginTraversalJump) - kinematic and lerp-driven, the same
    // SkillStartPosition/SkillTargetPosition/StateTimer arc shape LeapDeliveryData.Tick already
    // uses for a leap attack, just kept as its own fields since a traversal hop runs during plain
    // Chasing movement, not through the EnemyActionPhase/EnemyDeliveryData pipeline those belong
    // to - a moving enemy that's also mid-Preparation for a real action would otherwise stomp
    // whichever one claimed those fields first. TraversalJumpDuration <= 0 means no hop is active;
    // MoveInDirection checks that before doing anything else.
    FPVector3 TraversalJumpOrigin;
    FPVector3 TraversalJumpDestination;
    FP TraversalJumpTimer;
    FP TraversalJumpDuration;

    // A climb/gap landing found by TryFindClimbLanding/TryFindGapLanding but not launched yet -
    // counts down from EnemyMovementUtility.TraversalJumpAnticipationTime first (QueueTraversalJump)
    // so the view has a brief window to play a crouch tell before the kinematic hop itself begins,
    // instead of the crouch and the launch overlapping. <= 0 means nothing queued.
    // PendingDestination/Speed are captured once when the anticipation starts (not re-resolved when
    // it actually launches), so a target moving during that brief window can't retarget it mid-air.
    FP TraversalJumpAnticipationTimer;
    FPVector3 TraversalJumpPendingDestination;
    FP TraversalJumpPendingSpeed;

    // Counts down while EnemySystem deliberately writes no velocity at all, so a knockback impulse
    // survives long enough to actually move the enemy - every other phase drives
    // PhysicsBody3D.Velocity every tick (StopMovement/MoveInDirection) and would otherwise erase
    // the push before it went anywhere. Opened by OnEnemyKnockedBack, sized by
    // EnemyDataAsset.KnockbackRecoveryTime.
    FP KnockbackTimer;

    // Anti-"shoved into the scenery" safety net - see EnemyStuckRecoveryUtility. A hard enough
    // knockback (Brute's Iron Shoulder pushes at 20 u/s, his Groundbreaker at up to 16.5) can drive
    // an enemy far enough into a chunk's compound collider in one physics step that the solver
    // doesn't push it back out, and once its center is INSIDE the geometry the wall raycasts
    // EnemyMovementUtility steers by (which all originate at the enemy's own position) no longer see
    // anything to avoid - so normal chase movement just drives it deeper. It reads as the enemy
    // walking into the environment and getting stuck there.
    //
    // Rather than clamping every knockback in the game (which would flatten the feel of knockback
    // near walls, and still wouldn't cover being popped OVER one), this records where the enemy was
    // standing the instant it was pushed and watches for a short window afterward. Both fields are
    // only ever touched inside that window, so an enemy nobody has knocked around costs nothing.
    FPVector3 PreKnockbackPosition;
    FP StuckCheckTimer;

    // Counts down (seconds) after EnemyFallSystem detects a fall, before it actually teleports
    // the enemy back - see LevelConfig.FallRespawnDelay. 0 means no fall is currently pending.
    // FallOriginPosition freezes where it fell FROM at detection time, so gravity/residual
    // knockback velocity still applied during the delay can't drift the eventual respawn's own
    // nearest-chunk resolution away from where it actually fell.
    FP FallRespawnTimer;
    FPVector3 FallOriginPosition;

    // Set by EnemyDeliveryData.Begin() for a delivery that hands off to a separately-ticking
    // spawned entity instead of finishing on the spot (e.g. a future lobbed-shell delivery) -
    // Tick() watches f.Exists(SkillProjectile) to know when that entity is actually done (hit
    // something or expired via ProjectileSystem), so EnemyActionPhase.Active - and therefore the
    // delivery's Telegraph - stays alive for the spawned entity's whole lifetime instead of ending
    // the instant it's launched.
    EntityRef SkillProjectile;

    // GroundBarrageDeliveryData's own state - only ONE point is ever "in flight" (telegraphed but not
    // yet detonated) at a time, spawned one after another rather than all up front, so each later
    // point can re-resolve the target's LIVE position instead of reusing a snapshot from Begin() (a
    // stationary target from Point 1's telegraph would otherwise still get hit by Point 4's, several
    // seconds later, even after actually moving away). PendingImpactPoint is that single point's
    // resolved position; PendingImpactTotal is the total point count for this run (set once at
    // Begin(), never changed after); PendingImpactIndex counts up from 0 as each point finishes
    // (spawns then detonates); PendingImpactAwaitingSpawn distinguishes StateTimer's two meanings -
    // true while counting down Stagger toward spawning PendingImpactIndex's telegraph, false while
    // counting down Delay toward detonating the point already spawned. See that delivery's own
    // comment for the full state machine.
    FPVector3 PendingImpactPoint;
    Byte PendingImpactTotal;
    Byte PendingImpactIndex;
    Boolean PendingImpactAwaitingSpawn;

    // RingSlamDeliveryData's own Tick() writes its already-computed currentFront here every tick,
    // purely for the View (RingWaveVisualManager) to read live - lets the growing ring OUTLINE it
    // draws stay exactly in sync with the real hit-detection front even under Void Pressure's time
    // dilation (StatusEffectUtility.GetLocalTimeMultiplier), which an independently-clocked
    // client-side replica of the same growth formula would silently drift out of sync with.
    FP RingWaveRadius;

    // RotatingLaserDeliveryData's own continuously-incrementing spin angle - Tick() adds
    // SpinSpeed * dt (also Void-Pressure-scaled, same reasoning as RingWaveRadius above) every
    // tick for the whole spin's Duration. Independent of Aim.Angle so the beam can spin far faster
    // than the enemy's own body-facing without dragging its sprite's rotation along with it.
    // Degrees, never wrapped to [0,360) - FP has more than enough range for any realistic spin
    // duration and Euler-rotation math doesn't care.
    FP LaserSpinAngle;

    // EnemyHeightState.Flying-only - unused (stays at 0) for every other enemy. Counts down to the
    // next periodic ground re-check (EnemyMovementUtility.ComputeFlyingHoverVelocity), and
    // remembers the last-found target height (groundY + EnemyHeightData.FlightHeight) to spring
    // toward in between checks - re-sampling the ground every tick would fight the spring's own
    // easing instead of giving it a stable point to settle on. Lives on the shared Enemy component
    // rather than a separate optional one (unlike e.g. EnemySequenceState) since it's a single pair
    // of FPs and this way a Flying enemy just works the moment EnemyDataAsset.Height.InitialState
    // is set, with no separate per-prototype component to remember to add.
    FP FlyingHoverCheckTimer;
    FP FlyingHoverTargetHeight;

    // Elite-only (see EliteRelocationSystem/LifecycleConfig.EliteLostRange) - continuous seconds
    // with no player within EliteLostRange, reset to 0 the instant one is. Lives on the shared
    // Enemy component rather than a separate optional one, same reasoning as
    // FlyingHoverCheckTimer/FlyingHoverTargetHeight above (a single FP, and this way an Elite just
    // works with no separate per-prototype component to remember to add).
    FP LostTimer;

    // Which world faction this enemy visually belongs to (EnemyDataAsset.FactionSkins picks its
    // ViewPrefab off this) - purely cosmetic, no gameplay effect. Authored explicitly per-slot on
    // the EnemyGroupConfig.GroupMemberEntry that spawned it (GroupSpawnerUtility.SpawnMember), not
    // randomized, so the same group composition always reads the same way (e.g. a SecurityPatrol
    // group's Ranged members are always RobotFaction robots, never a random mix).
    EnemyFaction Faction;
}

// Fired once by DamageUtility when an Enemy's health hits zero, right after Phase is set to
// Dead - lets other systems react to the death (e.g. EnemySystem parking the corpse) without
// DamageUtility needing to know about them directly.
signal OnEnemyDied(EntityRef entity);

// Fired by DamageUtility right after a knockback impulse actually lands on an Enemy - lets
// EnemySystem open its stagger window and cancel the current action on its own terms, same split
// as OnEnemyDied. Not fired when the impulse was dropped (kinematic body), so an enemy mid-charge
// isn't staggered by a push it never felt. canInterrupt is the pushing source's own declaration
// (see KnockbackEffectData.CanInterrupt) that this specific knockback is allowed to cancel
// whatever the enemy is currently doing - false for a cosmetic/juice-only push (e.g. basic weapon
// fire), composed with EnemyTierStatsConfig.CanBeInterruptedByKnockback (target-tier) and
// EnemyActionData.InterruptibleDuringTelegraph/Active (per-action) inside EnemySystem itself. The
// stagger window (KnockbackTimer) and EnemyStuckRecoveryUtility's own safety net still always run
// regardless - those are physics-settle concerns, not AI-interrupt concerns.
signal OnEnemyKnockedBack(EntityRef entity, Boolean canInterrupt);

// Merges what used to be two separate concepts - the coarse Idle/Chasing/.../Dead AI state and a
// finer-grained windup/telegraph/active-delivery phase - into one state machine at a single
// resolution, since they were never orthogonal (Anticipating was always "Preparation, plus
// Telegraph once it's visible"; Executing was always "Active"). Running them as two independently
// advancing trackers would double the ways EnterRecovering's single IsKinematic-reset-point
// discipline could be violated. Cooldown is deliberately NOT a phase here - it already ticks
// independently of Phase (EnemySystem.TickAttackCooldown runs every tick regardless), which
// matters more, not less, once an enemy can have multiple actions each with their own cooldown.
enum EnemyActionPhase : Byte
{
    Idle        = 0,
    Chasing     = 1,

    // Windup before an action commits - EnemyDeliveryData.OnAnticipating() runs every tick here.
    // Preparation is the not-yet-telegraphed portion; the phase flips to Telegraph once elapsed
    // windup crosses EnemyActionData.TelegraphStartPercent (both driven by the same StateTimer,
    // not a second timer).
    Preparation = 2,
    Telegraph   = 3,

    // The instant EnemyDeliveryData.Begin() is called, once the windup timer expires - resolves
    // within the same tick to either Recovery (Begin() returned true) or Active (returned false),
    // so this value is never itself persisted/observed; it exists as a named point in the
    // lifecycle for future systems (e.g. presentation) that may want to react to it directly.
    Execute     = 4,

    // A delivery whose Begin() returned false is still resolving (e.g. ChargeDeliveryData's dash) -
    // ticked via EnemyDeliveryData.Tick() until it reports done.
    Active      = 5,

    Recovery    = 6,
    Dead        = 7
}

// Deliberately generic labels rather than named lore factions, since the actual visual identity
// behind each slot is expected to vary per world/map (e.g. MainFaction might be cultists on one map,
// corp goons on another) while the ROLE stays consistent: MainFaction = the world's main hostile
// faction, RobotFaction = local security/defense (often robotic), WildLifeFaction = local wildlife. See
// Enemy.Faction and EnemyDataAsset.FactionSkins.
enum EnemyFaction : Byte
{
    MainFaction = 0,
    RobotFaction = 1,
    WildLifeFaction = 2
}
