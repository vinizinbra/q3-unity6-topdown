// Baked onto an enemy by JuggernautSkillData.Discharge (see JuggernautLandingImpactUpgrade and
// JuggernautLandingRootUpgrade) the moment it's successfully launched - JuggernautLandingImpactSystem
// watches for this entity to touch ground or a wall again (EnemyMovementUtility.IsGrounded/
// IsBlockedByWall), then deals Damage, rolls StunChance for StunDuration and/or RootChance for
// RootDuration (whichever upgrade(s) were baked - independent of each other, both optional), and
// removes this component. GroundCheckDelay is a short grace period before the first check even runs,
// so the system can't ever fire immediately off the same-tick position the knockback impulse hasn't
// been integrated into yet.
component JuggernautLaunched
{
    EntityRef Owner;
    FP Damage;
    FP StunChance;
    FP StunDuration;
    FP RootDamage;
    FP RootChance;
    FP RootDuration;
    FP GroundCheckDelay;
    AssetRef<JuggernautLandingImpactSkillAction> Source;
}
